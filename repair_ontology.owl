<owl:NamedIndividual rdf:about="#Suzuki_Motorcycle">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_36490"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_36490">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_4_allen_wrench"/>
  <has_tool rdf:resource="#Tool_10_mm_socket"/>
  <has_step rdf:resource="#Step_81435"/>
  <has_step rdf:resource="#Step_81436"/>
  <has_step rdf:resource="#Step_81437"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disassembling Suzuki Boulevard S40 Seat</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81435">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_4_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oaaA26xZoMIioUOe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4 mm Hex screw securing the back of the seat.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81436">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_10_mm_socket"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DIKLAWjmKAmyGIAd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hSY4SqYtpTraHec4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 10 mm hex head bolts, one on either side of the seat.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81437">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SdRCvDEEXuEUZ62Z.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push the seat towards the front of the bike and lift it up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

