  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the hatch and carefully pull out the battery to expose the cable connection</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_181668">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/B6nUGiqXAsfuhUBA.standard"/>
