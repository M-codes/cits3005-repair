  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GoPro Karma Landing Gear Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_109910">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_4_allen_wrench"/>
  <has_tool rdf:resource="#Tool_2_mm_hex_screwdriver"/>
