  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fgGNos3NxOFxDysr.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

