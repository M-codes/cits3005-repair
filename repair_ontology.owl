  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lnJDQX1adgBwoXmq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mount the light in between a 11mm socket and 22 socket like so in a vice.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_51579">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RRPrEWXyUJBrJtEF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly clamp, the clear light cover will push in. There is quite a lot of resistance.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_51580">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/52dFSnNfCHOZJELG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Keep on going until the resistance fades. The light cover will be depressed as shown. and the electronics will just fall out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_51581">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/L1aeF3biFRrBaPKP.standard"/>
