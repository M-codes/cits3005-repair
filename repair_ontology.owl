<owl:NamedIndividual rdf:about="#2006_Honda_Shadow_Spirit_750">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_31742"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_31742">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_6_allen_wrench"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_step rdf:resource="#Step_76477"/>
  <has_step rdf:resource="#Step_76479"/>
  <has_step rdf:resource="#Step_73816"/>
  <has_step rdf:resource="#Step_73817"/>
  <has_step rdf:resource="#Step_73818"/>
  <has_step rdf:resource="#Step_73819"/>
  <has_step rdf:resource="#Step_73820"/>
  <has_step rdf:resource="#Step_73821"/>
  <has_step rdf:resource="#Step_73822"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2006 Honda Shadow Spirit 750 Battery Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_6_allen_wrench">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_76477">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YbBDutRBVMcoeUUM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the plastic covering, located on the left side of the bike, by pulling the piece straight off the bike.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_76479">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hyDWYmNwC2URSkfs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/D1rJ4GXWSSOvfZH4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QRUkbnTuQVVc1Gmy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The tool box is located under the panel. Using the key to the motorbike, unlock the tool box. Remove the plastic bag inside holding the tools needed for basic maintenance for the motorbike.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73816">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_6_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qnQNoIlHpHMfpwfO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DvuZZLIpvWfGS1sO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the allen wrench, remove the screws on both sides of the bike seat.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73817">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nSLhpiNoQTpdWoIU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the rear of the seat upwards. Pull the seat backwards to remove it from the bike.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73818">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PShfWfTuW1ZeCitE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the screwdriver, remove the screw holding the plastic cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73819">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gjCKrDeoVUGTWZfd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the cover off the battery and remove the fuse box from the cover. Place the fuse box over to the side right of the bike.  Do not disconnect the wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73820">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2AuKA2iEfENPqJIv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the screwdriver, remove the ground wire (negative (-) cable) from the battery. Place the wire over the left side of the bike.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73821">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DKN1QXm4CPjXxn1P.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Also using the screwdriver, remove the positive (+) cable from the battery. Place the wire over the right side of the bike. Do not let the red(+) and black(-) wires touch</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_73822">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hfCpKDBbkKebBt6c.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the battery from the bike by pulling upwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YbBDutRBVMcoeUUM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

