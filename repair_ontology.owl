  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protocol Dronium Two HD Camera Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155542">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pwNEfp5nTy3kZAWW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn device off by moving the selector switch to the left.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155543">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SnbiDVyOslJPTKkG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JGdbOv21qQZFdDYE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place one hand on the drone and carefully remove the landing gear with the other hand. Be gentle as to not break off the studs on the landing gear.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_156409">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gJPHb1LQFomuQw2B.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BsqX4YOFQxQa6kq1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the fine edged plastic opening tool to pull up one side of the plug, and then the other, until it comes loose.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_157626">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mDXDZTJLn4GDkCWj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4LLWKfaHBFyCTWNP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push the battery cover away from the drone and carefully open it up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_157627">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nU6koJasLVVpWvZX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xpNh33To1FTJjUEV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the two Phillips 5.35 mm screws holding the camera to the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_157628">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PHaXYq6DIEOeV2YX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Close the battery cover by pulling it towards you. Then, gently pull the camera towards you, freeing it from the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

