  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the small retaining clip using a plastic opening tool. Be careful as these clips can fly off and can be difficult to find.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132410">
