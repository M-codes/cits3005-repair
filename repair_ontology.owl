  <has_step rdf:resource="#Step_39522"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raleigh M20 Chain Guard Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_crank_arm_puller">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39303">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_flathead_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5DykboMZDMjfW6Qm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vCtCbLrfTChfQNXj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a flathead screwdriver to remove the cap over the screw. Do this for both sides.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39463">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_socket_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xaSnCBWJuE3O6feO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FWq5Tr6AWyrJhC1K.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To unscrew crank-arms,  position socket wrench onto screw. Twist the socket wrench clockwise until the screw has been removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39526">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_crank_arm_puller"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dPKjjlLBk2Q2fUoS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vGI2X3f3CVJgmJnw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LP5kmXPTSZYV2qtO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the crank arm puller into the hole that the screw was occupying. Use a crescent wrench to tighten the crank arm puller by twisting clockwise until the puller cannot be tightened further. Do not over tighten the crank arm puller. Once it begins to become hard to tighten, stop.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39527">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_crank_arm_puller"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ksOIgfBeYvaVRZKF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sqIgi5ZkrvqNRP6j.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wYYX1MF2aoCtixCo.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the crank arm puller clockwise until the crankarm pops off. There will be some resistance when taking the crank arm off. Repeat steps 2-4 on the other side of the bike to remove the other crank arm.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39520">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_crank_arm_puller"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RIYTiIUPkud2hJUN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RyVsgDYyAlOjXHRm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the crank arm, that has the chain-guard on it, over so that the chainring shows. Locate the four screws on the back of the chain ring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39518">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RBQhOMMHGCgbf1Dt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DCoBgMoEfCAerpXS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vaCylZT4HyXp6jAP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a Phillips head screwdriver to remove the four screws on the back of the chain ring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39521">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vMl5MhGFHtDNH6Iv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip chain guard back over so that the chain guard faces you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_39522">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ui5Jqx424Q5YMeZx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3ZcIbaDIE4RfSiNE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grasp the crankarm in one hand and the chain guard in the other. Gently, pull out and up on the chain guard until the guard pops off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

