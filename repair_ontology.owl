<owl:NamedIndividual rdf:about="#Hubsan_X4_107L">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_36401"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_36401">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_wire_cutter"/>
  <has_tool rdf:resource="#Tool_propeller_removal_tool"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_step rdf:resource="#Step_81287"/>
  <has_step rdf:resource="#Step_81289"/>
  <has_step rdf:resource="#Step_81290"/>
  <has_step rdf:resource="#Step_81440"/>
  <has_step rdf:resource="#Step_81294"/>
  <has_step rdf:resource="#Step_81300"/>
