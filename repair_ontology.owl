  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QYojZFogJYQNJtYi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove clip bracket, first remove all 3 clips using the #2 screwdriver or hand drill (Make sure to put clips and their screws and anchor plates in a safe place as to not misplace any such as a Ziploc bag).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60696">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_smart_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VhsAYPVNCUXaMS6Y.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew all 13 small black screws. To do so, undo velcro flap located at the top of the laptop sleeve. With the wrench, hold nut in place in the back of the pannier.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60697">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2hACbeWdPFcWlWCR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While holding nuts with the wrench, use the screwdriver to unscrew the screw in the front bracket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60698">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IHFjkjfMsNljDUDv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ynv4BYa1Eba3XFZq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove old clip. Take new clip bracket and unscrew and remove middle clip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60699">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_smart_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KAevPeYUpUjBeKJS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the middle clip and screw it into place on the bag. Place the new clip bracket in place and screw in all 13 screws again. As in step 3 and 4, hold nut with wrench while screwing clip in place. (Be sure to keep washers in between the screws and the body of the bag)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60700">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MP2NbNyPDG3Ahc4Z.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You're done!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60701">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_screwdriver"/>
  <has_tool rdf:resource="#Tool_smart_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/O1HlbfFROEbYjMuG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tools needed: New Pannier Bottom Stay Bracket. Standard Screwdriver Wrench</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60702">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RT2efliLoOI6pc1O.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wi6aKJoq3YUZaVyE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove bottom stay bracket, first unscrew all 4 screws. To do so, undo velcro flap located at the top of the laptop sleeve. With the wrench, hold nut in place in the back of the pannier, while using the screwdriver to unscrew the screw in the front bracket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60703">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_smart_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3RuskgcsrCrT45yx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove old clip. Take new bottom bracket and remove all screws and washers from bracket (Make sure to put all screws, washers, and nuts in a safe place (Ziploc bag) as to not lose any!) Follow step 2 in reverse order to attach new clip bracket. (Hold nut with wrench while screwing back in place. Also make sure the washers are between the screws and the body of the bag.)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60704">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/I5Zootsk6iEe1qln.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All Done!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KdmmQnbdWaUgCFYg.standard">
