  <has_step rdf:resource="#Step_59148"/>
  <has_step rdf:resource="#Step_59153"/>
  <has_step rdf:resource="#Step_59154"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How to adjust Triace A310 Brake Cable</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_64_bit_driver_kit">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59148">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oP5cSfgTZCpnBtQl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sCQNuMlNKWZP4DIL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While holding onto the brake cable, unscrew the screw that holds the brake cable in place using a 5mm allen wrench.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59153">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZiEoWRk2Zvam2FfB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you need to loosen your brakes, pull up on the arm while holding the brake cable in place. To tighten your brakes follow the above step, except push down on the arm instead of pulling up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59154">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6Oo61f3BJiZBSIKv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tighten the screw on the desired location along the cable with the same 5mm allen wrench.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oP5cSfgTZCpnBtQl.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

