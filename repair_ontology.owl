  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three 5mm screws on the top of the motor assembly with a PH00 bit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132078">
