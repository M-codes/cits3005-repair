  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The propeller, gear, and rod can be removed by simply lifting them off the motor.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132076">
