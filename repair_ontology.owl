<owl:NamedIndividual rdf:about="#Step_168630">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t6_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Swoj5t3JHibTvhhi.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/s2TSP5AuOQthMPDD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Position the controller so the back is facing up. Use a T6 screwdriver to remove the six screws on the back of the controller: four 0.9 mm screws and two 0.1 mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168632">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LDSAhx1ECQZTdV4o.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OgT3wKXNgNoos6mm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the  foam adhesive that connects the front plate to the motherboard The buttons (L1,R1) may fall out. Set aside to replace during reassembly. Use a Philips #0 screwdriver to remove the two 0.7 mm screws highlighted. Remove the motherboard from the front plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168631">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3SDkcmNSiOb6YgEv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SrCIL63kEkMTqZDS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xq1KL5t2mxBS5AZK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the buttons from the front plate of the fly pad and replace as needed. Hold the front plate of the fly pad facing downwards to prevent buttons from falling out. Make sure the text on buttons L1 and R1 correctly line up with L2 and R2 when reassembling the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168633">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_magnetic_project_mat"/>
  <has_tool rdf:resource="#Tool_t6_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lewZNaE3WOUZWLgB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total of 6 Screws are located in the back of the controller. Four 0.9mm T6 screws Two 0.1mm T6 screws Flip the Flypad over. Remove the six screws using a T6 screwdriver. Use a Magnetic Mat to prevent loss of screws. Set aside.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168634">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/P6tVdw2oqhIUVLYA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the Flypad over again and separate the front and back. Be sure to remove the foam adhesive that connects the front plate to the motherboard. Be aware that the Buttons (L1,R1) may fall out. Remember to put them back in place during reassembly. Use Ph0 tool to remove the screws holding the motherboard in place. Gently remove the motherboard from the front plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168635">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/puYtMUpKHHkSMVjj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NJO16sTCZA24dOrr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pop the joysticks out by pulling gently.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168636">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uUOEIkGN6CxajuSC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew and replace joystick caps for a more comfortable grip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168637">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t6_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BRAShf2UAQ1s5DtD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a T6 screwdriver to remove the six screws from the back of the controller: four 0.9 mm screws and two 0.1 mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_168639">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6Gp3mdPGuELOnSAg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a screwdriver to remove the two 0.7 mm screws from the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_169037">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xFjGYXRYeHEfZ4fc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Separate the plastic cover from battery. Avoid damaging the wires and gently remove the battery from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_169038">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OEdQOk6h65cuCFOt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use fingers to gently detach the battery wires from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_169039">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Bi56Sk2JBdVAwoYT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently attach the wire connection from the new battery to the motherboard. Avoid touching the motherboard directly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

