  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/U6kQNeBH1x5hXnQy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You can see where the electronics slides into. You can see how it is held in with friction from the raised plastic bevel. If you wish to make it easier to disassemble, file the friction bevel down. Don't file down the keying semi circular bevel. The last picture shows the plastic filed down.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

