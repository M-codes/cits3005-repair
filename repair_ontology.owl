<owl:NamedIndividual rdf:about="#Self-Balancing_Board">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_96120"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_96120">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_cacciavite_con_testa_a_croce_n._1"/>
  <has_tool rdf:resource="#Tool_new_item"/>
  <has_step rdf:resource="#Step_177747"/>
  <has_step rdf:resource="#Step_177748"/>
  <has_step rdf:resource="#Step_177749"/>
  <has_step rdf:resource="#Step_177750"/>
  <has_step rdf:resource="#Step_177751"/>
  <has_step rdf:resource="#Step_177752"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Self-Balancing Board Remote control Bluetooth  Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_cacciavite_con_testa_a_croce_n._1">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177747">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JQn5ZgGYpwh3oBpR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 10 screws with a cross-head screwdriver to access a part of the hoverboard. The electronic boards are mirrored on both sides, so you can choose one of the 2 by evaluating which of these are available for Bluetooth setup</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177748">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OlLnNIwG3EAUvEI5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unhook the lighting and canbus cables to remove the cover</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177749">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IJmIpWomjaMF1BQh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4 screws that hold the electronic card holder</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177750">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/frThJOwkSxpMDOO6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rimuovere le 4 viti che fissano la scheda al supporto</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177751">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lcVvhKQudkwD2gkw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correct position for welding the Bluetooth card.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177752">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LeQERKeLXT1Yvqfk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a tin soldering station, secure the 4 pins of the Bluetooth card on the hoverboard board Before soldering the boards I recommend checking the functionality of the Bluetooth card simply by inserting the pins that is sufficient</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

