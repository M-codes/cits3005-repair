  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thoroughly spray carburetor cleaner all over the outside, inside, and openings of the carburetor. Be careful not to get carburetor cleaner on your skin or eyes or breathe it in.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_164935">
