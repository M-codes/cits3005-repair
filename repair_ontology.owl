  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the battery by pulling the two red wires apart. Remove the battery by releasing the battery retaining straps.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132409">
  <rdf:type rdf:resource="#Step"/>
