  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XBQnlsRA2NQwerGD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/52hUISAjghNaguKd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oGgsy3EL2WI5SpCX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XejOhMBSVY3RsiKi.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DeOlhN6JF6pUJ4oR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Vehicle_Accessory">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_59625"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_59625">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_metal_spudger"/>
  <has_step rdf:resource="#Step_125085"/>
  <has_step rdf:resource="#Step_125090"/>
  <has_step rdf:resource="#Step_125092"/>
  <has_step rdf:resource="#Step_125093"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TYLT VU Wireless charging car mount Disassembly</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125085">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BMKRDqQnSM46rfFX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XrGgDjJNRLB3R1mD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First thing you want to do is lift up the corners of the rubber mat that makes up the center that your phone sits on. Here you will find 4 screws (One in each corner). Remove these screws and the whole front panel should come off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125090">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TKdbEoCy1QFBUfc2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next you need to be careful not to brake any of the 3 wires running from the main charging circuit to the power intake port, that sits on a seperate chip in the bottom housing. This is held on by 1 screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125092">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZgjmWB26cLiUBFGT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2G3g64fVLLMCjZrW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6nPaTJuKDKbTNidG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now your should be left with this bottom part. To get to the sprockets and the locking mechanism inside, you need to remove the plate that is secured with 4 screws + 1 smaller screw. When that plate is removed (might take some slight convincing) you will see the sprockets and mechanism seen in picture 2 and 3.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125093">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tCeZHR3WuFWX65Dx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mind the small spring in picture 1 when assembling, this pulls both the clamps out when the button is pushed. Also remember to realign all the parts when assembling. Other than that it is the reverse of dissasembling.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

