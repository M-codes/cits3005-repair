  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trek 4300 Bicycle Kickstand Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_32016">
  <rdf:type rdf:resource="#Procedure"/>
