  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41075">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_4_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Zv2AcRGgOXcvEwJT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 4mm Allen wrench, partially unscrew the 4 (22mm) hex screws on the front of the axle casing to allow the axle to slide freely.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41464">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_8_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AsZuUyDcLWWIuZUq.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BvHpoIpBAH5lGged.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 8mm Allen wrench, loosen the axle screw until 1/2 of the axle screw is visible. Push the axle screw to reveal the axle rod on the other side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41465">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QUAqqfYHwHWBYbIM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the Allen wrench, finish unscrewing the axle screw and pull it out. Hold the wheel when pulling out the axle rod so that the bike does not fall.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41467">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mr5PahAaSaX3kGpi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the wheel from the fork.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_sw-1_spoke_wrench">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41960">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mirdGEN3fOXFkNLd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hoQGJZoXxF2he1lB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pOLThvXIq3jW1wNO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twist and pull off the cap covering the tire valve Twist off the spacer that holds the valve in place. Push valve in toward wheel to release air pressure.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41961">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hGSTdZVHNqassJDp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5lrUbMYFhSthH3FX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J2UHBtKWNQVlulLC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert one tire lever between the tire and the rim. Push down on the tire lever until the edge of the tire is higher than the edge of the rim. Insert a second tire lever next to  the first. Slowly slide one tire lever around the rim until the tire is released from the rim.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41962">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RXpXCAKOQ5P1ZwrN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your hand, pull the tube completely out of the tire.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41325">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_8_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UmhZM2qvCP6reXGX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use an 8mm Allen wrench to unscrew the 6 (4x10mm) screws on the brake rotor. Pull brake rotors off both sides of the wheel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41965">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mj6MPwXIsKgbTKLs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the tire from the rim.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41326">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_tool rdf:resource="#Tool_sw-1_spoke_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yPId4tAOjqeNMCGR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a tire lever, push the rim tape aside to reveal the spoke nipple. Using your fingers, pull off the old spoke nipple.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41934">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_sw-1_spoke_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SEAjALIOtssuNejW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push out the old spoke from the hub.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41935">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_sw-1_spoke_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yXaIAv5dfCvIXrar.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lUkb6x1OZiiQARog.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert a new 250mm spoke into the hub. Align the spoke with the spoke nipple in the rim. Try to keep the spoke as straight as possible when threading it around the other spokes. Slight bends will be taken out when it is tightened.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41936">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_sw-1_spoke_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rhKvIvrSwTTgDrDV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using an SW-1 spoke wrench, tighten the spoke.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

