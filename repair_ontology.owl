  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ojQBFCgLLWjW2lLe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jjuZTAADLpjbXvVp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the excess slack in the gimbal cable up into the body of the Phantom. When reinstalling the case top shell, be careful not to pinch any wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_80786">
