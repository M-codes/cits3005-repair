  <has_step rdf:resource="#Step_154627"/>
  <has_step rdf:resource="#Step_154628"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Parrot Bebop Drone GPS Board Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154460">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DOofjURaYmfT26bY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kXFKVOH1oyhKOoMx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by removing the velcro strap around the battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154463">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y6vmPxUMoOgwGFJQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rRlLVJNwA3f2Z2DR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While holding onto the nose, gently pull the battery away from the nose.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154469">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QENakdYVsCGwpWGr.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Uk4uRtQBdVSlxQha.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Lpercpp5S2XNpqJh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the battery is separated from the nose, push down on the connector and pull the battery away from the connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154398">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t5_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QFEuRutUOY63MSKY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PyIR1yFOWNSmYdUX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 7mm T5 torx  screws using a screwdriver. There is one located on each side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154399">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/s3TUhXqNANdJHMJC.standard"/>
  <has_tool rdf:resource="#Tool_metal_spudger"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the metal spudger, to remove the double stick tape from the foam.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154400">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xIYQthEoAWZMNxJt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the styrofoam nose from over the drone's camera by sliding it towards the front of the drone at an angle.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_pro_tech_toolkit">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154516">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZX1RpeiSNm3IOLuD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5JTEyrCDGVtOBPlF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the two connectors that are attached to the front of the motherboard by gently pulling on the three wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154525">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t5_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DsN5EluHKf1jKFkT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 5mm torx T5 screws on the bottom of the drone with a Torx Screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154526">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cLpnRkjenZrl5CXs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lightly pull up using the plastic opening tool to remove the back cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154539">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J2OYgiXBcGLHdiVt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cp4dR4YoTwFUXma1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a small pair of tweezers remove the two antenna wires attached to the motherboard. When reconnecting the antenna wires to the motherboard, use the tweezers to place the connector on top of the connection plate and using the 150 mm Flex Extension push down on the gold connector to snap it in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154535">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6H1SRJgF4Fai5pxq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four wheel fasteners holding the frame together. Hand turn or use a small plier, if tight to loosen the wheel fasteners.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154557">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IO4GHd1AwVPF32Vl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/25xxCh1rP2sTTg4T.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jnKis5SJHckWsO4f.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using both hands gently pull the two pieces of the frame apart until you can see the connectors under the frame attached to the motherboard. Remove both of the connectors from the motherboard. There is one connector on each side. Do not fully remove the frame until both of the connectors are detached from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154558">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xP2LEZTGuDOcciJB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HO2xYUbiGkpivrol.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four rubber shock absorbers by squeezing and twisting them while also pulling up. Insert replacement rubber shock absorbers by placing one side in the hole and pushing down. Verify the shock absorbers are seated with a gentle tug.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154626">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lsnaVjFxQFmGZyc2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the cable from the top of the GPS module.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154627">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t5_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nMELhCkbo2UYrIYW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DqUGW2h5hJ6eJysA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 6mm T5 torx screws holding the GPS module. There is one screw on each side. Remove the  4mm T5 Screw holding the GPS Module.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154628">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/w6AySJiyu1TtfNaD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the GPS board by lifting it off of the metal frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

