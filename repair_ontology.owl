  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/W25RCPSG4yp4AK1c.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4FgrVZYJqUqFYJaU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove Blade Guards by unscrewing two 13 millimeter screws using Philips #0. Pull out the guards. Repeat the steps for the other three corners.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154585">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/I12NFmbQy6B4EODV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NHVxDJhrPKlwyrXc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew two 9 mm screws located inside the legs. Repeat the same procedure for the other three legs</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154588">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NTBfearNmqktbYLj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GLwkpSvpSJ3GGeN6.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ah5XTtG6xITvqMoO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unplug the camera wire. Press the hold release button and slide out the camera module away from the button.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154590">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wKGIPLwUQXqBIsPV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YJHFaDWDctPGrnpK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the motor protection cover by unscrewing two 9 mm screws using Philips #0. When the screws are off, use your fingers to pull the motor protection cover off. Repeat the procedure for the other three arms.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154602">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XWys12dyG6PMOwLn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aDZ5EEMhNLxiivDE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/a3CPur6hPRTVnArZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unclip the motor cable from the shells housing using two pry tools. Repeat the same procedure for the other three arms.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154603">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Q3VRaiPtrDHpliFE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 3 9mm screws around the motor housing. Repeat the steps for the three other arms.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154606">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/teXmmSY3cdQjSBFN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EqhfDiLQbDqc1AXJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove four 9 mm screws located where the legs originally are placed. (Use a thin head screwdriver)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154607">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rKlkvfNHDHbQPIKC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iCRG3ZlEUTKFgMEA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/K3Vt6KQMIovBsCbr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cut the yellow strips using a scalpel. Pry open the casing using pry tools working gently around the corners.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154604">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bHd3WSRSRWPTuFgb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the motor assembly from the bottom shell.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154605">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HrqwFvLYUtfCLHRQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FQ1VATBp3FoU1qxj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the pinion gear off of the motor assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154576">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMjCIRNGZYiXoVJH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aajOVnSmLfQvxsGl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4mm Philips screws from the motor. Separate the motor from the plastic motor holder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

