  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J34kOOTSdTXb1RcK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wXEaIyYaaoOkkxlV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 8mm Allen wrench, unscrew 2  (32mm) screws to release the brake calipers from the fork. If necessary use wire cutters to release zip ties attaching cables to the forks.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41694">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_8_allen_wrench"/>
  <has_tool rdf:resource="#Tool_4_allen_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jxXniJIKieuUTsUG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eFJtN1jxJoER1y5x.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hvUm2lbPcYA1wLPg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 8mm Allen wrench, unscrew the 30mm head screw located on top of the steam. Using the 4mm Allen wrench, loosen the side screw on both sides. Lift off the handlebar. Hang the handlebar gently from the cables. Do not pull the cables as you may damage the brake/derailleur lines.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41695">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZkGXQtHohRpeRXdI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OQb31qAGJQF4pBRD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EJKuB2PTdsMhThiW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide off the spacers. Lift off the seal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41938">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/e2th4m4ombEwpUJ1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the fork out of the casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41939">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/45TQlyrQKBlQIJt1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, pry the bearings from the top and bottom of the headset.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41696">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_paper_towels"/>
  <has_tool rdf:resource="#Tool_wd-40"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QZuRxgBFc3MEatOi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apply WD-40 to both ends of the headset and bearings. Dry headset and bearings with paper towels. Repeat as necessary until clean.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41940">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_all-purpose_lube"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1r2AA3ngNMGUhbHx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3gHdrArLcCCKhPA5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your finger, apply all-purpose lube to the bearings and each end of the headset. Insert the bearings into the headset with the beveled side facing into the headset.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_hydraulic_brake_syringes">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_2.5mm_flathead_screwdriver">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_t6_torx_screwdriver">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41739">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UWNkI2WUcPB6lWCj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull out and rotate the quick release lever until the axle is loose. Pull back on the derailleur on the left hand side. This would remove the tension holding the rear wheel in place. Pull the wheel in a downward motion to remove the wheel. If there is a replacement wheel the bike may not have a quick release. In which case you would need to use the correct wrench size to loosen the axial.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41740">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QWH1SlWO5ao4uQdn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a flat head screwdriver to push out on the break pads in order to space the hydraulic pistons. The hydraulic pistons should be fully extended. This can be checked by making sure the gap between the pads are maxed out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41741">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ao6KLeWEmUZp2UQX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RyPsUSvkrJMqVcVL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the cover off of the hydraulic port until it is fully exposed. Use a torque spit to remove the screw on the hydraulic port of the brake handle.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41742">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mnyl1NbqfbogyLUG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a torque spit to remove the screw on the brake caliper.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41743">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Sf4PNHlXxcGdPkSU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/14gbIHKJwy2VoLOh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Put hydraulic brake fluid into the syringe. Clear air out of the syringe by holding it upright, flicking on it with your finger, and pushing on the stopper until hydraulic fluid starts to come out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41946">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Iwpe5T1YvDDSyLdD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sQEnaNiDlFusLefB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Screw the full syringe into the port on the caliper. Screw the empty syringe into the port on the lever.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41744">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gVmUFoiggPcrWdIx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CrUJKmxP5TNRUxux.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push the stopper down on the loaded syringe until it is almost empty. Do not empty the syringe all of the way. This may put air into the brake lines. The empty syringe will fill with the excess hydraulic fluid. Always push the fluid through the system starting from the lowest point. In this case it is the rear brakes.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41947">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_hydraulic_brake_syringes"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MifYek2VbF4DpZtW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZDGQNSxWthkmhrHT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the syringes and replace the port screws on the lever and caliper. Replace the caliper port screw first, then the brake handle port screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_5_allen_wrench">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_7_16_crescent_wrench">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41941">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RDCHgaDLFhBVJ4vR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orient the bike upside down.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41942">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZQoUidPQNaPS6VPg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 10mm screw and take the bash guard off of the frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41943">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FH5wX5rL1RGqNdZr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 65mm screw that connects the bottom of the shock to the frame. As shown in the blue box, you will need to use a wrench to hold the other side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41944">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UGuHbxjfPBSTPeQ1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 40mm screw that connects the shock to the link arm of the suspension.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_41945">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Q1WpgMYTQKHcXsPm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fYdJFdFlA2yxPdYd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push the shock out of the brackets mounting it to the frame and suspension arm. This may require some force and slight wiggling from side to side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

