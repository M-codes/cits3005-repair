<owl:NamedIndividual rdf:about="#Procedure_31795">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_tool rdf:resource="#Tool_adjustable_wrench"/>
  <has_step rdf:resource="#Step_74006"/>
  <has_step rdf:resource="#Step_74007"/>
  <has_step rdf:resource="#Step_74009"/>
  <has_step rdf:resource="#Step_74010"/>
  <has_step rdf:resource="#Step_74011"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Magna Outreach Rear tire Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_74006">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cASibFe3gpTqG4De.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the rear brake cable</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_74007">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_tool rdf:resource="#Tool_adjustable_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OJ1LjldHQPZNyIJB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the bike over so that it is resting on the seat and handlebars. Use an adjustable wrench to remove the nuts on both sides of the wheel that hold the wheel to the frame. Lift the tire away from the frame and chain.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_74009">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CWNAMiuEIWSaSZnf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert one tire lever under the tire and hook it onto a spoke.  Insert the other tire lever next to the first and slide it along the rim to remove one side of the tire from the rim.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_74010">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lWRgGSPTtAlZLFWN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting at the valve, pull the inner tube out of the gap between the rim and the tire.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_74011">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tire_lever"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iukpTnWDjeB3qUM3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the tire away from the rim.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cASibFe3gpTqG4De.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

