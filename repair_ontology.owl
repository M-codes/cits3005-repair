  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loosen the cable from the plastic landing gear. Unplug the magnetometer molex connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
