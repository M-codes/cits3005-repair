  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the foam body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132408">
  <rdf:type rdf:resource="#Step"/>
