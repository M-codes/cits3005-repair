<owl:NamedIndividual rdf:about="#Step_80742">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Bj3tpFwXfLTNSmd1.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HIWIayBRcvMo45gW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6Duc4XB3SxX5RfE3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift up on the top portion of the shell and set it on its side. '''Do not '''attempt to fully remove the case. The GPS and Magnetometer cables connect the top shell to the rest of the Phantom, be careful not to stress or break these cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_80746">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FjKSvEB5bdT25PVu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JKgNI5YHhUFQKbRp.standard"/>
  <has_tool rdf:resource="#Tool_12_mm_socket"/>
