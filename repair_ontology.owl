  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Line up the GoPro camera with the pins on the gimbal mount. Press the GoPro camera firmly against the gimbal and ensure a snug fit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
