<owl:NamedIndividual rdf:about="#Step_184117">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QqEfM6asDDCxWOtC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KYZZeITNr6MsWPp5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure the drone is powered off. Press in and lift battery compartment cover. A soft pry tool may be used for easier access.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_184121">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mtZK6qwPcxoJIFZu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove battery pack from body of drone.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_184124">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/d22JHwJtR42NJBhR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xEVTgfo6VNuF1j3H.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect white connectors between the battery pack and drone.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185562">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_00_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YYrUPq5pPqJXDeVe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the eight (8) 5mm screws attaching the motor arms to the body using a JIS #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185565">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_00_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xddMvGTXbjfcUhjG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2XjGHC2AlgHjQABm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the six (6) 5mm screws attaching the Body Cover to the Body of the drone using a JIS #00 screwdriver. Remove the Body Cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185566">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_00_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sCJepYDEAGhQsqKs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dBUlgkMp1nTW3Slg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two (2) 5mm screws attaching the Motherboard to the body of the drone using a JIS #00 screwdriver. Lift the Motherboard off the mounting position. Do not pull hard on the Motherboard as solder connections are fragile.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185568">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QGk5K56x6yd3xfkr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the tape covering the camera with the tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185577">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T4Kt5vaRMaSvHtql.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GryDxRe3r6SUEiKJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the plastic holding the ribbon cable connector with the tweezers. Be careful with the ribbon cable, it is easy to damage.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185600">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Cjs22BddsKpokPDv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move the ribbon cable out of the way with the Spuger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185605">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J4xXuJJo6TLVX1h3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eL2jOITcYVGn3QNe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the camera by gently prying it out of the bracket with the spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_jis_0_screwdriver">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185516">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jsLTX1KxbPJhbYsI.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the eight (8) 5mm Philips screws attaching the motor arms to the body using a Philips J00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185517">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NFFTZI6gV4rZErZR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/odWJPiEP2LX6jLyZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the six (6) 5mm Philips screws attaching the Body Cover to the Body of the drone using a Philips J00 screwdriver. Remove the Body Cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185532">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yXCs6abaflB5geNS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MydKWsuRdScVkdZq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two (2) 5mm Philips screws attaching the Motherboard to the body of the drone using a Philips J00 screwdriver. Lift the Motherboard off the mounting position. Do not pull hard on the Motherboard as solder connections are fragile.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_185549">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mojTYB6VJtjXEHMq.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/feVbLWe2AiiLPUMD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''This step contains a tool that can present a potential burn hazard.''' Prepare and warm up a soldering iron. Position Motherboard so that the L.E.D. bulb solder joints are accessible. Use the soldering iron to melt the solder joints. For more detailed instructions on how to solder, visit out [https://www.ifixit.com/Guide/How+To+Solder+and+Desolder+Connections/750|How to Solder and Desolder Connections] guide. Remove the L.E.D. bulb from the Motherboard</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

