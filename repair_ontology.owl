  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the drone upside down. The cover is held on by plastic tape. Peel off the tape and use a spudger to remove the back cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131954">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XXEIiMdWHFhhMb5U.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6Dn5UXlH43KYTBpc.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yHsjeKuRWsbntyRj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a spudger, separate the connector for the downward camera. Remove the camera from the body by pulling it off the foam body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131955">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2Pq4gjPoRTvIdLgg.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4nEdJeSnVIfR4ybK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger to release the black retaining clip. Then  disconnect the connector to the sensors. Use tweezers to carefully remove the ribbon from the connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131956">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t6_torx_screwdriver"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ciRCStIjEIeOLLEw.standard"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 8mm torx screws with a T6 bit. Remove the four 8mm philips head screws with a PH00 bit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131957">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AAPgcRIvQNAdBZQa.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NAITADZEntVyGXQO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully pull the secondary board from the mainboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131958">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wJ2ghsTWyiDKihKR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dBGcOCDFXwDmYOST.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XyMAOPToRkMrUm3N.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the drone right side up Remove the USB connector from the battery retaining straps.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131959">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XH4oHykiiCWghhSn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Release the rubber clip holding the USB and battery power cable to the body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131960">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3ZsMyygPQ1yvUfK4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QF1EVVKwhYgCKqcx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Avoid using sharp tools near the battery. Push the USB and power cable through the battery panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131961">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mvrptx4HUWgXJ5OM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vXRsvBuBNhef6lRN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the drone upside down again. Use a spudger to release the connector and carefully remove the ribbon.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131962">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hPPImSCrbtCKLAGu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JAFH55kLYGZWlvHq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the mainboard up so that you can access the back. Disconnect the first connector with the white wires using a nylon spudger. Disconnect the second connector with the red and black wires using a spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_131963">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UcPwA1lBmesouuxN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mainboard is now fully detached and can be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132066">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Og2loKh1SjwMS6AK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a nylon spudger, peel off the four pieces of plastic securing the frame to the body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132067">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZMHmhmZINjIpTVLw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully maneuver the four arms of the drone’s central cross until it detaches from the body by pulling apart the foam surrounding the arms.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132068">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RIXLLDeiwtWedaW4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The central cross can now be removed and replaced.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

