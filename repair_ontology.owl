</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194676">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/odZD5YXL2SSJSWan.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QTX35fom4hwpIGXS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips #0 screwdriver, remove the screw connecting the battery cover to the controller. Remove the battery cover from the controller.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194678">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lWKSAbqdoNWocuNg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all of four of the AA batteries from the controller.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194911">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ty4AEkJx4XgCV1a3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips #0 screwdriver, remove the four screws connecting the propellers to the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194913">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tlDRHGN2RnFTYMLF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OU1eXPgCM2ykPrWY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hold the propellers gently and pull the propellers out of the drone .</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194918">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xhZMcEE6YIUggANW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XGSTOchtFZjtfIuR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y1CEFsfQLREhPjbl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a plastic opening tool or a spudger to separate the drone's cover from the body of the drone. Remove the connector of the drone body and the back wheels using a plastic opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194919">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LdDPCEyxMvckqCse.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BWjn2CwJbAY1sQSX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the opening tool to separate the drone's body from the drone's shock absorber.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_194920">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CMoYFmy6RNrwXxQy.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vRmuUCPRh6xxlf5Z.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cD2BbPlH6JSYHQCu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hold the wheels gently then pull it out of the drone's lower board wheels connector. Repeat the same step for the other front wheel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

