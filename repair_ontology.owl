<owl:NamedIndividual rdf:about="#Small_Engine">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_86016"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_86016">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_tool rdf:resource="#Tool_socket_set"/>
  <has_step rdf:resource="#Step_162074"/>
  <has_step rdf:resource="#Step_162075"/>
  <has_step rdf:resource="#Step_162076"/>
  <has_step rdf:resource="#Step_162078"/>
  <has_step rdf:resource="#Step_162080"/>
  <has_step rdf:resource="#Step_162081"/>
  <has_step rdf:resource="#Step_162082"/>
  <has_step rdf:resource="#Step_162083"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small Engine Recoil Starter Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_socket_set">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162074">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HK3ZFYMEMI3rKoQh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To begin the repair remove the protective casing. (This removal may vary with different lawnmowers.)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162075">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bcBYPhBpih5YMsSb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the recoil housing cap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162076">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TVS5OVieZCFUKgZA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the housing cap. (Removal may vary)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162078">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lAuw1XmJFTHxG5F5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the recoil, unscrew the cap that holds the pulley to the recoil starter housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162080">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PEQmpF4iKXMqUVnk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Untie the knot in the rope and slide it out of the housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162081">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_socket_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/flKGK5ctDLbCPR4J.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With this particular model there is a middle lock piece. Use a socket wrench to unscrew and release the coil.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162082">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OWPgKdHIRukPLYr3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once unscrewed, remove the metal piece which releases the tension on the coil.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_162083">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WFnPXChGcVA1SthF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At this point add the new coil to the housing base. Snap the coil into position where the old on was.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

