  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing all four propellors, flip the drone over. Remove the following screws from the underside of the drone: Twelve 2.0 mm hex screws Four Phillips #0 screws</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
