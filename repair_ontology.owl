  <has_step rdf:resource="#Step_109834"/>
  <has_step rdf:resource="#Step_109842"/>
  <has_step rdf:resource="#Step_109845"/>
  <has_step rdf:resource="#Step_109848"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How to Use a CO2 Cartridge to Re-Inflate the Rear Wheel of a Road Bike</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_97721">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_t5_torx_screwdriver"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_tool rdf:resource="#Tool_double-sided_tape"/>
  <has_step rdf:resource="#Step_179169"/>
  <has_step rdf:resource="#Step_179170"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Magellan Cyclo 505 Battery Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_co2_cartridge">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_park_tool_tl-1_tire_lever_set">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_repleacement_inner_tube_700_x25_c">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109200">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ltFtBd2rPSBeU14i.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Xsp4QUso2x2AdekK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Removing the rear wheel of a road bike, generally, is quite easy, but it can be messy if the bike chain has excessive grease. Figure out which tire is flat. In this case, the rear wheel is flat.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109214">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Q4XaVdYfLoT1eNb3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fgGNos3NxOFxDysr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disengage the brakes. This will allow the wheel to slide out smoother.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109400">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3GnRfmf6FkWOW6js.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To easily remove the rear wheel, flip the bike upside down so that it's sitting on the handle bars and seat.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109411">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UtEKYZy12IOLNxeA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Tq1VtHbPEfFBliIf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disengage the quick-release lever to loosen the wheel. Turn the quick-release lever a few times while you hold the  cap on the opposite side of the wheel. Don't unscrew the lever or cap too much or else a spring will pop out. If the spring comes out, place the spring back on the bar and tighten the cap or lever.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109676">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/M4fFlRMKIfpB4BDK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vpaGogICiMlGQKNR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CIRwiuiCnYgZAljT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the wheel out. Pull the rear shifter into a straight line so the wheel will be able to slide out smoothly. Pull out the wheel with one hand while you hold the rear shifter. Be cautious with the rear shifter.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109687">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cErHwwWdDy1HllFH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hSAOVkybfHdqG6NA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AuvmQCEd3Ltqyg4w.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that the rear wheel is off the bike, use the tire lever to get under the tire. Once the tire lever is under the tire, bring it around the rim of the wheel slowly sliding the tire off wheel. Ideally, three tire levers are used to get the tire off. However, one tire lever has proven to be sufficient.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109704">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_repleacement_inner_tube_700_x25_c"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/as2mRNbGg35uZGdQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sFNn6LagPe1OchrZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull out the inner tube. The valve should be the last thing that is pulled out from the wheel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109820">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_repleacement_inner_tube_700_x25_c"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tkOCpxZ1sIJQMeVE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace inner tube or patch the hole if necessary.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109827">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_tool rdf:resource="#Tool_repleacement_inner_tube_700_x25_c"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5QLTvGXTtI4MGeEl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/V3uApQZRSPWndoSA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the inner tube back inside the tire. Put the valve into the hole first, then bring the inner tube around the rim of the wheel. Using the tire lever, pry the tire back onto the wheel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109832">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_co2_cartridge"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XFwLbZUxM6NOOXTW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5DdkUkDIHeJTeIni.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that the tire is back on the wheel, screw the adapter onto the CO2 cartridge and place it on the valve.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109834">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_co2_cartridge"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VQWyVvkSeZEr2sq3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uXocjScGjkIV3LR3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press the CO2 cartridge towards the rim of the wheel. The inner tube inflates quickly, so hold the CO2 cartridge for a short period of time. The valve might freeze while doing this, but this is normal</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109842">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BUUXQwkwSGFIKo1p.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lPKyETvVjhnIGDjU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qVOHnE1pcfBJrWy4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fit the wheel back onto the bike. Pull the rear shifter into a straight line and place the gears underneath the chain to slide into place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109845">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OEeGWtCTOYRFAtcW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CGBoSZtwwf1gH1ld.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tighten the quick-release lever and close it. Twist the lever as you hold the cap on the opposite side as tight as possible. Re-engage the brakes. Turn the grey lever downwards on the brake, such as in step 2.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109848">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_park_tool_tl-1_tire_lever_set"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MiXJlAtnOKD5JGBM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedal a little while the bike is lifted slightly off the ground to move the chain back into place. The chain was placed on a different  chain ring when the rear tire was pulled out, so it needs to readjust.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_t5_torx_screwdriver">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_179169">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GIfAlGIjiaGXCQkE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rpTpsUAbtGg6ktX5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start lifting the snap on rear cover by inserting a plastic guitar pick/phone opener between the case and the cover starting in the charging bay area.   Slide it around the entire cover until it comes away. It will make clicking sounds as you do so. It's ok that is the little snap on locks opening.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_179170">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t5_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BGaHU2qaBhWbHpfB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tulURSyKsCSxEOM4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qNjPpELyg2LVaNTH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You will now see 6 x T5 torx screws that need to be removed. Remove  them and the case will open up. The battery is held in by some double sided tape and plugged in.  Remove it and put in the new one.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ltFtBd2rPSBeU14i.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

