<owl:NamedIndividual rdf:about="#Step_181666">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZfMAjfrCytQCOUjB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the drone is turned off</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_181667">
  <rdf:type rdf:resource="#Step"/>
