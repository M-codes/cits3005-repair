  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_needlenose_pliers"/>
  <has_tool rdf:resource="#Tool_10_mm_wrench"/>
  <has_step rdf:resource="#Step_59144"/>
  <has_step rdf:resource="#Step_59522"/>
  <has_step rdf:resource="#Step_59523"/>
  <has_step rdf:resource="#Step_59525"/>
  <has_step rdf:resource="#Step_59151"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tightening Mt. Fury Roadmaster Brake Cables</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59144">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_10_mm_wrench"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PgO2ifepQCwqYNsU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loosen the bolt that clamps the brake cable on the brake caliper with the 10mm open-end wrench.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59522">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VGGO2TbJhq1Wk1yo.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the brake cable until proper tension is acquired and the cable shows resistance.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59523">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WJKZqBBYJySLL5dI.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Re-tighten the clamping nut.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59525">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PxNKjcSVRy6Tq53Z.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If necessary, adjust the positioning of the caliper arms by loosening the dome nut at the pivot point and manually shifting the arms in the desired direction.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_59151">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_needlenose_pliers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WaMTfOMEdnKPU6NW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For more precise adjustment of the brake cable tension, use pliers to tighten the barrel nut at the opposite ends of the handlebars on the brake levers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

