</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_37587">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_sand_paper_rough_and_fine"/>
  <has_tool rdf:resource="#Tool_electric_sander"/>
  <has_tool rdf:resource="#Tool_fiber_glass_mat"/>
