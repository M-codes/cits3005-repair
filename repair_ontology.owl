  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the connector at the bottom of the motor assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_132077">
