<owl:NamedIndividual rdf:about="#Step_34963">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vA33GEfhBAK1e4lP.standard"/>
