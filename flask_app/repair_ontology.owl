  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While holding down the black plastic on the right edge of the metal plate, pry the plate up and to the right until it is completely vertical. Lift the metal plate straight up to remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

