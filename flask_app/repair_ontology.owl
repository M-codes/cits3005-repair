<owl:NamedIndividual rdf:about="#Step_25403">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HF6eKBAypBkE4niL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/va1Xu1TDbLEEn2rT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now the photo sensor is exposed. In order to remove the ribbon cable from its port, first flip up the blue locking mechanism. After the cable is unlocked, it easily pulls free.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HF6eKBAypBkE4niL.standard">
