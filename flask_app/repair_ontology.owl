  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the metal plate under the motherboard. Use  a Phillips head #00 screwdriver to remove the eleven 5.00mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tvx62dRZZDiVqSEb.standard">
