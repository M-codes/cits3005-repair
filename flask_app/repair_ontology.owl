  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minolta Dimage Xt Capture Button Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_45887">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/51QDpmIx2LW2BUoS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Choosing the front half of the casing, locate the capture button on the top. Using tweezers, apply pressure to the two black hooks (circled in red) while holding the button down from the outside of the case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/51QDpmIx2LW2BUoS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_46183">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Nm2SMGDmfgVyUycQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The button will spring free. The capture device consists of the plastic button and a small metal spring. The button can be reassembled by using the tweezers to place the spring rectangle-side down on the button and snapping the button back into place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Nm2SMGDmfgVyUycQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

