  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the exterior screws, use your fingers to gently lift off the front face plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JHAOdXOxJTXssqHY.standard">
