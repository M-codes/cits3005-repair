  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove three black 3.80mm screws on the back of the camera with the Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
