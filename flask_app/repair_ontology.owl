  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all the marked screws using a PH00 screwdriver. Remove the two 3mm screws on the grip. Remove the two 4mm screws on the side opposite the grip. Remove the three 4mm screws on the base of the camera. Remove the four 3mm screws on the base of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
