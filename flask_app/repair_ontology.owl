<owl:NamedIndividual rdf:about="#Step_85512">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WT2vGrxaOVZ1X4YI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VoWIUIhysGL3AcHC.standard"/>
