  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the three small, silver screws (2mm, Phillips #00) attaching the cover plate. Remove the cover plate by tugging up slightly and to the right.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

