<owl:NamedIndividual rdf:about="#Step_129156">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/anMljwv1XZYbT4cy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Having completed the previous guides up to this point you should be left with the chassis and internal frame exposed</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/anMljwv1XZYbT4cy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129160">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wpWyCCQNJtstK6li.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Sc3ob2MZfh2rvpTf.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m6qbf3SeaHAnIxXO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start by removing nine (4mm, PH00) of the screws which hold the outer silver trim bezels to the main chassis highlighted in red.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wpWyCCQNJtstK6li.standard">
