  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all screws listed below using a Phillips #000 Screwdriver: Lift up the screen and remove the two 4.5 mm screws located in the bottom corners. Remove the 4.0 mm screw that is located behind the screen and directly under the eye piece.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

