</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25404">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_precision_utility_knife"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hMPTOQhtpJPhjFMU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5KEvuEVDXsQBYnhr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In order to remove the photo sensor, you will have to cut through glue and remove screws. Use a knife to carefully slice through the glue at the tree points indicated. Try not to cut through anything but the glue to avoid damage. WARNING: Knives are sharp. Treat them with respect. Now remove the three .15 inch screws holding the photo sensor to the camera frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hMPTOQhtpJPhjFMU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5KEvuEVDXsQBYnhr.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25408">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4F2CT2mksVk6AFq2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pdJVnOJZGHla5feQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you can carefully lift up the image sensor and remove it from the camera. Be careful not to lose the three small springs or the rubber grommet that lie beneath the sensor.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4F2CT2mksVk6AFq2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pdJVnOJZGHla5feQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25501">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1QLJVv6VuVGB1lnb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You have now successfully removed the image sensor.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1QLJVv6VuVGB1lnb.standard">
