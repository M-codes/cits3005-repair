<owl:NamedIndividual rdf:about="#Step_97543">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3rutfwXs2IP1y23O.standard"/>
