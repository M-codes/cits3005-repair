<owl:NamedIndividual rdf:about="#Step_22019">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kOvDTMFpOTGOStDJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Nuqe5bDwjKLmoVHK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The battery compartment is located on the bottom side of the camera.  Push the button in, and slide the cover to get access to the batteries.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kOvDTMFpOTGOStDJ.standard">
