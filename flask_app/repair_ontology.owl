</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JrwCvCYUDJUFSNOq.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_54314">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bti6XaqPImhSQSeX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UyaKDDF6I6HElT1N.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/n3smEJmqWqvpChbM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera with the lens facing down. Use the phillips head screwdriver to remove the silver screw in the corner near the photo capture button. Flip the camera over. Use the plastic opening tool to detach the black clip near the capture button. Grasp the top cover and gently remove it from the camera body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

