  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the spudger and wedge it in between the screen and the frame. Slowly make your way around the screen with the spudger just enough to separate the screen from the frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

