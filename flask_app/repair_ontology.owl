  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove stickers off of connectors. Open latch door on connectors. Separate lens from motherboard. Now you may replace either motherboard or lens with new part.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

