  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155327">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NI6tjnRQKdApGJfQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/26NaDld4mBHKdgKl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, lift the black retaining flap holding down the larger orange ribbon cable. Carefully remove the ribbon cable from the ZIF connector as before.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NI6tjnRQKdApGJfQ.standard">
