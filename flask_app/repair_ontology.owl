  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the iFIXIT curved nose tweezers, gently remove the ribbon cable for the flash. Doing so will reveal yet another hidden screw. Remove this with the iFIXIT screwdriver and PH00 bit to release the flash assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

