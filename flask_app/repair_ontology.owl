  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew both screws using the Phillips head (PH1) screw bit and set aside for reassembly ''Screw Measurements: Length: 7.1mm'' The motor should be free of its housing and only be attached to the motherboard by its wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

