  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two screws attached to internal part of lens using screwdriver Using tweezers to remove thin black layer to reveal lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
