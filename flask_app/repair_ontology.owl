  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the plastic opening tool, carefully insert it between the camera cover and the bottom cover. Pull it apart. Using a plastic tool will prevent the device from being permanently damaged. Avoid using metal tools for this device. The bottom covering is attached by a hinge. Removing this part will also require a small amount of force to separate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

