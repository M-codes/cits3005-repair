</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_88735">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZDxMA321LKWtjayK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the phillips head screwdriver (PH000) locate and remove the 4.45mm (.175in) screw by the 180 degree graphic on the metal ring. The screws in the camera are very small and can strip very easily. Apply consistent pressure when removing screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZDxMA321LKWtjayK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_88737">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eK5pS6cx6TfxUoHF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nElH1eKMjIM1MFEn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate the metal ring counterclockwise until completely removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eK5pS6cx6TfxUoHF.standard">
  <rdf:type rdf:resource="#Image"/>
