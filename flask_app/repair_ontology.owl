</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AEZO3DUR2RDApSRt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_93208">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VAZWXkQGTCaaCbcO.standard"/>
