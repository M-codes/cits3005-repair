  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that your motherboard has been removed you can replace it!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
