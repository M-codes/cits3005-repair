  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once all the screws are removed, the panel should easily come off. Remove the bottom panel of the camera by placing your index finger and thumb on the outer edges of the panel. Pull the bottom panel towards you, it should come off easily.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

