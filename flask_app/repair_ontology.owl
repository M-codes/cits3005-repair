<owl:NamedIndividual rdf:about="#Step_198017">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2IWBtoWmFUKFkmTV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tZpgwxaxeEWOXW1A.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the three 3mm screws holding the photoreceptor in place. Lift the photoreceptor and gently pull it to release the now disconnected ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2IWBtoWmFUKFkmTV.standard">
