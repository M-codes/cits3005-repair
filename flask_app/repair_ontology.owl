</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/i5vcFhkG6yvMIiRj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_45882">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MDeMyuRRhbJ1N4Xe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/K2uZZmetQ6ZTiP3Q.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LoWdMMKZlOS1iByZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Then, carefully pry apart the front and back outer casing away from the internal components. Be aware of the ribbon wire that will disconnect when the casing is detached.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MDeMyuRRhbJ1N4Xe.standard">
