<owl:NamedIndividual rdf:about="#Step_62096">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1NhWiGfGJ22X22FW.standard"/>
