  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger to lift the motherboard up starting on the right side proceeding to the left side. Use your fingers to lift the motherboard completely out of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
