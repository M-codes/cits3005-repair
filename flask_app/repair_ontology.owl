  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10368">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/61CUc3sTwxgAT2AR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dVvSvYmSrKQSpXgV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the rear cover off the body of the D70, minding the LCD board ribbon cable that may get caught. At this point, the capacitor is visible and its exposed contacts are boxed in red in the second picture. Even though they are recessed, be careful not to touch the contacts to avoid shocking yourself.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/61CUc3sTwxgAT2AR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dVvSvYmSrKQSpXgV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10453">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/h1xj6WNCY3Afi3iL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DxxjINogLA1DcbT3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your thumbnails to push the ZIF cable lock toward the LCD. Do not completely remove the ZIF cable lock. It should move about 1 mm and stop. Be sure you are pushing against the lock, not the socket. Pull the LCD ribbon cable out of its socket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

