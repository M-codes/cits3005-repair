  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the HDMI flap and remove the 2 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xIhuWZoKQYWphRsT.standard">
