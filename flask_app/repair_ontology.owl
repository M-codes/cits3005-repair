  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jNtXhdMORNOabkRL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lens assembly is now separated from all other components. Follow the steps in reverse order to re-install new lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

