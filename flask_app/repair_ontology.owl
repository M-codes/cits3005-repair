<owl:NamedIndividual rdf:about="#Step_70704">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/C2mQP1GH6AJQPYak.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING: If you’re not careful with keeping the screen close to the board, you will rip off the ribbon attaching the screen to the circuit board. Lift display screen keeping the top half close to the board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/C2mQP1GH6AJQPYak.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_76190">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JcyQIB6BlIbJJGD1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently flip the black clip up attaching the ribbon of the screen to the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JcyQIB6BlIbJJGD1.standard">
