  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2.0 mm Phillips screws on both sides of the camera using the Phillips #00 screwdriver. There will be 4 total screws that need to be removed, 2 on each side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eMeGBCvI4xVbYPdJ.standard">
