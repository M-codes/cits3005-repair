  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the plastic casing away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HNYKMJXJdLZKvGho.standard">
