  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, remove the flash assembly. If difficult to remove,  use the flat end of the spudger to lift the flash assembly from the bottom. The flash assembly should now be free from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

