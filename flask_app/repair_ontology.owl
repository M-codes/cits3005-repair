  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the metal spudger, pry out the edge of the silver strip at the bottom right side of the camera. Carefully remove the remaining part of the metal strip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
