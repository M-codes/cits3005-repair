  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/b2TrFnsXGNO2xvtT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You can now take out the screen to be replaced. Carefully remove cables from the data board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

