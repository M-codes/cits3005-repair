  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four PH00 2.5 mm screws around the edges of the display plate. Remove the three PH00 2 mm screws from the sides of the buttons plate and the 2.5 mm screw from the center of the buttons plate. Lift the buttons plate out of the camera with the plastic tool. Lift the display plate out of the camera with the plastic tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

