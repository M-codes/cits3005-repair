  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a J1 Philips head screwdriver, unscrew all four 6.1 mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

