  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Align the camera so that the side with "4x Optical Zoom" is facing toward you. Gently twist the bottom corner clockwise until you feel the side panel unlock. Lift off the side panel and set aside.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

