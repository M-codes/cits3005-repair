  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UpFOJEL3gTqUXfIW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PocVZJMEarZZKoNO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the three bronze screws (2mm, Phillips #00) attached to the motherboard. Shift the board up carefully away from the rest of the assembly. ''Do not pull the motherboard away abruptly. A ribbon cable is attached on the back.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UpFOJEL3gTqUXfIW.standard">
