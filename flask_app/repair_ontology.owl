  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a pair of precision tweezers, slide one end under the memory card. Firmly grip the memory card with the tweezers and pull directly outwards. The tweezers may not be necessary in this step and the memory card may be removed by hand using a finger nail.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

