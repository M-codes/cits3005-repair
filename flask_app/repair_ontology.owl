  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the loose frame counter. Apply a small amount of glue to the area and wait approximately 5 minutes for it to dry. Put the frame counter back into place, lining up "26" to the indicated notch. Tip: use a toothpick to apply the glue to ensure you don't glue down any moving parts.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

