  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3mm screw on the top left. NOTE: When reassembling, it is helpful to put the top screw back in before placing the front cover back on the camera. Now remove the 5.3mm screw on the bottom.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pLcfAtxQMKyFhKHU.standard">
