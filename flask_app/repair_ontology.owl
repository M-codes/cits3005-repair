  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_170001">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_2.5mm_flathead_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/COCwJgELvdSDF2wU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screw holding the metal component of the lever with a flathead screwdriver. Once the screw has been taken off, remove the metal lever. This is a reverse threaded screw. Twist clockwise to remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/COCwJgELvdSDF2wU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_170004">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_2.5mm_flathead_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Z6VdCAZgkbhXIfwx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cHM5DsVrhsChCuMV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Set the speed dial to Bulb mode and the ISO to the lowest setting before taking it off. This makes sure you are at the correct settings when it is placed back together. Carefully put a flathead screwdriver into a notch in the middle of the dial on the center piece and turn it counter-clockwise. Once loosened, remove the speed dial with your hands. Be careful when removing the speed dial! There are several small parts that may fall out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Z6VdCAZgkbhXIfwx.standard">
