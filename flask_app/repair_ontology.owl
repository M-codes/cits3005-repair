  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the top 2.3 mm screw from the side with the ports using a Phillips #00 screwdriver. Remove the 4 mm screw right below the one you just removed using a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
