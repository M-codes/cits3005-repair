  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the clasp from the ribbon cable using the plastic spudger. Make sure to be gentle when removing the clasp to prevent it from ripping. You may now remove the display.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

