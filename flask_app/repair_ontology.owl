  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VEOcNjZJqUJhfP2w.standard">
