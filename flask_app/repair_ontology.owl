<owl:NamedIndividual rdf:about="#Step_203195">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2y4g5XBfLyT1Y2bE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Separate the back panel of the camera from the actual camera. Be careful not to tear any of the ribbon cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2y4g5XBfLyT1Y2bE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_203196">
