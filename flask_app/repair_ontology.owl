  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a pair of tweezers to pull the LCD backlight connector away from its socket. It may help to wiggle the connector as you pull it out of its socket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
