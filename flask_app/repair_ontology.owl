  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the bottom of the camera, push and slide open the battery compartment. Remove the battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RKsMM6nveeXM2Iql.standard">
