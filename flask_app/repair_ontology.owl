  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_114548">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_magnetic_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IPnCYTpaGc1BSmQX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/osW62JFGfDcm1gkh.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MBAwdXodLJkPRWxO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a Phillips screwdriver and remove the eleven 5.556 mm screws around the outside frame of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IPnCYTpaGc1BSmQX.standard">
