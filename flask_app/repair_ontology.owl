</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62097">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Pgj5Q12EYjEiMtJY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gjsyjtbFNEM3GEBS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vlSSjAxBPxtyolXg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing you see a few wires and a screen placed on top of the circuit board looking similar to the first picture. If you don't, you might have not taken apart the wrong camera, yikes! The second picture outlines where you can locate all the surface screws. Note that these will not be the only screws needed to be taken off to remove the circuit board. As shown in the third picture be careful when removing the screw hidden behind the circuit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Pgj5Q12EYjEiMtJY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gjsyjtbFNEM3GEBS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vlSSjAxBPxtyolXg.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62098">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TJwgdGOtCiUMMZwQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vWSTQxHEuITe6usA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing two screws holding screen down flip screen over gently. Remove three screws underneath screen as shown in pictures</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TJwgdGOtCiUMMZwQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vWSTQxHEuITe6usA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62099">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nVjWJEFdrogCwBh6.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RNOmaPN3J4YIa6vZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, pinch white portion of circuit as shown in picture and twist upwards. This should loosen the circuit itself. Using tweezers, gently remove circuit from white plastic attachment. Flip screen over and remove top most circuit closest to power button using same method.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nVjWJEFdrogCwBh6.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RNOmaPN3J4YIa6vZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62100">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TQGdxcwcJprKPwZZ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vgyCPji5JO6quHaG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DohIiqRctvi1hNsD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be very cautious when using a soldering iron for the next couple steps (they are on average 300 F) Using a soldering iron, remove solder from each circled location in each image to remove corresponding wires</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TQGdxcwcJprKPwZZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vgyCPji5JO6quHaG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DohIiqRctvi1hNsD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62101">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qaKSsnnIuTuwlEUZ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cNflLemmGBJwBBq4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using soldering iron, melt away solder and warm up metal located at top of circuit board as shown in picture Repeat step two to three times until board feels flexible to bend</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qaKSsnnIuTuwlEUZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cNflLemmGBJwBBq4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62102">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hBXCyCAYQEhBCQG1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly  bend circuit board upwards (towards power button) until at 90 degree angle with remaining part of camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hBXCyCAYQEhBCQG1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62103">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4nADRmvcQF1PPaxs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BLec6kCBp6anIZwC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iYO4jhL5AZiOQPTN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove three interior screws as noted in the first picture. Remove screwed attached to orange circuit ribbon as shown in second picture. Remove third screw attached to orange circuit ribbon as shown in third picture.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4nADRmvcQF1PPaxs.standard">
