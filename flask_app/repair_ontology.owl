  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the viewfinder away from the lens assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wdIxgdnkZESPtcFu.standard">
