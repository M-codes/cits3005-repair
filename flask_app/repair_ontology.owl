  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You should be able to see the two small wires connecting the speaker to a small green plug With tweezers, carefully unplug the wires from the plug.  The wire should slide straight out Carefully replace the broken speaker/shutter panel with a new one</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
