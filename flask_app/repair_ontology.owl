  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate the camera to locate the side with the LCD screen. Use a Phillips PH000 to remove the two 6mm screws above the LCD screen. Once the screws are out the back panel, it is ready to be taken off. Grip the backside of the camera and pull it away evenly on every side. The backside must come off straight from the front.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

