  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the metal sheet that is under the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NnMRkSN5kOoLSgjA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_92575">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CckFKSViiBXlogLq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wedge the flat end of the spudger between the camera and the function buttons plate to push the plate out from under the hooks that attach the left side of the plate. The plate will still be attached at the top of the camera. This will allow the bottom of the function button plate to be raised in order to get to where the ribbon cable attaches to the circuit board. Make sure all 3 screws have been removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CckFKSViiBXlogLq.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_92586">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y2AjHAN2gl3YXTkC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raise the bottom of the function button plate with your thumb. Use one side of the tweezers to raise the black retaining flap that holds the orange ribbon cable to the zero insertion force (ZIF) connector. The latch is approximately as long as the width of the electric tape</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y2AjHAN2gl3YXTkC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94209">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rvbNeJdlexHYwFSF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently remove the ribbon cable from the ZIF connector using the tweezers</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rvbNeJdlexHYwFSF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_92588">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IGo54cFAnKYCNwFV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the bottom of the function button plate still raised pull the screen out to the left until the ribbon cable is out from underneath the function button plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IGo54cFAnKYCNwFV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

