  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unplug the two ribbons for the lens. There will be  latch that will need to be slid down. After loosening the latch, the ribbon should be able to be easily pulled out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3cKRqZGYltyHvVoP.standard">
