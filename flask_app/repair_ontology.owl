  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JSLtCtVWhsGQOH1e.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unlatch the battery cover. Slide the cover out and flip it open. Remove the battery. Gently remove the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JSLtCtVWhsGQOH1e.standard">
