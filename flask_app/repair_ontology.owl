</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_157031">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/D5AfiFmPE6DRfPBK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XejAt1gJjTaKyyQy.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qtSOs3fOfWehxFeh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the metal frame removed from around the camera in step 3. Lay the frame button side down or flat and gently pry the button out of place with  the 3.0 flathead bit or a pair of tweezers. This is very brittle plastic so use extreme caution and minimal force. The button is secured to the frame by two small black rods pushed into the white colored portion of the button (see picture).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/D5AfiFmPE6DRfPBK.standard">
