  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the back case cover from the body. First use a plastic opening tool gently pry along the side of the camera. Then slowly and gently lift the cover off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BuUM3pwYUs1cXakj.standard">
