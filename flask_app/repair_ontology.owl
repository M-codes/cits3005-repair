  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YVGOerODsTKJZno1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the size of the battery pack together with the BMS Board. It should easily fit with a bit of space inside the housing. Otherwise you may get problems down the road of this guide.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YVGOerODsTKJZno1.standard">
