</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_163925">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_cotton_swab"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kC5O4YjuJepJmD6W.standard"/>
