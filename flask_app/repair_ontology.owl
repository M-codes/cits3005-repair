  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using metal tweezers, pull out the plastic connector box on the front side. Again use metal tweezers to pull out the connection box on the bottom of the camera. The right side of the case can now be removed by pulling it to the right.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

