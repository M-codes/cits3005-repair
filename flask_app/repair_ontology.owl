  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the LCD screen, four 2.2 mm Phillips  #PH00 screws holding a cover around the hinge will appear. Turn the swivel around to expose the screws and use the PH00 screw driver to remove them.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pxRYRxhGCoArKnLC.standard">
