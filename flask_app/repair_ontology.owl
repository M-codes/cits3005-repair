  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112832">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2kbHIf5nDvtTTmuW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finally, remove the LCD screen by grabbing the clear plastic tab and lifting it carefully.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2kbHIf5nDvtTTmuW.standard">
