<owl:NamedIndividual rdf:about="#Step_53910">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3BS6PI6DIastSStu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dT54RebVIAtpQw1J.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2DLaLyWoNubrGXxy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hold the camera with the bottom edge facing you and find the battery cover on the bottom left of the camera. Use the black latch to unhook the cover by sliding it to the "Open" position. The battery cover should easily open by gently lifting it away from the camera. The battery compartment is now open and the battery can be replaced. ''NOTE: Battery not shown in guide.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3BS6PI6DIastSStu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dT54RebVIAtpQw1J.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2DLaLyWoNubrGXxy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_54299">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ghgyJOpNTX5IEwLl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ysUDoISfCKQmFPZJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2SYOXiy6eQ1QojB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the camera lying with the lens facing down, use the plastic pry tool to gently lift the black tabs on the two ribbon cable attachments. Grasp the black plastic lens assembly with your fingers, and gently pull it out of the camera body from the side of the LCD display.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ghgyJOpNTX5IEwLl.standard">
