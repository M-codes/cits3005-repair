<owl:NamedIndividual rdf:about="#Step_126022">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mlISKwgu3mjryn6P.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1JTPlSUGwCV3jDEd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RudC4ASCMHyGxVEL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are six screws attaching the back housing to the camera. Remove the screws from the body with a PH000 screw head. Two 1.5x2.5mm screws on the right side. Two 1.5x2.5mm screws on the underside. Two 1.5x2.5mm screw on the left side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mlISKwgu3mjryn6P.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

