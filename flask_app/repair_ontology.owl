  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the battery is out, remove the gray button bar from the top of the camera with the smallest opening tool. With the gray bar detached from the camera, turn it  upside down. With the Hex and the J000 bit remove the two 1mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

