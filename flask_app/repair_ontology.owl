<owl:NamedIndividual rdf:about="#Step_114546">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GssjhMq3ooUQHLwh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Position the back of the camera facing you and open the LCD screen to the left.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GssjhMq3ooUQHLwh.standard">
