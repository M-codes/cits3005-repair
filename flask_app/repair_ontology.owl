  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_step rdf:resource="#Step_128677"/>
  <has_step rdf:resource="#Step_128682"/>
  <has_step rdf:resource="#Step_128683"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nest Cam Speaker Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_128677">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OAFODssBuLRXVI3t.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 6 mm screws from the back panel with the  J000 Phillips head screwdriver. We suggest designated areas to keep track of all screws.</has_title>
