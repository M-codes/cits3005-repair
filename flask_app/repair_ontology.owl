  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aHBpfRVhyEIlBoTm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wxIVfLZIfbCG12MW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the screws and the ribbon cables have been removed, lift the mother board from its slot.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

