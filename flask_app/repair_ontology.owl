  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110905">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RLgDilYqRsekdEqm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the image sensor from the camera. You do not have to unplug the black box to remove the USB/SD chip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RLgDilYqRsekdEqm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110001">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vwFOSAehEFanBSvy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grab the edge of the ribbon cable with the tweezers and gently pull until the cable is disconnected from the motherboard. Be careful when removing the ribbon cable. You must pull gently or you can rip the ribbon off  of its contacts.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vwFOSAehEFanBSvy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110005">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fA4GoJZBcNNiH4a3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift the microSD/Micro USB assembly up and out of the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fA4GoJZBcNNiH4a3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110909">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yGZSfahBRbGicECj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingers and gently pull out the sensor from the motherboard by slowly and gradually pulling up on the image sensor box. Do not yank on the image sensor, it can rip out the wiring or damage the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yGZSfahBRbGicECj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110007">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/daic4WFK1x6obnaR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vO5SNtDpefQN1Sdg.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HEA4rDWQJ6LXPIXm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three 4 mm Phillips #000 screws securing the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/daic4WFK1x6obnaR.standard">
