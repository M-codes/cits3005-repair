  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VyFDrh2JdoiYsoew.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the interior left screws, use a plastic opening tool to gently pull the top face plate off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VyFDrh2JdoiYsoew.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_93420">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FO5HQ5uZMM3HTOOm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, you will need to remove the dial panel by removing the 2 (3mm) screws on the back side of the camera. Gently remove the dial panel with your fingers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FO5HQ5uZMM3HTOOm.standard">
  <rdf:type rdf:resource="#Image"/>
