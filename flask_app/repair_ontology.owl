<owl:NamedIndividual rdf:about="#Step_34163">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vh2KLZJ3EdESvWKL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HS1BNacAWpvREpXq.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5HVSbl6YnRjhQPRe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wedge the plastic opening tool between the edge of the screen and the metal bracket, on the opposite side of the battery compartment. Use the spudger to pry up the corner of the screen adjacent to the metal bracket. The best place to wedge the tool is directly above the rectangular space in the bracket. The screen should come out easily. If it doesn't, jiggle it a little bit. If jiggling doesn't work, use the plastic opening tool to create a larger gap between the screen and the bracket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

