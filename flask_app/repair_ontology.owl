  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RWOTu2t2jqyINFpw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TvQVYUCj3YvENw1f.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 1 (3 mm) screw from the flash generator with a Phillips screw driver Gently lift the flash generator off of the camera with the plastic opening tool .</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

