  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XJyI1kBL2tSEmBqq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desolder the small electrical ribbon that connects the control panel to the LCD screen. Now the LCD/control panel is completely removed from the part and ready to be replaced.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XJyI1kBL2tSEmBqq.standard">
