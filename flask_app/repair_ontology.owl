  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the screws are removed, use a spudger to carefully detach the cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Z3iPGa4OEsBYInrX.standard">
