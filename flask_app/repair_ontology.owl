  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull up on the bottom-half of the motherboard, slightly removing it from its position in the housing. With enough force, pull up on the top right of the motherboard, pulling it entirely from its position in the housing. Once again, be sure to keep the motherboard and secondary board connection intact.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

