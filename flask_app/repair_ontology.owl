  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a 1x1xH1.5 torx screwdriver,  remove the 8 screws (5mm headsize / 4mm length) from the corners of both the front and back of the camera (4 screws on each side).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

