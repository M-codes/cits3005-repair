<owl:NamedIndividual rdf:about="#Step_93413">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ExYM1GedPfEcOenn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1OLfQgOGvJeqDcaY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Pomf1b6SY5ChnDdp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Be sure to always remove the battery from the camera before disassembling to avoid permanent damage.''' The camera has a total of 6 (3 mm) external screws that will need to be removed; 2 on the left side, 2 on the bottom, and 2 on the right side. Remove the 2 screws on the left side. Remove the 2 screws on the bottom of the camera. Remove the 2 screws on the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ExYM1GedPfEcOenn.standard">
