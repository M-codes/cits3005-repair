  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera upside down and position it to where the back of the camera is visible.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

