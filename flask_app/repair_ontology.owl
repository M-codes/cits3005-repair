  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift LCD Display using the plastic opening tool to access the screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
