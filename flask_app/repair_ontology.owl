<owl:NamedIndividual rdf:about="#Step_116272">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/U1TcFktGjXspAGcF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a blue pry tool and separate the black back plate from the camera. Once the black plate is separated, carefully pull apart the back plate from the front half of the camera. Make sure all four sides of the back casing are pried from the camera before completely pulling it apart. If not pulled off evenly plastic placement tabs may break.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/U1TcFktGjXspAGcF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_116273">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QrftjIK1gHQFNWjQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FUc3sToWquJNO3GF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the blue pry tool and lift the brown latch on the ZIF connecter that holds the screen tab in place. Once the brown latch on the ZIF connecter is lifted upward, carefully lift the screen and pull away from the camera. The screen and screen tab will detach from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QrftjIK1gHQFNWjQ.standard">
  <rdf:type rdf:resource="#Image"/>
