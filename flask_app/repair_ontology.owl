  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the battery and SD Card from their slots.  Leaving these in could cause the battery to ground and ruin the electronics. Unscrew the six screws on the casing.  Two are on the bottom as pictured; two more are on each side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

