<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uv2qMKP3omcuHjFd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_92411">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LrvCMCN1opiDSxCD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/P6JnMgKneo4WAK36.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BRWgTR2DGidlYIlY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a #000 Philips head screwdriver remove the two screws (4.1mm) on the right side of the camera. Remove two screws (4.1mm) on the bottom of the camera using a #000 head Phillips screwdriver. Remove the single screw (3.2mm) on the front of the camera using a #000 Phillips head.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LrvCMCN1opiDSxCD.standard">
