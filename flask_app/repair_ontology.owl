  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove lens mount from the camera. Be careful not to lose any of the three loose pieces that are under the lens mount.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
