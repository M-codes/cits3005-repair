  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4.5 mm screws that sit inside the battery slot.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6Pwua4XfjtVeatrL.standard">
