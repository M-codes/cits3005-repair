  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When you pull the string off one side, it will easily come off the other side. Just slide the spring off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

