  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the battery door open and ''''slightly'''' open the side of the case with the iFixit plastic opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

