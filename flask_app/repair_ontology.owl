  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the ribbon cable is removed from  the camera body, the cover can be completely removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

