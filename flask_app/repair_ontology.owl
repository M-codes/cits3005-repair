</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_163090">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/W3Zr2hdBrJ5vlQhY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DEinWESufBSYXLTN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MT5roF3lIUgWN352.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All screws in this camera are removed using the Phillip Screwdriver #000 bit. Also, all dimensions included refer to screw ''lengths''. Locate and remove the six 4mm screws on the sides of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/W3Zr2hdBrJ5vlQhY.standard">
