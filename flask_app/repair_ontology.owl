  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85801">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JQ1sNpF2MBLpQCRA.standard"/>
