  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin with unscrewing the seven outer screws on the camera. There is one on each corner and then three at the bottom.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

