  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two screws from the right hand side Remove the two screws from the left hand side Remove the three screws from the bottom. All the screws on this camera are the same size. No need to mark them by position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
