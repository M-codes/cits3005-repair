<owl:NamedIndividual rdf:about="#Step_37326">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HZqGRoYYJRygcIKa.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4aOvTApJZYBAPOWO.standard"/>
