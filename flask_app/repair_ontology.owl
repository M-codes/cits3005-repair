</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/s5pH14ehvJEuVRKf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_36279">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HW4dBDByiSHHDdJh.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TPkFGVMZVUlsjVHS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This particular camera has some Kapton tape holding the cable to the logic board. Gently remove it from the board only. Open the locking tab on the PCB connector and remove the cable. This will separate the LCD from the board. This is what the logic board looks like without the frame and the LCD.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

