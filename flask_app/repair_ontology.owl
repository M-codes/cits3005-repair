<owl:NamedIndividual rdf:about="#Step_96829">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rahyACKDqMEjLoOk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the four 4.0 mm Phillips #00 screws with a  on the base of the camera below the the scheme that separates the front and back panels. Unscrew the 5.0 mm Phillips #00 screw on the bottom right of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

