  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ytvKB12TkaxIDPTY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to pull copper connector from the control board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ytvKB12TkaxIDPTY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94637">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Xaj6fbXs6BdCNMv3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the plastic opening tool to pry the control board up, thus allowing the flash bulb assembly to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Xaj6fbXs6BdCNMv3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94639">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ykSWOZLTtBGvypHD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Beginning with the battery on the side, gently pull upwards to remove the entire flash bulb assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ykSWOZLTtBGvypHD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

