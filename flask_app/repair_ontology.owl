  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mONT36jxWQK25dYa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the new screen and slide the tab in to the ZIF connector that the previous screen was plugged in to. Close the brown latch on the ZIF connector and fit the screen in the original slot. Return the dial flap to its original position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

