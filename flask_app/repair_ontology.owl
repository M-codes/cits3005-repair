</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_110847">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IgPjhoxsIU3cSbZP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the orange cable at the bottom of the camera by gently pinching with your fingers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

