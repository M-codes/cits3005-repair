  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once you have detached the back cover, use a pair of tweezers to lightly pull on strap found connecting the back cover to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
