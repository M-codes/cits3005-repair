  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bDsKePpWVAxGwTKw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ylBhU4DdEDS1sLlf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the lens face up to locate the bottom cover. Remove the two 7mm screws using a J0 screwdriver. Remove the six 4.3 mm screws using a J0 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/bDsKePpWVAxGwTKw.standard">
