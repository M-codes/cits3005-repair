  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the last two wired connections to the motherboard by severing the indicated connections. Lift up the secondary motherboard as indicated using the metal spudger. All connections should be severed from the motherboard and a new motherboard may be inserted. It is advised to reapply adhesive to wired connections during reassembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

