<owl:NamedIndividual rdf:about="#Step_154658">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_solder"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3crogbnR5Kffwo5D.standard"/>
