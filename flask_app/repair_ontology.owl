  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_164455">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ywuWDNFRftdGEFg4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eeYPFOueUATumqZS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Face the front side of the camera towards you. To locate the left side turn the left side of the camera towards you. Take out the four screws, sized 4.75 mm, with the Phillips #000 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ywuWDNFRftdGEFg4.standard">
