  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 1 screw inside the battery chamber.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eVBEYGjFf3pKHhAe.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_165352">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ATDEdkRvbbF3lu6p.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the wrist strap away from the front of the camera to remove it. Then carefully pull the back casing apart from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ATDEdkRvbbF3lu6p.standard">
