  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the battery door is open. Using a pair of tweezers, remove the metal rod at the junction of the battery door and the inner camera case. This rod serves as the hinge for the door. Make sure not to lose the battery door spring which may fall when the rod is removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

