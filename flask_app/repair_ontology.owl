  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the two cables from the camera base motherboard by''' gently but firmly''' pulling'' directly away'' from their respective ports. Disconnect the two PoE (Power over Ethernet) cables from the motherboard by '''gently but firmly''' pulling the connected cables directly away from their respective ports.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

