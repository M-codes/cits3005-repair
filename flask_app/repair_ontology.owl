  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The screen is no longer screwed to the body. To pop it off, push down and pull away. It will swing away, because it is still plugged into the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qNcD3pGdIFbv3S3Q.standard">
