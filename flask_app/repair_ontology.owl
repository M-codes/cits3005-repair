<owl:NamedIndividual rdf:about="#Step_34234">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EqOxGSDrkZKj1VRR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TNSOidZtgfwg3wTM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the cover on the bottom by sliding it in the direction of the arrow.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EqOxGSDrkZKj1VRR.standard">
