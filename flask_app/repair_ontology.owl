  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are two screws to the right of the battery slot. Take the #00 Phillips-head screwdriver and remove the two screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QGPq12dWlKNIfUGw.standard">
