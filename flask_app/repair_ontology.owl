  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, remove the 2 (3 mm) interior screws on the left side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DXZQiuPDrL5cRN1r.standard">
