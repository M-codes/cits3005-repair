  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ir5lq4GFlKTdYbK6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the the three Phillips screws (3mm headsize x 2mm length) from the circuit board. After you remove the screws, you can then remove the green circuit board by lifting it up out of the device case. You may want to use the plastic opening tool to get start lifting the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ir5lq4GFlKTdYbK6.standard">
