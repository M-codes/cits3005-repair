  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 6.0mm Phillips #00 screws that secure the back cover to the inner frame. Lift the rear lid upwards using your fingers and separate it from the internal components and motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

