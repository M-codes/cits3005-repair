  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the plastic opening tool to flip the two white clips holding the ribbon cables. Use tweezers to pull the cables from clamps. Use the PH00 screwdriver to remove the   three 2 mm screws around the first lens area.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

