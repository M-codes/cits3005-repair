<owl:NamedIndividual rdf:about="#Step_177960">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cFIj1lMVxOUYfErU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/c2TPWRdAKdv5Jb5g.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/N1uOXsdPZuQ5jHEu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At the bottom of the SmartCam there is a tab that you can stick a spudger r in. Once the spudger is in, gently pry it open. Work your way around the SmartCam with the spudger  loosing 8 clips. Buttons may fall out, but can be reinserted easily.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cFIj1lMVxOUYfErU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/c2TPWRdAKdv5Jb5g.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/N1uOXsdPZuQ5jHEu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177962">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eHtXFrFbKdWbQ3kQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fACjkl2CC4YGEleq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently remover the cover. Beware of the wires connected to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eHtXFrFbKdWbQ3kQ.standard">
