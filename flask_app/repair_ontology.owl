  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slightly pull on each side of the camera. It should loosen up and come apart. If it does not pull apart right away, use a little more force. Do not give up!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

