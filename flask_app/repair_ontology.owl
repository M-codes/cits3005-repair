  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155326">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JZHvxeRwICYhBcGs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/E41MMasyVTeabus5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully lift the LCD screen to reveal two orange ribbons connecting the screen to the camera. Use tweezers to carefully lift the blue retaining flap  holding down the orange ribbon cable. (Flap can be seen open in the second photo) Slowly wiggle the ribbon cable back and forth while pulling away from the zero insertion force (ZIF) connector to disconnect the cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JZHvxeRwICYhBcGs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

