<owl:NamedIndividual rdf:about="#Step_19227">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GvsrvoFmOmDEGBqw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BJZgcWwQx1TD1ZEe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a set of tweezers to remove the speaker located at the top of the camera on the flash unit. Next use the tweezers to carefully remove the speaker cable off its respective holders.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GvsrvoFmOmDEGBqw.standard">
  <rdf:type rdf:resource="#Image"/>
