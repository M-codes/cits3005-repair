  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the four 3.25 mm screws holding the metal lens panel in place, and remove them. You should then be able to lift and remove the metal paneling.  This will now expose the pin holding the battery latch in place as indicated.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

