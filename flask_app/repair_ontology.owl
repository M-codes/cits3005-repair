</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_21771">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XD6KwlEcAFVNpAWM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6QXDpU2aVImGTIbN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not attempt this next step unless you have soldering experience and feel comfortable desoldering. Otherwise you may damage the camera. Gently desolder the two ribbon cables attached to the motherboard. Remove the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

