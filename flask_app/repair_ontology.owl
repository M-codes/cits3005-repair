  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the memory card slot in the bottom right corner of the camera. Using a plastic opening  tool, gently pry up on the edges of the bottom right corner of the control board. Gently raise the lower right corner of the circuit board by prying upwards with an opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

