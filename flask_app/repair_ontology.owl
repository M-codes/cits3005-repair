  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97311">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ikvHgfO6LmCVeQYc.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VAIgVQNekUqIfp5Z.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Where the recording button is located, unscrew one 5 millimeter screw left of the "start, stop, record" button. This will remove the entire right side panel where the handle is located. Unscrew one 5 millimeter screw located by the lens. This unattaches the leather strap assembly/handle completely from the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ikvHgfO6LmCVeQYc.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

