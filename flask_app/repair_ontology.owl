<owl:NamedIndividual rdf:about="#Step_195905">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eMeGBCvI4xVbYPdJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eTGcnBQJZEEOxgnN.standard"/>
