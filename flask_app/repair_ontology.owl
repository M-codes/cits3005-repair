  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Within the LCD unit there are three layers to remove. While holding the ribbons back with your thumb remove the board and set in a safe place. Keeping the ribbons to the side remove the LCD filter. This exposes the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

