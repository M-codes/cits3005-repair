  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At this point, the only thing holding on is the dust-cover is hooked onto the front panel Slide down to remove without damaging the cover.  (see photo with cover removed) You can see how the cover, and side piece fit together in the second image.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
