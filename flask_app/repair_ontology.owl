  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leave the camera facing backward so that the lens is facing up. Remove the square connector at the top of the motherboard by grabbing the connector with two fingers and pulling up until it detaches. Refer to the picture for correct removal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
