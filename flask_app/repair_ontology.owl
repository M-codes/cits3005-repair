  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, remove the three .12 inch screws that hold the lens assembly to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EkEKotx3EsrCeCRu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

