  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move the lever to disconnect the ribbon cable from the circuit board. Avoid ripping the fragile micro ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

