  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adding another layer of isolation as we have crossing hilium connectors here.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/WZEGNNwyM2oXcOCM.standard">
