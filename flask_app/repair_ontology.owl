  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yaUkUWslU4mQQKHC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the bracket in the lower right hand corner. In order to do so, you must remove two different screws. Using the #000 Phillips screwdriver, remove the 2.4 mm screw on the bottom. Using the #000 Phillips screwdriver, remove the 6.0 mm screw on the top and lift off the bracket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/G1LZhoU4HBZQnMgK.standard">
