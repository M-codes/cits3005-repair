<owl:NamedIndividual rdf:about="#Step_155533">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZiebQ6rtgHlQRxjK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Torx driver, unscrew the two 5mm Phillipd screws on the motherboard</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZiebQ6rtgHlQRxjK.standard">
