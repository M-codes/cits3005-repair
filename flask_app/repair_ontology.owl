  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You can find the battery compartment on the side of the camera. Search for the arrow and the abreviation "BATT" Stick your finger nail (or a blue opening tool if you wish) in the notch and flip open the door to expose the battery compartment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

