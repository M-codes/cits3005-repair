  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iEY2xEtMeYpx2dSt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black M1.4 X 3.5 Phillips head screw in upper right corner of device. If you have already removed the lens block, or aluminum back plate, you can skim over the next couple of steps until you are at a familiar place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/iEY2xEtMeYpx2dSt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96934">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wOYZqqDpWlONLQZF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reorient the camera so you are looking at the "top view". Remove the black M1.4 X 3.5 Phillips head screw just below the ON/OFF button circled in red.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wOYZqqDpWlONLQZF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97004">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IUbxstZmWyVfoM3F.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orient the device so you are looking at the "bottom view". Remove the black M1.4 X 3.5 Phillips head screw located next to the tripod attachment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IUbxstZmWyVfoM3F.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96936">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5LMgkSQBLESvxmHV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the aluminium back plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5LMgkSQBLESvxmHV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96942">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/n4SNDXRaJnTGZfZd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The connections (red squares) have small black retaining clips. Using a plastic opening tool, lift upward towards the cable to unlock. After detaching retaining clips, gently lift to disconnect the ribbon cables. Don't rip the cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/n4SNDXRaJnTGZfZd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96947">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/k5NpDFqldwBkCgih.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the orange M1.4 X 3.5 Phillips head screw located near the bottom of the camera. This is the only screw that is orange.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/k5NpDFqldwBkCgih.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96953">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T1qEC1SkpAldfWBs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift up the motherboard. In this picture the lens block is removed, but it is not a necessity. Disconnect the ribbon cable on the bottom by gently pulling.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/T1qEC1SkpAldfWBs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

