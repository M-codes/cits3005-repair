  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the Phillips #00 screwdriver, unscrew the outside screws from the frame of the camera. There are five screws on the bottom of the camera and two on the side. If the screws are stripped, visit the [guide|13213|Removing a Stripped Screw Guide].</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

