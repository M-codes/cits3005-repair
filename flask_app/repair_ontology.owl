</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_126909">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UNbGlvBdXZBSnlnO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GgDSfq1SWU3FC22d.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JskaRK3sv2rGGGUR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the three screws removed, take note of the two ribbon cables connecting the lens assembly to the main motherboard. Use the tweezers to remove the two green strips of tape protecting the connectors. Use the plastic opening tool to release the black clips locking in the ribbon cables, then use the tweezers to gently pull the ribbon cables away from the main motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UNbGlvBdXZBSnlnO.standard">
