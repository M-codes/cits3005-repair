  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85506">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LLQRFPCGl15YqyBG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EWCaWDRLRwdGXSQX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5NjllaXZtp1yXENR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera with the lens facing up. Turn the LCD screen so you can see the 5 MM Phillips #1 screw on the inside; remove the screw. Spin the LCD screen around to get the 5 MM Phillips #1 screw in the same place on the other side. Use the plastic opening tool to gently separate the back of the screen from the unit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LLQRFPCGl15YqyBG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

