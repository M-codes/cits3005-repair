<owl:NamedIndividual rdf:about="#Step_64262">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bFLnQ11biTVcG2Cp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BGvU2aDTGUyQcvrb.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HJkwTNYhkJmHROLf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the spudger tool to unhook the neck strap anchor from the side of the camera with the navigation buttons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

