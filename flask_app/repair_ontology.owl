<owl:NamedIndividual rdf:about="#Step_112824">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/laZj3BYRO4WjJLar.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When holding the camera, look to the bottom of the camera so the serial number tag reads up right. You will be removing the three top  Phillips #PH00 screws. Using the PH00 screw driver, remove the top three 3.5 mm Phillips #PH00 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/laZj3BYRO4WjJLar.standard">
