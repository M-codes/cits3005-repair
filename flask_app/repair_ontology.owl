  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two remaining case screws on the front of the camera 2x3.63mm.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JcEkYjJPYw3VZ5G3.standard">
