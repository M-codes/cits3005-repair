  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IDDQPs33IaAQdYrT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Then remove the last two screws on the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IDDQPs33IaAQdYrT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85604">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lnkRSXeRqZ1UTEZw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the front cover, use a plastic opening tool gently pry the top cover. Then gently lift the cover off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lnkRSXeRqZ1UTEZw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85607">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NcJBHuTVrrIplvBh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The front cover should now be detached from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NcJBHuTVrrIplvBh.standard">
