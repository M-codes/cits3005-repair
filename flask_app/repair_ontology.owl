  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull Touchscreen out and rotate 90 degrees. Remove the four 3 mm Phillips #000 head screws that are now exposed at the hinge. Use a spudger and pry apart the two plastic columns surrounding the screen hinge. The screen will not be removed at this step. Rotate the screen forward 90 degrees and push it back into its housing against the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

