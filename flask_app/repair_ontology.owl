  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squeeze the camera by placing a thumb on the tab marked CE. Pull the back half of the camera firmly away from the camera body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

