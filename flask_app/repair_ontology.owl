  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 6.4mm screws above the lens aperture using a phillips #00 screw driver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mnrwfhOGvFjTNDZU.standard">
