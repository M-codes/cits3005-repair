  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 2.5mm flathead screwdriver, remove both 2.8mm flathead screws that hold the wind and rewind dials in place. Then, remove the washer located underneath each dial.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
