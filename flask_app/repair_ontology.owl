  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HncnjZghm3CgeNe6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three 3mm screws holding the photoreceptor in place. Carefully lift the photoreceptor, disconnecting the ribbon cable and remove the photoreceptor from the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/j5mqifReiEyCPysg.standard">
