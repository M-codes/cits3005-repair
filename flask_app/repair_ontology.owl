  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IOklr5TSCGXw5kWr.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HU4R2ZvpOrMZwBfG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting with the battery compartment gently begin to separate the back case front the camera. Using a plastic opening tool, separate the bottom of the back case from the camera. Then proceed by separating the sides. Gently lift the back case away from the camera an slide it down to completely remove the back case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

