  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove each data ribbon cable from the motherboard by applying pressure down towards the motherboard and gently sliding your thumb upwards on the slot where the cable meets the motherboard. This will raise a very small clip that locks the cable in place. The back panel is now free from the rest of the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

