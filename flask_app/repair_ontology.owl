  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The battery compartment can be found on the backside of the camera. Pinpoint this compartment and focus on the right edge of the compartment gate to find the opening latch.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KAFv4ZvkAtcFVohR.standard">
