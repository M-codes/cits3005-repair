  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When cutting the wires,  leave approximately 25-30mm of the wire on the speaker. Strip the ends of the newly cut wires. Expose only 2 mm of bare wire.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

