  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert spudger in between the LCD and casing, and push lightly. LCD should pop up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
