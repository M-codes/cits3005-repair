  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You will be able to see the ribbon cables coming out from the back panel, disconnect the cables. Be careful not to pull too hard on the ribbon cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

