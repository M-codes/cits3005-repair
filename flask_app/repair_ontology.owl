  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift up the white ribbon clip and remove the black ribbon by gently pulling it away from the white clip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZTmU2RDu6IA5q5eE.standard">
