<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fgA4kcSECF4lAOW2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129796">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XTpUQV6tsRUWybox.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mCNV3XLeqyixyYBw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oL5T1bEChDWNeXRw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4mm Phillips #00 screws. Pull the LCD display back cover to reveal the motherboard covering the screen. Remove one more 4mm Phillips #00 screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XTpUQV6tsRUWybox.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mCNV3XLeqyixyYBw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oL5T1bEChDWNeXRw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129797">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BKfIOLjWmSOcKEH5.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KsFGEHyC1dJvRHgV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DyQhJljx4Fxud6lf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the screen protector away from the LCD display. Use a plastic opening tool to lift the ribbon connector tab. The LCD display can now be replaced!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BKfIOLjWmSOcKEH5.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KsFGEHyC1dJvRHgV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

