  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the circuit board, you must begin by removing the three screw caps and the 15mm JIS 0 screws associated with them located on the plastic containment shell that the camera is  in.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

