<owl:NamedIndividual rdf:about="#Step_126907">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JXgnY3uqWoDaHW4Z.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4yFubElYuATgTMBU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sD52EHuQZUJriAXF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the screen and battery to access to the inside of the camera, take note of the two main assemblies inside-- the lens apparatus and the main motherboard. The lens assembly is on the left hand side. There are three small silver screws (4mm PH00) to remove.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JXgnY3uqWoDaHW4Z.standard">
