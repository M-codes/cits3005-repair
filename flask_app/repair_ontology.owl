  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The back panel can now fall off easily by turning the device upside down. Be sure to catch it so the data ribbons do not tear or tug.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

