  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera so the bottom is facing up with the front facing away. Unscrew the 6.2mm Phillips screw on the top right. The front cover is now unscrewed and should be lifted up evenly and removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

