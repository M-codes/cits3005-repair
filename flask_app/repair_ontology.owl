  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the silver strip from left side. Open the battery cover and remove the metal strip with fingers by sliding it to the left.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
