</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35539">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MdPTZLCSpkNvOeMF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tTPU2eEOyPsqYIRo.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The flash and lens assembly should now be separate from the motherboard. Locate the capacitor. It is the component that looks similar in size and shape to a AAA battery. With the lens upright and facing you, gently lift the capacitor up and to the left to remove main flash assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MdPTZLCSpkNvOeMF.standard">
  <rdf:type rdf:resource="#Image"/>
