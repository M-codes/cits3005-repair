  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four silver 4mm Phillips #000 screws connecting the LCD screen to the back of the camera. Be sure to lift the ribbon cable to remove the remaining hidden black 4mm Phillips #000 screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
