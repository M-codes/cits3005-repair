  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a plastic opening tool to disconnect the internal hinges that snaps the camera into place. Using a plastic opening tool is important since a metal one will scratch or damage the thin plastic hinges that hold the camera together.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

