  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As in step 5, push up the brown locking mechanism of the remaining cable. Unplug the picture cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ywYAGcumSR6L5y11.standard">
