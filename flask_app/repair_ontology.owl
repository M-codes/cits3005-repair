  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a spudger, lift the latch on the connector. Remove the ribbon cord from its connector. Remove the LCD from the rest of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

