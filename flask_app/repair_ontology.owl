<owl:NamedIndividual rdf:about="#Step_167859">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/W4msEjMYMxATxiaG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ToweMFkN2cyPDwBq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pinch the latch in towards the battery compartment gate. This will release the gate and allow it to open. Completely open the gate and remove from camera. Take out the battery and replace the gate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

