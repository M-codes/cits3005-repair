<owl:NamedIndividual rdf:about="#Step_96932">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jCFCYbs6ZOEUhilU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZeICHfJWCtjAFI4W.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the four (three black, one silver) 4 mm screws on the bottom of the camcorder.</has_title>
