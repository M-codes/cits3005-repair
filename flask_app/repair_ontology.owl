</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_9998">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tPw2TQ4RaiZHTeYS.standard"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the four Phillips screws using a #0 Phillips screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tPw2TQ4RaiZHTeYS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10001">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MG3VTAPD1EEhid2J.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LcpMyOmijpxeFyxJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift the the logic board. Be careful not to pull too hard and damage the white ribbon cable. Place the Spudger so that it is between the logic board, the white ribbon cable, and the rest of the camera. Remove the white ribbon cable by pulling the Spudger away from the camera, keeping it parallel to the logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MG3VTAPD1EEhid2J.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LcpMyOmijpxeFyxJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10013">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FGFNTJZqpljeXKCt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lay the logic board back down so that it is resting on the body of the camera. Pull the two plugs (white and green) out to the right from the logic board using the tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FGFNTJZqpljeXKCt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10016">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_solder"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MZTQUHq2HyNkBUYU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sfUvN3QHVIsuhRSA.standard"/>
  <has_tool rdf:resource="#Tool_desoldering_braid"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We're now ready to begin the desoldering process. You'll need a soldering iron, solder, and desoldering wick. You should be able to find these items at a Radio Shack if you don't already have them. Please do not perform this step if you are not comfortable or have previous experience with soldering.  Doing so, could cause severe damage to your camera. Desolder the two soldered ribbon cables attached to the logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MZTQUHq2HyNkBUYU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

