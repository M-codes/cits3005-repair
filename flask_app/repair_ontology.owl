</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94543">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ahb5FMBf5ZQENhZO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BUKGvIxHuQmYf2tR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YgcTksajqjmGNEwF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the screws have been removed, slowly and carefully take the top half of the housing off the camera. Flip the camera over, and carefully lift the screen while still making sure it's fully attached to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ahb5FMBf5ZQENhZO.standard">
