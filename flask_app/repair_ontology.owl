<owl:NamedIndividual rdf:about="#Step_16412">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4jMcKEvJFyZJVdaP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be careful not to pull the cover off completely, it is still attached to the logic board. Gently pull the cover away from the rest of the camera. Do not separate the pieces completely.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

