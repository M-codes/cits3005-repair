</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_36276">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DOGPLaa3sEsa2GAE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iOZujoIaYEEToeYq.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OHLbGKGZDx2YEQOb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two screws on the left side. Remove the two on the right side. Remove the four screws on the bottom. All eight screws are the same, so no need to ensure proper position when reassembling.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DOGPLaa3sEsa2GAE.standard">
