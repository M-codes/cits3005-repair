  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ribbon cable attaches to the metal plate and to the main circuit board, on the front of the camera. Gently release the black latch. Remove the ribbon cable and metal plate assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aqrEJE2mEjENYHUb.standard">
