  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the LCD screen over to the side exposing the connection to the motherboard. Remove the display data cable connecting the LCD screen to the motherboard. Using tweezers, pry up the black retaining flap then gently pull the display data cable free. Be careful when handling any display data cables in the camera as they are prone to tearing. To close for reassembly, slide the display data cable back into the ZIF connector and close the retaining flap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

