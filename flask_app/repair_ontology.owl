<owl:NamedIndividual rdf:about="#Step_127243">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TPTd6XIZYt3vIGEB.standard"/>
