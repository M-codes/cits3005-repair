  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers or a fingernail to peel back the rubber cover on the right handgrip. Remove the 3.2 mm Phillips screw. Remove the 3.8 mm Phillips screw. Remove the 2.8 mm Phillips screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
