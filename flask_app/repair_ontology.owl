  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jjwaO2GVF64ljNBF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the Phillips #1 screwdriver, remove the 5.5mm screws holding the circuit board to the shell. Lift the circuit board from the face of the shell, the back should still be connected by the antenna and the speaker. The LCD Screen is glued to the circuit board by a protective foam layer. Attempts at removing the screen may result in damaged hardware.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

