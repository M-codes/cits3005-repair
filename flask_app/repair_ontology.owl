  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unsnap LCD display screen from its mount by unsnapping it from the display screen using your finger nail. Now the new LCD screen can be installed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
