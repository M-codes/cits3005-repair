  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is hard to get the orientation if all batteries correct on first try. But the tape allows cutting and reorientation if needed. This is only needed to use less of the connector and allow easier wiring without crossings</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

