  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orient the camera with the lens facing up and the flash towards you for the clearest visibility. Using a pair of tweezers, gently move the red and black wires away from the lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

