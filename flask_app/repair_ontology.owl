  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert a plastic opening  tool into the marked position. Push the tool towards the right to release the clip. Using a thumb and forefinger, push the plastic cover up until it is at a 45 degree angle. Pull the cover back and up to release it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

