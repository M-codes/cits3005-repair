  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the 6.4mm screws located on either side of the camera with a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

