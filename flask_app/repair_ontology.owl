<owl:NamedIndividual rdf:about="#Step_161499">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NOOZO6RYDpGXQjPj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mLoqktAWipPKsgWG.standard"/>
