  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the second black metal plate covering with tweezers. Be careful with this plate, its shape makes it delicate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Hcn6tHlOfftWeXAU.standard">
