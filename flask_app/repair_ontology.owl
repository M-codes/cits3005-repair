  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the tweezers, carefully peel back the copper ribbon that was underneath the black screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
