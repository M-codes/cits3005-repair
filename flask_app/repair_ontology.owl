<owl:NamedIndividual rdf:about="#Step_21542">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WiShVWrZrtgZjcfX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For ease of access, orient the casing so the screws are now on the left side. Remove the six 4.3 mm screws holding the back buttons to the back casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/WiShVWrZrtgZjcfX.standard">
