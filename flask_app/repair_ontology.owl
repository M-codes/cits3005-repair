  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the one circuit board screw at the front of the video camera 1x3.6mm.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1UN3ZGggaDf5YBV5.standard">
