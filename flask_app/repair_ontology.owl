  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a metal spudger, open the monitor from the corner. Slowly slide the spudger around the case to prop open the case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mAlsEUSCXAWJeBdy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_147758">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XRK51PW2hGLDJ1Ec.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dy2OANMXww6r6kuN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the circular speaker in one of the corners of the device. To release the speaker, pinch the metal fastener together and lift it off of the speaker.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XRK51PW2hGLDJ1Ec.standard">
