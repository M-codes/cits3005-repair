  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate the camera 180 degrees to face the side panel with the lanyard loop on it. Gently lift the panel vertically until it lifts off Take care to not lose the small rectangular portion on the bottom of the panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cf1iVfseoduiXBGv.standard">
