  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_120699">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gS3jGIDALjt3XqA1.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YhQhD2i3KVGbibXn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GRXSduHptq6tpBgw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove a knob, remove the screws on the white piece underneath the knob you want to remove with a Phillips #000 screwdriver. The left knob is being removed in this step but the process is the same for any of the knobs pictured in this step. Pull the corresponding white piece off. Flip the piece over and pull the corresponding black knob off the top of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gS3jGIDALjt3XqA1.standard">
