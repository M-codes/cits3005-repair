  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2.7 mm screw from the bottom of the camera using a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
