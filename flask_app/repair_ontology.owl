  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a small opening tool carefully release all lock tabs at the top and on the side of the camera from their locked position. Using your hands, carefully separate the front and back panel from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
