<owl:NamedIndividual rdf:about="#Step_85140">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hmHcwPDYaQSLEWrR.standard"/>
