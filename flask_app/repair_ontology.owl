  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift the LCD screen off of the front casing by pulling up a tab on the side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

