  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34903">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LMFLNhVwR1GFgbmk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the cover on the bottom of the camera. Slide the cover towards the back of the camera. Be careful—the battery can slide out on its own.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LMFLNhVwR1GFgbmk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34905">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Kk5O1yAYEEmTKZUh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the exposed battery. If it is difficult to remove, flip over the camera and the battery will slide out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Kk5O1yAYEEmTKZUh.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34906">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SpiMLR6EsiEeEHb3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bvA1d3Ap1XYsQm4P.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eWLdIKofQ5CPEs5P.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the 3mm screws on the bottom and sides of the camera with a JIS size #0  screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SpiMLR6EsiEeEHb3.standard">
