  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tools Required: #00 Phillips-head screwdriver Caution: The six screws removed in this step are tiny and should be placed in a secure location. Using the #00 Phillips-head screwdriver, remove the two screws from the left side (as shown in picture 1). Using the #00 Phillips-head screwdriver, remove the two screws from the right side of the camera (as shown in picture 2). Using the #00 Phillips-head screwdriver, remove the two screws from the bottom of the camera (as shown in picture 3).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

