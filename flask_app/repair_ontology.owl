  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take note of the small free moving flap near the battery port seen in the first of the three photos. Be sure to store the free moving flap in a safe place. Pry the front cover off gently. Use a plastic opening tool if available. Now that you have removed the front cover you can replace it!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

