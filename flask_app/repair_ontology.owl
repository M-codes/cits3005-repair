  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 3.5 mm screws that hold the main circuit board. In the image, we have already removed some of the screws. Do not remove the main circuit board yet.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jbXRwGKv5KHVaLvU.standard">
