  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Release the ribbon cable by lifting the black locking latch with the plastic opening tool. Pry out the ribbon cable by carefully sliding it out of the connection slot using a spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

