  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_139638">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bfZlOOjcmQvdANJd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Separate the wire from CPU by cutting adhesive with metal spudger. It is advised to reapply adhesive to wired connections during reassembly, and to re-attach wires to CPU to prevent disconnection and loose wires inside device. Be careful not to damage the CPU in the process. This is not a wired connection.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

