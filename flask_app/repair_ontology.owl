</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_148517">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Z51SG2RUaeKQCVQn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pXyKyeawFaHUhgDC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the part is separated, move it toward the battery slot. Push the piece towards the camera to separate it from the hinge. Do not pull up otherwise you will break the piece off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

