  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 8, 2 mm screws from each corner of the metal button pad cover. Using tweezers remove the metal cover. The smaller Metal square piece on the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

