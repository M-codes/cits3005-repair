  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Release the ribbon from the button casing connected to the motherboard. Hold the metal casing out of the way and snap the ribbon connector back. Remove the display screen ribbon attached. Replace the screen then repeat all of these steps in reverse order to reassemble.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

