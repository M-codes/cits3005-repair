  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gKIjZXhEOs5HSA6A.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the circuit ribbon connecting the flash to the camera in order to proceed to the next instruction. Carefully pull out the circuit ribbon from the camera which should be the last piece holding the button pad onto the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
