  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 5.6mm screws behind the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

