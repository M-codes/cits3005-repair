<owl:NamedIndividual rdf:about="#Step_85808">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gB3e6xXfYA6ZPWWC.standard"/>
