<owl:NamedIndividual rdf:about="#Step_92437">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/q2TXux3UApLXEjfK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all the tape and clear rubber material from the components. Remove two screws (4.1mm) using a #000 Phillips head screwdriver on the left side of the lcd component. Make sure to set aside the two metal pieces that come off after the screws are removed. Using the tweezers disconnect the plastic ribbon from the connector on the control board by lifting the small black flap on the connector and pulling on the ribbon.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/q2TXux3UApLXEjfK.standard">
