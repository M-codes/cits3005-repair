  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the #000 screwdriver, remove the 2mm silver screw from the top corner of the camera near the shutter button. With the #000 screwdriver, remove the second 2mm silver screw. Do the same thing on the left side using #000 for the three 2mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
