  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the metal frame away from the lens. After you remove the metal frame, the lens will be by itself.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39</has_order>
</owl:NamedIndividual>

