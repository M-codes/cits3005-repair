  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peel back the rubber battery cover from the inner left side of the frame. While firmly holding the battery cover, pull the bottom of the strap mount cover up and off of the frame</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

