  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the lead that was under the grommet out from the frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/21PRDvHPvUDJZqsu.standard">
