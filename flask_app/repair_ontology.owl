  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dOwASxscgAWlvGoR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Undo the catch on the top left side of the camera. Undo the catch on the bottom left side of the camera. Undo the catch on the battery compartment of the camera. The rear case is snug due to the catches. While using the opening tool, gently pull on the back case so it clears the catches. Do not use too much force, or it may break the plastic of the case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

