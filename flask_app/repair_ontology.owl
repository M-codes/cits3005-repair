  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/duCXLeSnwi6LrssP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to remove the second ribbon wire This is best done by grasping at the base and pulling straight away from the circuit board</has_title>
