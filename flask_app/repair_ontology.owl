<owl:NamedIndividual rdf:about="#Step_144181">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lbKjqZLdauyYhWo3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tweezers to grasp the housing firmly and pull it away from the three ribbon cables. Pull the battery housing until the half circle grooves on the back housing match up with the grooves on the battery housing. After the screws have been removed from the inside, the battery housing is only held down by adhesive.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lbKjqZLdauyYhWo3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_144182">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LMAkWrQsQSN2vgoU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mKZgDjpBcnnNwgBD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the half circle grooves match up. Otherwise the battery housing will not be able to be pulled out. With your fingers, push from the inside of the battery compartment and pull the battery housing out from the back housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

