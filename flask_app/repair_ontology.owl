  <has_tool rdf:resource="#Tool_solder"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the grip from the D70. Do not touch any of the exposed solder points under the grip, as the capacitor is attached in this area. The attachment points for the blue and pink leads of the capacitor are circled in yellow in the second picture.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IDeRmY3Q6fQ3MyCA.standard">
