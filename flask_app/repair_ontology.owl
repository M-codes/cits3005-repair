  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the flat end of the plastic spudger to rotate the black plastic locking tab towards the ribbon cable. Insert the pointed end of the plastic spudger into a small hole on the side of the ribbon cable and pull the ribbon cable out of its housing. Use the flat end of the plastic spudger to pry the ribbon cable connector from the motherboard. Both ribbon cables should be removed after this step.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

