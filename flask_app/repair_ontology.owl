<owl:NamedIndividual rdf:about="#Step_10341">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gP1L62ZOQKCETigP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the battery out of the D70. It may be necessary to wiggle the battery while pulling to free it from its pocket in the case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gP1L62ZOQKCETigP.standard">
