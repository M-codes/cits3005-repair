  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate where the LCD screen ribbon is attached to the logic board. With the iFixit plastic opening tool, flip up the black tab that connects the LCD screen ribbon to the logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

