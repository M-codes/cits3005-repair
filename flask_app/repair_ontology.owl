<owl:NamedIndividual rdf:about="#Step_10340">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nGyLXbYAyfAxYqVM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your finger tip to pull the battery release tab toward the center of the D70. Open the battery door and rotate it away from the bottom cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nGyLXbYAyfAxYqVM.standard">
