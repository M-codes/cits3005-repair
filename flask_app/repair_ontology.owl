  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the square, clear, rubber protector from the front of the logic board.  This is not necessary to remove, but can easily fall off and get lost during later steps.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
