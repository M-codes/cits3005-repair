<owl:NamedIndividual rdf:about="#Step_156067">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m1e6AQKT2wlCs2NQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jr4Cexy3hbDJDvCX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/axuRtHVPgBoOZG5f.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Do not use a magnetic screwdriver or drill bits on the camera's motherboard.''' This can damage the camera's motherboard. Use a PH000 screwdriver to unscrew the four 4mm screws that hold the motherboard to the motherboard housing. ''These will be the raised screws with safety washers.'' Use a PH000 screwdriver to unscrew the two 3mm screws that hold the motherboard to the camera. ''These are smaller screws that have no washers and are not raised.'' Pull the motherboard mounting away from the motherboard after unscrewing the motherboard from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/m1e6AQKT2wlCs2NQ.standard">
