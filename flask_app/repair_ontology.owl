<owl:NamedIndividual rdf:about="#Step_35304">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KStpMiwfVWQGiau3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press in the "realease" tab to rotate the lens and screen 90 degrees. Remove the two screws(from left to right; 5.23mm Philips, 2.1mm Philips) indicated. Flip the camera over 180 degrees and remove the same screws that are on the other side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KStpMiwfVWQGiau3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35305">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ghF6aNCpJGF1uIgp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the bottom of the lens casing by pulling downwards away from the lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ghF6aNCpJGF1uIgp.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35306">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OYZG3R2XORVEm1VR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the other side of the lens casing by pulling it away from the lens, and make sure to keep attached to the wire it is connected to.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OYZG3R2XORVEm1VR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35308">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pRQDiIbv2FZsCKYd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Making sure not to break anything; grab the lens unit with a forefinger and a thumb and gently pull outwards away from the camera. The lens will 'pop' out of the small metal frame that is holding it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pRQDiIbv2FZsCKYd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35309">
