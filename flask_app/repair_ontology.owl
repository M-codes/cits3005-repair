<owl:NamedIndividual rdf:about="#Step_95818">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LgPq2pmFvG1gDFPb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your screwdriver, remove the three 4mm PH00 screws that hold down the metal plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

