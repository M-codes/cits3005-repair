  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, push the lens from the front of the camera to loosen it. Lift the lens unit from the other side so it is free from the case. The lens unit is still connected by a ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
