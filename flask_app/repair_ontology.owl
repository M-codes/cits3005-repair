  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/D4aOEet1mD2vIdAU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To install a new lens, simply follow the previous directions in a reverse order.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

