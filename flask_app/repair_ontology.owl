  <issubProcedure rdf:resource="#Procedure_51592"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Panasonic Lumx DMC-ZS19 Lens Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112352">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oEnECQufMGnkRwya.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BaJlVOqyEXoAfFIJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the screen has been removed, the main motherboard is directly underneath it. There is a bronze, metal separation piece that separates the main motherboard from the one connected to the lens. This metal piece is held in with 3 screws. Remove these 3 screws and the metal piece will be free.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oEnECQufMGnkRwya.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BaJlVOqyEXoAfFIJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112354">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lAVornMGGlltYCYE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the bronze metal plate is removed, the main motherboard will be exposed. There is a plastic riser (it looks like a lowercase "b" on the right side of the camera) that separates the metal plate from the motherboard. Remove this plastic riser.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lAVornMGGlltYCYE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112634">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PsebJmD5WlYZR4HJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aLbhnREWQJ6StdRW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LvvkT2aUGgAvkdGZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the plastic riser is removed, it is time to remove the lens. To do this, simply follow the data strips (2) that connect the lens to the main motherboard and unclip them by turning the black bar into a position that is perpendicular to the motherboard. Once these clips are open, the data strips and the lens should simply slide out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PsebJmD5WlYZR4HJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aLbhnREWQJ6StdRW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LvvkT2aUGgAvkdGZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

