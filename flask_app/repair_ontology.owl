<owl:NamedIndividual rdf:about="#Step_120729">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IFMZyIgMEJvUOSVI.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use caution around the black felt covered circle. This is the speaker and can easily be damaged. Pick up the half of the camera that contains the lens. Remove top 4 mm screw from the strap holder using a Phillips #00 screwdriver. Remove the middle 3.8 mm screw next to the left speaker using a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IFMZyIgMEJvUOSVI.standard">
