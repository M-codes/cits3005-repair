  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the plastic spudger to remove the ribbon cable from the motherboard by placing the spudger under the ribbon cable connector and pulling up. Remove the 2.8mm screw from the motherboard. Do not try to remove the motherboard from the camera yet. Carefully rotate the motherboard upward. Use the plastic spudger to remove the ribbon cable  from the bottom of the motherboard by placing the spudger under the ribbon cable connector and pulling up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MwgGZodkgeBSQ4Va.standard">
