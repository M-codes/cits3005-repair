  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull these two cords straight back to disconnect them from the respective housings. Caution: The housing do not need to be moved or adjusted in anyway. Do not pull the cords at an angle, it can destroy the cords and the housing. Pull Straight Back!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jK4RwJr2KdRNglxp.standard">
