<owl:NamedIndividual rdf:about="#Step_85505">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZoPUBpXfvUlb5rPm.standard"/>
