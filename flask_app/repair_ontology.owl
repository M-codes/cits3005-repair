  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift LCD screen carefully from the metal casing Be cautious when lifting screen as it is still connected to the logic board by two ribbons Lift the two tabs for both ribbons with a plastic case opener like in the previous step Pull out ribbons gently from the logic board with tweezers to disconnect screen</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

