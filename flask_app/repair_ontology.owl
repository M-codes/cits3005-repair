  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the digital A/V DC terminal cover. Remove the three 4 mm screws. Detach the digital A/V DC terminal. When you reassemble the camera, leave the topmost screw out until ++after++ you put the top casing back.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

