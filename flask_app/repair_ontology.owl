  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97061">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jhlydd5giALxGjKV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HHEahlPgXAUXKWHl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ffkhacj2mH1RMHLS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the curved tip tweezers to carefully remove the green circuit board out from under the two clips holding it in place. Then you can remove it completely with your fingers. Now you can separate the LCD screen panel from the rest of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jhlydd5giALxGjKV.standard">
