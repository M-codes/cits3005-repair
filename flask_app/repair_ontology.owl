  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the small plastic pry tool lift the back of the camera off carefully. Open the device slowly and be aware of a few flex cables that connect the mother board to the screen. These will have to be carefully disconnected before the top part is removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

