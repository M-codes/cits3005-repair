  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/L3qIPpuasKPwqwZE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the tweezers, pull out the rubber grommet. There is nothing holding the grommet in other than friction. The grommet is small, don't lose it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

