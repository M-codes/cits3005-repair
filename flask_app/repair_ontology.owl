<owl:NamedIndividual rdf:about="#Step_196217">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/41KOYZOEER2qPaoT.standard"/>
