  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the tweezers, pull the indicator bulb out , freeing it from its position on the housing. Thread the indicator bulb under and through the secondary boards position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

