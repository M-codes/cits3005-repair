</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12915">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZsWg1SaPdB5fDWAD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the flash bulb from the camera housing by gently pulling on the wires with a pair of tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZsWg1SaPdB5fDWAD.standard">
  <rdf:type rdf:resource="#Image"/>
