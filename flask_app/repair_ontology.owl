  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DOT1SJ1bWHFwjw6J.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

