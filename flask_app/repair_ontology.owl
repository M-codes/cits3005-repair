  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting at the flash, carefully pull the front cover away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

