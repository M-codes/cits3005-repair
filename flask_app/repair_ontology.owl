<owl:NamedIndividual rdf:about="#Step_33753">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/u2Pp6EmmlAL2mJAt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Goyo4sl4wVJaUJn5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the motherboard assembly over to the side with the LCD and the camera lens. Gently wedge a plastic opening tool underneath the foam padding on top of the LCD ribbon cable. Pry the foam padding up until the LCD ribbon cable can be lifted off the surface of the motherboard. Do not try to remove the LCD yet, as its ribbon cable is still connected to the motherboard via a ZIF connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

