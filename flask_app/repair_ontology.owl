<owl:NamedIndividual rdf:about="#Step_83552">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3VOIRNkHPFHTyNWP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Detach the red, black, and white wires from the circuit board that you pried off earlier. You will have to solder these wires in the same locations on your replacement circuit board. Removing the motherboard makes accessing the wires easier and eliminates the risk of the motherboard being damaged from a soldering accident.</has_title>
