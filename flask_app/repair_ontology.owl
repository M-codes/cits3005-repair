<owl:NamedIndividual rdf:about="#Step_96996">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LCul6NfwkeHQMSG4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Charged capacitors can cause personal injury or damage the device. Use caution when proceeding. Discharge the capacitor by connecting the resistor jig between the highlighted squares. Keep the resistor jig in place for at least ten seconds. Create a 1kohm resistor jig (wrap the resistor with electrical tape leaving the ends exposed, use alligator clips, etc). For reference, consult the service manual. [https://docs.sony.com/release/mdsm/983465933_sm.pdf#page=24|Click to go to the service manual page on discharging the capacitor.]</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LCul6NfwkeHQMSG4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96999">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tuqdkfgQIhcHPNxZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to remove the speaker retaining clip. The retaining hooks locations are indicated, but not exact.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tuqdkfgQIhcHPNxZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97000">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IDhZtKGvgiIPCJw3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the speaker by desoldering its wires. This step is optional.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IDhZtKGvgiIPCJw3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97014">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZM6ETAFfBAtHMECw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the flash up, as shown.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZM6ETAFfBAtHMECw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97026">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2BWsAQOYYcRWSAlP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From the top of the camera, Use a plastic opening tool between the flash and the case to remove the flash.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2BWsAQOYYcRWSAlP.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97958">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1lYTwamBGLZ6ykKs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">And here is the how the flash module should look after being removed. This is a reference image: it is possible to further disassemble this module, and is not necessary.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1lYTwamBGLZ6ykKs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97814">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PWOnK1Z6hKM4LjRc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove these two silver M1.4 X 4.0 Philips head screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PWOnK1Z6hKM4LjRc.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97822">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EXofRCwTalJxRJIn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the plastic opening tool between the front edge of the camera and the top "control assembly", pry and unhook the claws roughly located in the red square. Don't use too much force, nothing should be flying around the room as you disassemble the device. Keep in mind how things mesh together.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EXofRCwTalJxRJIn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97959">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gC4T4wZuweyNH3KK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The top control board and the battery cage do separate, but if you can, remove them as one unit. Removing and storing these components as a unit greatly simplifies reassembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gC4T4wZuweyNH3KK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97825">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/C1GUr36G1xHiJKt3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The service manual is a really good tool if needed for reassembly. Pages 25-29 should be helpful. [https://docs.sony.com/release/mdsm/983465933_sm.pdf#page=26| Click to go to the service manual.]</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/C1GUr36G1xHiJKt3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

