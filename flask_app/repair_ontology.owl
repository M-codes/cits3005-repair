<owl:NamedIndividual rdf:about="#Step_166251">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dcuPgSOaTGZnL4JY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweazers, remove the lens release button. Because the small spring underneath is only held down by the button, removing the button will cause the spring to be loose. To avoid losing it, you may want to remove it as well.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

