  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press down on the orange plastic. This will gently eject the battery from its compartment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

