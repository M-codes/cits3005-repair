  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the opening tool to unclip both sides of the black cover on top of the flash</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZN2xtSOZcwTFmTCS.standard">
