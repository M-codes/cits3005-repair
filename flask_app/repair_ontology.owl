  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZBxSLH13chihZTSP.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mwTyNEjTGivYZSkK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your plastic opening tool to gently move the plug lock from the end of the ribbon cord by lifting it upward. Gently remove the ribbon cable from the connector with tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZBxSLH13chihZTSP.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mwTyNEjTGivYZSkK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_93427">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/suQYIvJPJCRxQ5bt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Qjs3XdbjOGRlRnKJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently remove the ribbon cable assembly from the top of the camera with your tweezers. This cable is a long piece that runs across the top of the camera. The flash assembly is connected to this cable. Once removed gently lift out of the camera Replace the ribbon cable with the attached flash assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/suQYIvJPJCRxQ5bt.standard">
