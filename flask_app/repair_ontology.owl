<owl:NamedIndividual rdf:about="#Step_41972">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/haVXtlNernnMMfUs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3NlDRPv6Ig3NcDWM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Removing the eyepiece is easy.  There are two methods, you can do it yourself, or put it in your camera bag a dozen times and at least once, it will fall off. Grip the eyepiece by the sides firmly (index finger and thumb).  Wiggle it upwards until it is off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/haVXtlNernnMMfUs.standard">
