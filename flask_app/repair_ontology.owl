  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to remove the rubber button assembly. Blow on the sensors underneath  to remove any dust on the sensors. You can also dab a little rubbing alcohol on the sensor pad with a Q-tip and let it dry.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

