  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_45886">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UxwnmmMwk4xBOkpl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the internal electronics face-up. Look at the side with the flash turned towards you. The lens cover is a small sheet of metal that rests directly infront of the lens when the camera is turned off. Check to see if the spring action arm (what the yellow arrow is pointing to) is attached to the lens cover with the small knob in the corner (circled in yellow).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UxwnmmMwk4xBOkpl.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_46213">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6oGQ6TpjgfbbTFgf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the arm is not attached (as shown in the previous), use tweezers to place the arm over the knob on the lens cover. Inside the yellow circle, the arm is in the correct position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6oGQ6TpjgfbbTFgf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

