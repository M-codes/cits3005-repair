  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nikon D3100 Speaker Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_146626">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3KnwUIaYgHRycEDL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FHAVVF4NNRdtriHk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by following steps 1-6 in the [https://www.ifixit.com/Guide/Nikon+D3100+LCD+Screen+Replacement/72116|LCD Screen Replacement Guide].</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3KnwUIaYgHRycEDL.standard">
