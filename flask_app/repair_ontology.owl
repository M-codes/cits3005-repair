  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD screen should now be disconnected from the rest of the camera and a pry tool can be used to lift it out of its casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

