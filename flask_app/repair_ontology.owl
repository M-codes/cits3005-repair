  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3.5 mm screw holding down the Wi-Fi card. Move the Wi-Fi card away from the device. The Wi-Fi card is not actually detached yet.  Be careful not to damage the wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

