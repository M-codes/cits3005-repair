  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Again add a bit of solder to the poles. And use fold the connector tape. Watch out for shortcuts</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3crogbnR5Kffwo5D.standard">
