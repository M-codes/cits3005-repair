  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the orange wire ribbon attaching the back encasement to the I/O board in the lower right-hand corner of the camera (lens facing away). Carefully lift up the brown clip holding the wire ribbon in place and pull the ribbon out of the clasp with your fingers or tweezers. Be cautious when the removing the wire ribbon; it is very delicate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

