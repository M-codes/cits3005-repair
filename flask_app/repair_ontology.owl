  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Here is my Samsung S630. Nice little camera with just one flaw. The LCD display was broken.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ylCsqhGPhYTFWCXZ.standard">
