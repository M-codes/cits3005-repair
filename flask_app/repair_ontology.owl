  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the'' Philips screwdriver'' to remove the six screws of the damaged or malfunctioning camera lens.  Set the screws aside.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
