  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unthread the four wires running across the top of the viewfinder from the plastic brackets holding them in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TCc2ll4GfYEGXKIv.standard">
  <rdf:type rdf:resource="#Image"/>
