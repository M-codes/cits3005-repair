  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The stabilizer lens (or what I call it, it might be the focus after all) is kept in place with three clips. Red arrow shows direction in which stabilizer lens must be moved upon assembly Unhook all three and the little noses come out of their holder Carefully pull out the inner lens body. Do not pull as it is connected with a tiny ribbon wire</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

