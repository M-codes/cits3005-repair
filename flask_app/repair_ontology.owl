  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the metal plate is released from the tabs, carefully separate it from the face-plate by pulling it outwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

