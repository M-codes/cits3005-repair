  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/E4TAP4a2bNNDMMvG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the metal plate is removed from the front face-plate, locate the small clear flash cover on the top right of the faceplate. The flash cover should easily pop out of place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/E4TAP4a2bNNDMMvG.standard">
