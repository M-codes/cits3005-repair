  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3fLFIVSH4TOhbVin.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Bl1BXbBWN3OhJYQS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD screen and housing are now in three pieces: LCD screen LCD screen frame LCD back housing The LCD screen itself can now be removed and fixed/replaced.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
