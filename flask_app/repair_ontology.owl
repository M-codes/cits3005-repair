  <has_step rdf:resource="#Step_97718"/>
  <has_step rdf:resource="#Step_97913"/>
  <has_step rdf:resource="#Step_97522"/>
  <has_step rdf:resource="#Step_97525"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pentax PZ-10 Back Cover Locking Switch Spring Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97519">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aLGWLZBiqpmPFTiA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the lens face up and the bottom panel of the camera facing you, remove the two 7mm screws on the left using the J0 screwdriver. Remove the six 4.3mm screws in the middle and right of the panel using the J0 screwdriver. Pull off the bottom casing to remove.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aLGWLZBiqpmPFTiA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97912">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MKKPhTiTOifup2NU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the screws removed, the bottom casing should come off very easily by pulling on the casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MKKPhTiTOifup2NU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97520">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/igyJJlBJdeiXDLyE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera on its side so the lens is facing left. Press down on the locking switch on the side panel facing you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/igyJJlBJdeiXDLyE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97718">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DjJkrb2HYXbTCGXK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the door unlocked, rotate the device to access the bottom.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DjJkrb2HYXbTCGXK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97913">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jX6d2ilDHCYC2bJT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a pair of tweezers, gently remove the metal tab securing the back door axle. The door will come loose at this point, watch for any loose parts that may also come out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jX6d2ilDHCYC2bJT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97522">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UGxQTxyrlGUEUltt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the back cover is fully removed, remove the two 4.35mm screws attaching the cover of the unlocking switch, and remove the plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UGxQTxyrlGUEUltt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97525">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YU2wft5iGClQ3DUL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the spring at the upper left corner of the face, and pull the rings of the spring off of the pins to remove it using plastic opening tools. You are now ready to replace the spring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YU2wft5iGClQ3DUL.standard">
