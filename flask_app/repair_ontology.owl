  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When you reassemble the camera, make sure the switch on the casing (pictured left) matches the position of the switch on the camera internals. The black viewfinder padding (pictured right) can easily fall off the casing. Make sure you don't lose it when moving around parts.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
