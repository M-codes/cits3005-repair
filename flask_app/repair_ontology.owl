  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, gently pull the top ribbon cable out. This cable does not have a black clip holding it in place and therefore some force will be required to remove it. ''Reassembly note: tweezers will help reinsert this cable into its connector as force will be required to insert it.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
