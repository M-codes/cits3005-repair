  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD screen can now be lifted from the right side to be replaced.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
