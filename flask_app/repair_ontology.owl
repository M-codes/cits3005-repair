  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the ribbon connecting the control panel to the camera. The latch can be removed by sliding it down and pulling the ribbon down.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
