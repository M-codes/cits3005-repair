  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Before starting, make sure the camera is powered off. Take the Hex and PH000 bit to remove a 2mm screw from the left side of the camera. Next, remove the 2mm screw from the right side. Lastly, remove the 3mm screw from the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

