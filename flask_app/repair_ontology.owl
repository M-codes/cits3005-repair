  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the set of wires from the back casing to the motherboard. Do this by using the plastic spundger  to flip the black tab up and the wires will pull out. Unscrew the four 3 mm and two silver 1 mm PH000 screw from the green logic board</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

