  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The top plastic piece holding the release button should be held on only by a red-and-black wire connector to the logic board. Remove the connector from the logic board and detach the release button housing from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

