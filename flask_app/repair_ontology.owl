</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129794">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oFwJwvP65OMqmQRS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/q6KoMdxGMnYt4jXR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fgA4kcSECF4lAOW2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate the display hinge to reveal two 4mm Phillips #00 screws. Before removing, use the plastic opening tool to pry apart the plastic hinge cover. Remove the cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oFwJwvP65OMqmQRS.standard">
