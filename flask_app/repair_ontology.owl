  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera LCD side down. Remove the two 5.3mm screws by the battery door.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BbFuXliuyWW3Zkvn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35568">
