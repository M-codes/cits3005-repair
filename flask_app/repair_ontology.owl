  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera over to the side with the LCD screen. Gently remove the plastic cover that borders the LCD screen starting with the top left corner, then the bottom left corner, and finally the bottom and top right corners. The LCD screen is now loose from the camera; it should only be connected by a gold strip that attaches to the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RBfDq5Xt6hCTTDjF.standard">
