  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your plastic opening tool to gently lift and remove back face plate. Unplug the ribbon cable leading to the mode dial.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

