  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the screen back over. Using the plastic open tool, flip open the black retaining plastic piece holding the larger ribbon in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fBAYPhcK3dmXYSGv.standard">
