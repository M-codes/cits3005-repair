  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two 4.8mm screws located on both sides of the eyepiece.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mxtjO3VOyWNj52ns.standard">
