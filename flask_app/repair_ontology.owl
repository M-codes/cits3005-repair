  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3mm screw from the back of the control dial while holding the front of the control dial. Be ready to catch the control dial, button, and spring that will fall out with your hand.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

