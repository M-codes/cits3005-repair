<owl:NamedIndividual rdf:about="#Step_198021">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YfBKH1IDiKL14COh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift and remove the lens casing, pulling it free from the now disconnected ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

