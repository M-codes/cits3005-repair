  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For the AV port, detach the bottom orange cable. For the LCD screen, detach the top orange cable on the right side of the motherboard. For the motherboard, detach all the orange cables. Careful not to damage the red, white, and black wires when lifting the board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
