  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LNmnvxXEnMWyTjr1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press the memory card down into the camera. The memory card should pop out. Remove the memory card.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
