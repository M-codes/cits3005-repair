<owl:NamedIndividual rdf:about="#Step_97507">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/snrHjjitaXmx4vbB.standard"/>
