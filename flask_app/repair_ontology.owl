  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingernails, wiggle the power connector back and forth until it becomes loose. Pull the power connector straight out of the socket. Pull only on the power connector and not the wires themselves to prevent damage.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

