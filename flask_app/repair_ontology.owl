  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The inside of the flash shoe has a removable cover which is just snapped in place. Using the flathead screwdriver, pry up on the front end of the cover. Warning: The cover is on tight and is tough to pry off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
