  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the point of the spudger, carefully lift the bracket off of the LED light on the upper-left corner of the lens. The bracket is spring loaded and will bounce off. Lift the LED light gently away from the camera. It will remain attached to the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</has_order>
</owl:NamedIndividual>

