<owl:NamedIndividual rdf:about="#Step_45881">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4UkpgEgGYK6KWRZe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BXyi2T5yKDhWIlNn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/i5vcFhkG6yvMIiRj.standard"/>
  <has_tool rdf:resource="#Tool_phillips_2_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the silver screws on each side of the camera. Use the Phillips #00 Screwdriver to unscrew all 2.0mm (4 instances) and 4.0mm (2 instances) screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4UkpgEgGYK6KWRZe.standard">
