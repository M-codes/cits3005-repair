  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the silver plate with needle nose pliers. Clean the silver plate with isopropyl alcohol and a cotton swab to remove any debris.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4QWgfTYriRpGmAvJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94599">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MwmliGU4sdCYqWlT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reinsert the silver plate and the four 6 mm screws and screw them securely into their holes.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MwmliGU4sdCYqWlT.standard">
