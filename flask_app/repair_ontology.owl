  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37200">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yZKHQsuVeA6xr4pw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Lbg51qkyNjqKUwpJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PWZ2DKYJyR32Cmgq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screw on the right side, underneath the side cover. The side cover is attached to the camera by one of the screws on the bottom, and the cover should easily slide down to reveal the screw. Separate the outer case from the catches on the bottom of the camera with an opening tool. The case clicks into place with a few catches on the bottom and the sides of the camera. Separate the case from the catches on the sides of the camera with an opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

