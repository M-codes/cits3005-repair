  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a #00 screw driver remove the screw on the bottom of the logic board, just above the tripod attachment. Gently pull the front of the case away from the insides of the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

