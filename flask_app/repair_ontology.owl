  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the CCD and the lens ribbon cable from the connectors. To release the CCD cable, gently slide the brown clips on either side to the left. This will release the cable. Desolder the connector from the top PCB. Use a soldering wick and flux to make the task easier.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

