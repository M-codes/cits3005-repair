<owl:NamedIndividual rdf:about="#Step_170366">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wm4CjfaZRXSVNUAj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KZy6rFPUGEX1ReYT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xmwNjAxMpl2LRKdJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the retaining flaps on the two ZIF connectors that secure the the lens ribbon cables to the motherboard. Carefully pull the two ribbon cables  from their sockets on the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
