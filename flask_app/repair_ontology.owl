  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After following all previous steps and the button is still jammed or sticky, it may be necessary to replace the button. To do so follow this Button Replacement guide [https://www.ifixit.com/Guide/Nikon+Coolpix+S7000+Navigation+Button+Replacement/86075].</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

