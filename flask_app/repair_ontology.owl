  <issubProcedure rdf:resource="#Procedure_5026"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Panasonic Lumix DMC-F7 Replacing the Front Case Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22645">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kgvE3I3CKjuvbrtb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two remaining 2.8 mm Phillips screws on the bottom of the camera. The other three screws shown in picture were removed to take off the back case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kgvE3I3CKjuvbrtb.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22646">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6YBcpfmbWo1nYElD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UwERkUZwEYKM1EGE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OqWB1HvlfoLAAyFq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using Spudger tool, pry the front case from the camera's components. Use your fingers to carefully pull the back case from the front case. Cut the black and red wires connecting front case to the body of the camera. Being careful nothing get's caught, separate the front case from the camera. To put the new front case back on, solder the wires of the new front case to the components of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6YBcpfmbWo1nYElD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UwERkUZwEYKM1EGE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OqWB1HvlfoLAAyFq.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_5026">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
