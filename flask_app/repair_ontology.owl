  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kS3nQXdITLVI6QEc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove old LCD screen from metal plate. Make sure new screen is clean. Install new LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

