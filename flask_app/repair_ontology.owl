  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera upwards between your thumb and first finger. Tilt the camera to the best position and loosen the captive linings using a plastic opening tool. Slide the top cover outwards to separate the upper section from the lower lid using the plastic opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

