  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the tweezers pull the ribbon away from the connector, freeing it and allowing it to move.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

