  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4TsjEStNJMMTyKA2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a firm hold on both sides of the camcorder, gently pull apart the two halves.  Pressure should be evenly distributed across entire device. If the camcorder does not come apart easily, double check that all of the screws are removed.  Return to the previous steps for screw removal if you find a screw that is still attached.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

