  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UAPDE1XHHU6KUsCA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

