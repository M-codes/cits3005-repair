  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2 small screws under the viewfinder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

