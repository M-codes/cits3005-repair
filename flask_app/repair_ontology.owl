  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112953">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xo1BHXCCPT2OA5oB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cklgo3bOoa6A1RxI.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your hand, lift the detached plastic cover off the plastic frame. To place a new plastic cover, simply stick it to the frame in the appropriate position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xo1BHXCCPT2OA5oB.standard">
