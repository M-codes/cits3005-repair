<owl:NamedIndividual rdf:about="#Step_210031">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wDjC5UjSXoUKYPgO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TFyoNKfCDsWJMuqg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the ''plastic opening tool'' to carefully pry the motherboard out of its place, proceeding from the indicated points.  Pull gently, as to not destroy any of the other internal parts of the camera. Pull gently, as to not destroy any of the other internal parts of the camera. Insert the new green motherboard in place, making sure it fits snugly under the  grey tabs at the edge of the camera case. Reassemble the camera following these instructions in reverse order, as well as the instructions in the prerequisite guides.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

