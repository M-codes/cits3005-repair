  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 3 screws on the flat side of the camera All silver screws go into the side of the camera that is silver All black screws go into the side of the camera that is black</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
