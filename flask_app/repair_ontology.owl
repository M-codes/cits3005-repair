  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34959">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aBAgoCgmKG16JWoP.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/M5nXUSWtJcXJaoQt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/64fldNTbfTkVmGv3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently wiggle the eyepiece out of its place.  It should snap out of place. There should be a white ribbon cable underneath attached to the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aBAgoCgmKG16JWoP.standard">
