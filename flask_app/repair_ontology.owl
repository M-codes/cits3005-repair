  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 1.0 mm Phillips #00 screws from back of the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yIVLNlqKVmGfwoqA.standard">
