  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two 6.4mm screws on the latch mechanism on the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vRRRlfTrvi2UaE1r.standard">
