  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a soldering station and solder wick or other solder removing instrument, remove the solder holding the two wires of the LCD screen to the circuit board. You have now completely removed your LCD screen. It can now be replaced or cleaned.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

