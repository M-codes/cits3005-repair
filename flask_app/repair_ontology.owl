  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ueEdwExnFaGTDmrN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129389">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AdqWcOOHSRDcKWBS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/X3jZdBpclfSJ6BCf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the 2 mm screw that is next to the battery compartment. Using the PH J000 phillips head screwdriver, apply pressure to the screw head and turn in a counter clockwise motion until the screw is loose. You do not have to completely remove the 2 mm screw.  To prevent losing the screw, you may leave it loosely in its place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AdqWcOOHSRDcKWBS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

