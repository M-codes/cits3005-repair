  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger and gently open up the front panel of the camera. A thin plastic ribbon will stay connected by a brown piece to front panel of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EKmMh4UPW1YXY5HO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

