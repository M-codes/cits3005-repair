  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4lQTCDbnPK6tyiJp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NHFPwJHJjkgtgN4G.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 2.5 mm Phillips #PH00 silver screws using the PH00 screwdriver. Using the plastic Spudger opening tool, carefully lift up on the medal tabs next to where the screws were located.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4lQTCDbnPK6tyiJp.standard">
