  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1Z2ajv2POb4gAdQw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/x2wLSRbxL2YQmVkb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Remove the tape to release the top half.''' '''The Half with the circuit board is the built-in flash.''' '''You have successfully removed the built in flash!!'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

