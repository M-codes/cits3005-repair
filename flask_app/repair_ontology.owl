  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the memory card door in the direction of the arrow engraved on the camera.  Once the door has slid open to its full position, lift up on the door.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IJfkvVOxfSbMWfpP.standard">
