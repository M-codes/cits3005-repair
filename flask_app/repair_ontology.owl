  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the five 5mm screws on the panel that you just removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

