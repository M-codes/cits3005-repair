  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oMUjeS4oI25Do6No.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingers to remove the A/V tab.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
