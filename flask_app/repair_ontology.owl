  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_precision_utility_knife"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/R34tArmaF4OSiAve.standard"/>
