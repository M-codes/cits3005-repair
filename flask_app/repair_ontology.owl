  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry the back panel away from the body of the camera, using the space you just opened up. Be careful not to damage the ribbon cable on the opposite end of the camera. A small piece of the frame of the camera may fall off, but it can be easily put back into place during reassembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
