  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the opposite side of the camera, remove the two 3mm PH00 Philips screws.</has_title>
