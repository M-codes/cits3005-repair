  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the tweezers, remove the spring on the bottom edge of the battery compartment. Remove the two 4.3 mm silver screws on the inside of this compartment. Lift and remove the flash unit from the left side of the assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
