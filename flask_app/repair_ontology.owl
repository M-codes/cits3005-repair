</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ix4ecIkNT6vNyDLM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_95544">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fbcgG5CBoFLypDU2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull out the ribbon. It should come out easily, don't force it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fbcgG5CBoFLypDU2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_95546">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IObP13HM1dLF1xHT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the new display and orient it the same way as the old screen before it was removed. Gently slide the end of the electric ribbon into the connector. To make sure that the ribbon is completely in the connector give it a firm push but don't force anything. The ribbon should slide in with only a little resistance. Don't bend the ribbon.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IObP13HM1dLF1xHT.standard">
