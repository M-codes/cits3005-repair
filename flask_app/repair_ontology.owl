  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sony Handycam DCR-DVD650 Disk Door Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155561">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FZIdiJc4JbYCTROi.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qmGi6UgETcAWPNlI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JvOLCUXRQJ5Tpo1s.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The  hand strap can become a hindrance at times. It's best to begin by unlatching it. On the padded section  of the hand strap, pry up the Velcro and peel out the thin strap sandwiched between them. Push the thin strap through the metal loop at the front of the device. The strap will still be connected at one end to the device, but will be able to be moved out of the way to provide a more stable working surface.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FZIdiJc4JbYCTROi.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qmGi6UgETcAWPNlI.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JvOLCUXRQJ5Tpo1s.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155563">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nHhjT2ZTECRba6nr.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/R3jZcAHVebuZctEN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5M2RNEPHLLt5hWwS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip open the LCD screen and find the screw located above the micro USB port. Remove the screw (4mm, Phillips #00) Using a spudger, or another small plastic prying tool, pop up the silver panel. It may also help to flip up the SD card cover and tug gently on that piece to assist in prying up the panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nHhjT2ZTECRba6nr.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/R3jZcAHVebuZctEN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5M2RNEPHLLt5hWwS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155565">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/chOEptQwyIP3AQ2d.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1ksHGSk4voZeudFT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AITFSWLwgtUkUOpZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the silver cover is pried up, slip the piece out to the right. There are two cables attached to the board beneath that need to be disconnected. Disconnect both of the no-fuss ribbon cables. Use your fingernails or a pair of tweezers to pull on the tabs on either side of the ribbon cable to remove. Remove the other cable by pulling up on the cable itself. ''Remember: cables are very fragile, be as delicate as you can removing and connecting them.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/chOEptQwyIP3AQ2d.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1ksHGSk4voZeudFT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AITFSWLwgtUkUOpZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155670">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MPSBQnTIh3CKPTLR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XBr5YNfojorrFudZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the screw (Phillips #00) found in the top right corner of the housing. Remove the screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MPSBQnTIh3CKPTLR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XBr5YNfojorrFudZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155674">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3rGVLdhuBNg3QxQC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lF6QLpYSjWFIJq6P.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/A4WaNEuOU1LmYnfX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Close the LCD screen and turn the device over. Insert your spudger or other plastic pry tool into the small gap between the device housing and the door. ''It's best to do it just above where the word 'close' is printed as that is where the locking mechanism is located within.'' Pry open the door with the spudger, using your other hand to tug the door as you work it open. ''Caution: this has the potential to damage the plastic piece that locks the door into place.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3rGVLdhuBNg3QxQC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lF6QLpYSjWFIJq6P.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/A4WaNEuOU1LmYnfX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155676">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wVFgmiWThbT5cVaR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UU36ucWKcqyDwKTj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the disc door is open, locate the screw (Phillips #00) on the inside, top right corner, closest to the camcorder lens. Remove the screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wVFgmiWThbT5cVaR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UU36ucWKcqyDwKTj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155680">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gAYBxUpdBMHoonN1.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NaNqE3YOovkiWBOd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn to view the bottom of the device and locate the four screws on the bottom (4mm, Phillips #00). Remove all four screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gAYBxUpdBMHoonN1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NaNqE3YOovkiWBOd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155687">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oLPeFFBK2UZiINHM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EXBA5VaIwosw2QLN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MAVdk3HPXWhyoFCu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the screws removed, the black and silver housing pieces should be able to shift apart from one another. ''Caution: do not pull the device apart willy-nilly. There is an internal ribbon cable attached to both halves of the housing that can easily be damaged by doing so. Slow and steady wins the race. '' Gently work the black and silver housing pieces away from one another. ''If the housing is a bit resistant to separating, it may help to use a pry tool along the bottom of the device where the two colors meet.''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oLPeFFBK2UZiINHM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EXBA5VaIwosw2QLN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MAVdk3HPXWhyoFCu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155704">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2ZGAwIKrUZCIaKO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xTqoGZXjSt5lKlkh.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uhcLUlXPewbWjCZK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the device is open, carefully remove the no-fuss ribbon cable from the motherboard and set aside the silver portion of the device. There may be a piece of plastic adhesive shielding the motherboard. Remove gently, being careful not to pull on the ribbon cables beneath it, and set aside.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2ZGAwIKrUZCIaKO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xTqoGZXjSt5lKlkh.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uhcLUlXPewbWjCZK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155707">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JGOlFLbZKSiYn6AE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1LwSSGeUoxKknrHd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/24Q21rvwmNJQVgQv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate all of the cables attached to the motherboard. Carefully disconnect all cables. There are four orange no-fuss ribbon connectors. To disconnect these cables pull up on the tabs protruding from both sides of the cable rather than pulling on the cable itself. There are two white no-fuss ribbon cable connectors. To disconnect these cables, pull them straight out of the connector. In the lower corner on the far right, disconnect the Zero-Insertion Force (ZIF) connector by flipping up the small black bar before removing the cable. Power Cable: Disconnect the bundled cable connector by prying up gently from the edges.  If you need to,  collect the cables between you fingers and pull gently to remove. Try not to pull more on one wire than the rest as this can strain and separate the wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JGOlFLbZKSiYn6AE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1LwSSGeUoxKknrHd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/24Q21rvwmNJQVgQv.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155708">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VBTmOR6jv2YLpqeU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xAiFcyXM4tRqRPkn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEKDeotZMbUU3NWX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that all of the cables are disconnected, remove the two bronze screws (2mm, Phillips #00) on the lens housing. Next we'll need to remove some screws from inside the disc housing. If the disc door has closed at some point, turn the camcorder lens toward you and locate a small cylindrical lever to the left of the lens. Pushing down on this lever will manually release the door.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VBTmOR6jv2YLpqeU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xAiFcyXM4tRqRPkn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEKDeotZMbUU3NWX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155923">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pD2UAtCAD2dBCcmu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ML3gPGZwxTnwNmHT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5YTvNV2hZElJAKvW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the top two upper screws (4mm, Phillips #00) on the interior of the DVD housing. Pry up the black strip of housing between the open slider and the remaining silver housing above the lens. A bit of a gentle tug and wiggle of the piece towards the lens side of the device, should allow you to completely remove the piece.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pD2UAtCAD2dBCcmu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ML3gPGZwxTnwNmHT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5YTvNV2hZElJAKvW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155942">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SkTBRSiq5TUoE5VF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LnUlJPXe2slGacWL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMr5sKOYERRCH2jw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the bronze screw (2 mm, Phillips #00) attaching the  rear housing to the frame. If you are using a screwdriver that uses interchangeable tips, the connecting base of the screwdriver is too wide for reaching this screw. You will need to use a standard (and magnetic, if possible) Phillips #00 screwdriver. Once the screw is removed, the rear housing can be gently pulled away.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SkTBRSiq5TUoE5VF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LnUlJPXe2slGacWL.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMr5sKOYERRCH2jw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155955">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZMN4R5W4mTYpWuIw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Omb6kcVPNDRLam3W.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jGdRMB3Es3MZ2Z5G.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the screw removed, lift up the silver panel above the lens assembly and slide it out towards the lens. The rear housing should be able to be tugged apart with a small snap. Set aside the rear housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZMN4R5W4mTYpWuIw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Omb6kcVPNDRLam3W.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jGdRMB3Es3MZ2Z5G.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155977">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IKXWNGiPErSNOSPQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VODCIOLKktTMHFaY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CJG3AnkXIb2X1Jls.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three black screws (5 mm, Phillips #00) connecting the  frame to the disc housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IKXWNGiPErSNOSPQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VODCIOLKktTMHFaY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CJG3AnkXIb2X1Jls.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155981">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/riWjqPWO6JNIWaHX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the motherboard and frame and set aside. If your replacement part includes the full disc door assembly, you can stop here and reassemble your device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/riWjqPWO6JNIWaHX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155989">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xwWXEguvmomXVbFo.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Tg1owpQ2AT4KUK2O.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/alOQrEBcyZaoULFn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two outer screws (4mm, Phillips #00) from the hinge. Opening the door to a full 90 degrees,  should allow the door to be tugged up and out from the disc door frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xwWXEguvmomXVbFo.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Tg1owpQ2AT4KUK2O.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/alOQrEBcyZaoULFn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AvertX_HD810">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_77967"/>
  <has_procedure rdf:resource="#Procedure_77978"/>
  <has_procedure rdf:resource="#Procedure_78172"/>
  <has_procedure rdf:resource="#Procedure_78542"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_77967">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_t10_torx_screwdriver"/>
  <has_tool rdf:resource="#Tool_phillips_screwdriver"/>
  <has_step rdf:resource="#Step_155092"/>
  <has_step rdf:resource="#Step_155093"/>
  <has_step rdf:resource="#Step_155094"/>
  <has_step rdf:resource="#Step_155593"/>
  <has_step rdf:resource="#Step_155600"/>
  <issubProcedure rdf:resource="#Procedure_77978"/>
  <issubProcedure rdf:resource="#Procedure_78172"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AvertX HD810 IR LED Lightboard Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155092">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JhDLhO2FWNoxXYnV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/giL1lkqVXFJPfOXG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/s1g3En5PqmBva3k1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift off the paintable snap-on cover from the AvertX HD810 dome security camera. Optimally, the device should be turned off and the PoE (Power over Ethernet) unplugged.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JhDLhO2FWNoxXYnV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/giL1lkqVXFJPfOXG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/s1g3En5PqmBva3k1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155093">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_t10_torx_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5ZWEL3VhISQHUsKn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eWCSMCpNuFXZBSj3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loosen '''both''' 10mm screws on either side of the clear dome cover housing using a T10 Torx security screwdriver. '''It is not recommended to remove the screws from the clear dome cover housing.''' The screws are apart of the cover and not intended to come out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5ZWEL3VhISQHUsKn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eWCSMCpNuFXZBSj3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155094">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEsVy4SqefG2RWWJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VsYdICH5FFFuVHo2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IXvwHk5U5hEgjdwR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull off the clear dome cover from the camera base.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEsVy4SqefG2RWWJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VsYdICH5FFFuVHo2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IXvwHk5U5hEgjdwR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155593">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/L6eMLx656PV3kfN4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VqdWFOhZoDFoMBXu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XHlZS5wlIXnc4PZH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the PH1 screwdriver to remove or loosen '''both ''' 10mm screws on either side of the inner protective lens cover. '''This will loosen both the cover and the IR LED lightboard.''' The cover and the lightboard are two separate pieces held in place by these two screws. The cover should be set aside first before continuing with the lightboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/L6eMLx656PV3kfN4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

