  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a plastic opening tool to release the lock securing the ribbon receptor to the right side of the motherboard. Ribbons have to be unlocked before removal to prevent damage.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kUHNmeVG4Hf1fGbF.standard">
