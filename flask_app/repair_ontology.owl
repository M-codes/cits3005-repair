<owl:NamedIndividual rdf:about="#Step_125713">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/x2Ewtw1sDYTtLheb.standard"/>
