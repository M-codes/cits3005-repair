  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four screws holding the mounting plate. Lift off the mounting plate. (Photo shows inner components in place.) Remove the four spacer rings below the mounting plate. Be careful not to bend the brass rings.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

