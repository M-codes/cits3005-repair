</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_197052">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QVfQhBcplUAirkBw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the flat end of a plastic spudger underneath the motherboard and twist. This will disconnect the board from the device and allow it to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QVfQhBcplUAirkBw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_197053">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yuXDgXHjASnPgrYM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the pointed end of the spudger to lift the black tabs holding the ribbon cable connected to the photoreceptor in place. Before pulling the cable free, be sure to complete the next step (removing the screws) as the ribbon cables are delicate and must be handled with care.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yuXDgXHjASnPgrYM.standard">
