  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the Phillips #00 Screwdriver, unscrew the four 3.9mm screws from the center metal panel. Using the tweezers, pull the metal panel to remove it from the motherboard. Using the tweezers, disconnect the ribbon cable from the motherboard. Using the Phillips #00 Screwdriver, unscrew the two 3.9mm screws on the top left and bottom left of the motherboard. Using the tweezers, disconnect the ribbon cable from the bottom left of the motherboard. Using the spudger, gently pry the motherboard from the casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

