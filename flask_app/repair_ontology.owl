<owl:NamedIndividual rdf:about="#Step_120231">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WDLTDrKVKPgaY6BR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jXXgApaEaWcFwwBM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera upside down. Place your thumb on the switch, and slide it towards the center of the camera. The compartment will pop open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/WDLTDrKVKPgaY6BR.standard">
