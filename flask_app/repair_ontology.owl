  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the orange tab to the right to release the primary battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

