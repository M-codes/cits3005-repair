  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the small cover from near the top of the motherboard, using tweezers or forceps, as in the picture.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eNgq63nhnUCGvZg2.standard">
