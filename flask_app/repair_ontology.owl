  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Position the camera so the bottom is facing up and the display away from the surface. Gently pry the screen portion from the camera portion with your fingers or a plastic prybar. Do not fully separate the two components! the screen is attached by two ribbon cables. Lay the display flat to expose the circuit board and the display control ribbon cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rouutvIqHOlHvMfH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hI4PAHenWPLbEQFg.standard">
