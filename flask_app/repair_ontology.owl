<owl:NamedIndividual rdf:about="#Step_45742">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uQiVGWWxRZAF3O6J.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SSmTDx1rxQetmqC4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xICshyDDXr2gQqRm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully insert the flat end of the spudger into the seam on the top side of the device.  Carefully twist the spudger to open the device. Repeat this step at incremental locations around the seam of the device until the two case halves separate. Before completely separating the two halves, separate the case from the battery compartment cover, pulling the case apart.  Take care not to break the plastic hinge as the battery compartment cover is removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

