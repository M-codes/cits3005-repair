<owl:NamedIndividual rdf:about="#Step_25942">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/O4N4YhNqefgppANR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In preparation for disassembly, the battery and SD Card need to be removed from the camera. You can access both the battery and the SD card through the door on the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/O4N4YhNqefgppANR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25943">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RcfWZ4sVXCwdHkJw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While being careful to remember the original location of each screw, remove the three 0.15 inch screws on the underside of the camera. Each of the screws is slightly different, so it is important that you note the original location of each screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RcfWZ4sVXCwdHkJw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25944">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MkARWvyk2tjCWDwW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LoWipxOowNgnjGpj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rdNV24ZjTlTAGAtw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the next two screws on the right side of the camera. One of them is hidden under the USB port cover. The upper screw is .125 inches long, while the lower screw measures .085 inches. Remove both screws, then carefully lift the side panel off. Underneath the side panel, there is a .07 inch screw. Remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MkARWvyk2tjCWDwW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LoWipxOowNgnjGpj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rdNV24ZjTlTAGAtw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25945">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/l5PQGGmVqpfpGrF2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/F3BUqEqHERjbmHGe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BBC46DSkXE2chl5H.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the left side of the camera, there are two .085 inch screws. Remove these, then lift the plate from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/l5PQGGmVqpfpGrF2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

