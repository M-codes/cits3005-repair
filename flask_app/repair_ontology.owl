  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Utilize the plastic opening tool to gently lift the LCD screen away from the metal plate. Flip over LCD screen so that the left side of the metal plate is visible.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
