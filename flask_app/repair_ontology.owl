  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HKJa22x2fCcXdB1W.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 3.5 mm Phillips #000 screws from the secondary board that is attached to the flash bulb.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HKJa22x2fCcXdB1W.standard">
