  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tweezers to remove the black plastic and attached copper ribbon on the inside of the casing. Use your hand to pry off the circuit board for the shutter and power buttons. Remove the shutter and power buttons with the tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

