  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OjPCNAGnCEKNIOsW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OKyhGIM3r45pXAlY.standard"/>
