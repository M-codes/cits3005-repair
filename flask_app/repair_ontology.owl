<owl:NamedIndividual rdf:about="#Step_148889">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gcswl5e4X1g2ahVD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JXlYhtJaMqmLcjka.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the one 3-mm J000 screw on the left side of the S9700 (side with no ports). Remove the two 3-mm J000 screws on the right side (side with HDMI and charging ports). One of these screws is underneath the HDMI port cover. Lift the port cover up to access.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

