  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three loose parts (spring, small rod, and metal ring) that were under the lens mount and put them aside. Make sure you remember the orientation of the metal ring so that it is easier to put back in the device later.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

