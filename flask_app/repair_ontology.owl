</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZSjVVStRKnnNJ6BC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

