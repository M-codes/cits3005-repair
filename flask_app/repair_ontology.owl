  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 6.4mm screw on the top of the inside edge of the battery hole.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5IHAmcRyaHHJuwZH.standard">
