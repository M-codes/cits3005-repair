  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iwkg3KyalTW4YZnp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screen by sliding the golden film out of the channel and pulling the screen away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

