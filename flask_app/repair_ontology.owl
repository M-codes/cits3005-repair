<owl:NamedIndividual rdf:about="#Step_148594">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wFsKso1NYWr5ypYm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mCwKn6IhJyC3slT4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/t2pOZ3dCpNSMIlCC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The green-colored circuit board is connected to the camera with a total of four flex ribbons. The three flex ribbons on the right have locking latches that need to be unlatched before removing flex ribbons.  Unlatch all three latches and then remove flex ribbons using tweezers. The fourth flex ribbon needs to be carefully unplugged using tweezers. Once all four flex ribbons are unplugged the green motherboard is free for removal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wFsKso1NYWr5ypYm.standard">
