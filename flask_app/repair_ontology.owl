  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry the back half of the casing from the camera. Be careful when maneuvering the camera without the casing on as the LCD screen is not fastened to anything.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

