  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From the front (lens side) of the camera, gently lift the first lens ribbon at the bottom of the circuit board using the spudger. Gently lift the second lens ribbon  in the center of the circuit board using the spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</has_order>
</owl:NamedIndividual>

