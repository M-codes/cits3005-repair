  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the metal casing on the flash, by grabbing with two fingers and pry it off the snaps connecting it to the flash. Remove the plastic cover on the flash, by simply grabbing the plastic with two fingers and pulling.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

