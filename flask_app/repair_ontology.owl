  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Astak Mole Camera Head Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_139631">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OlDH21GmUbJMqmBJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the three screws connecting the base to the camera head with the PH1 size Phillips head bit. ''Screw measurements: Length=7.0mm.'' The third screw can be exposed by rotating the camera head. Do not force the camera head farther than it will allow you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OlDH21GmUbJMqmBJ.standard">
