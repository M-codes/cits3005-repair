<owl:NamedIndividual rdf:about="#Step_84032">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OhsDurubKpbxVtqD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">remove the two 3.10mm Phillips #00 screws from the LCD case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OhsDurubKpbxVtqD.standard">
