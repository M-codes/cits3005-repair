  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NrqoUfuVlKXx1xHD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the bottom side of the top bezel, remove the ring, detent ball and spring. Your control dial is now ready to be replaced with a working unit.</has_title>
