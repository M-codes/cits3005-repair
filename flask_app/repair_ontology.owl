  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once you are able to lift the cover up, you will then be able to pry off the lens which will allow for the device to open more. Take off the lens cover. Be careful not to pull the device open too much otherwise you will snap it in half since it is made of plastic. Once you have this up, pull up the cover and you will now be able to work on the arrow key button</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/inoiOIRSndsWjQ2v.standard">
