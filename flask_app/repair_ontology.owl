  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the outer casing holding the back part of the camera together. Leave on the front casing. Use a Phillips screwdriver to remove the two small screws holding the outer casing to the mother board. Use the prying tool to unhook the casing from the plate covering the motherboard</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

