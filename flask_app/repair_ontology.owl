  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove both screws on the opposite side of the screen, located near the hinge.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/r3jTeoLHBPKX62IR.standard">
