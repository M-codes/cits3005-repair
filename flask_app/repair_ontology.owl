</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22081">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/REZxttdJsENwWyw4.standard"/>
