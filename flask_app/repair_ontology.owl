  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the 3 screws that hold the back cover to the camera. One screw is located on the film opener side of the camera. The other screws are located on the opposite side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
