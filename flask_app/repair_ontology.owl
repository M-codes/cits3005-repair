  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the three cables from the motherboard by pulling each one '''gently but firmly''' away from their respective connections. All of these cables can safely be removed from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

