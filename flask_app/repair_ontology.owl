  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are 2 screws located on the left side of the camera. These screw locations are depicted with the red circle markings in the photos. These screws are 2.0 mm long.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

