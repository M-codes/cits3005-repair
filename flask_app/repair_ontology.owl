  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_108851">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_metal_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EEcIgyq1mfLObrqA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dM5AqjeYiqOUXUSE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vdcOGcDKrBoarpZr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the sensor assembly, simply peel  off the lens towards the attached ribbon cable. The sensor has ribbon cables running to the motherboard via a black rectangular connector. To remove the sensor, use the spudger to pry up each side, Then, lift the connector straight up from its socket. With the old camera sensor assembly removed, you can now replace it with a new sensor.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

