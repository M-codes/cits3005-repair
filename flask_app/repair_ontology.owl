<owl:NamedIndividual rdf:about="#Step_120724">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nqeoLOwqNaAUnXIP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 2.8 mm screws on the top of the lens assembly near the viewfinder using a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</has_order>
</owl:NamedIndividual>

