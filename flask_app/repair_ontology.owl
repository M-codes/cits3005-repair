  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ATDAfdALvq2XWEgB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the tweezers, remove the black/red speaker wire from camera housing. Pry loose and remove the speaker from the camera housing. The speaker is attached with adhesive and must be removed with the spudger and moderate force.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

