  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the battery has popped out of the compartment, simply pull it out of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

