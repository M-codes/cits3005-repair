  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FEPmSmFIMFLGuRgK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the tape Remove the single screw. You can disconnect the ribbon cable, by carefully pulling on the end. I opted to leave it connected to minimize the risk of tearing the fragile cable. It is possible to just move the frame out of the way.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

