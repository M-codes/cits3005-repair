  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the motherboard from the frame. There are 3 Phillips #00 5.0mm screws holding it in place. Then (gently!) remove the motherboard and the lens with your fingers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
