  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tin the exposed wire.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

