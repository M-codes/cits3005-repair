  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the spudger to pry up the retaining flap of the ZIF connector. Disconnect the ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

