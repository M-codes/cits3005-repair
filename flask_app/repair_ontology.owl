  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The new battery is 400mAh. and fits just in the battery location. New battery in place and soldered. See the difference between old and new battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
