</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/iYO4jhL5AZiOQPTN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62104">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hvsFcuwBaFSOeNBW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OPSJO5oBUuZEh2TI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZQ6skyMes4JQZJXl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using screwdriver, remove silver metal piece located in center of camera. Using tweezers, gently remove orange circuit from lens. This step is tricky as the orange circuit is very securely placed in the lens. After the removal of the silver piece and orange circuit remove black circle from center of camera. This is the lens Gently remove top portion of lens as shown in the third picture.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hvsFcuwBaFSOeNBW.standard">
