</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10255">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DUsDMK1Yk36QcHZi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the front and rear panels, locate the viewfinder directly above the lens on top of the camera. Three screws hold the viewfinder in place.  Two on the top and one on the lens side of the camera. First, remove the screw in the bent corner of the viewfinder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DUsDMK1Yk36QcHZi.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10256">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yXRMtsIMnDkMBO35.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, remove the 2nd screw directly across from the bent corner.  It may be hidden in the space under the orange circuitry.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yXRMtsIMnDkMBO35.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10258">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EmHN1wZc1OVIdThP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lastly, remove the final screw directly under the left side of the viewfinder (on the lens side).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EmHN1wZc1OVIdThP.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10259">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jBZiqbKAxQG3OPFb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the three screws, the only thing still holding the viewfinder in place is a small plastic peg. Remove the viewfinder with a firm pull directly upwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jBZiqbKAxQG3OPFb.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

