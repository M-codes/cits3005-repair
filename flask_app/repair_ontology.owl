  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118230">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wmm1a1jUlChiwlrl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/e6fHJeSDSpyyt1Rj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WO6EAbqXbstfQ6VD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the battery is out, remove the gray button bar from the top of the camera with the smallest opening tool. With the gray bar detached from the camera, turn it upside down. Using the hex and the J000 bit remove the two 1mm screws. Take the needle nose tweezers to remove the power button.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wmm1a1jUlChiwlrl.standard">
