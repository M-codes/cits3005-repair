  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING: Pieces may become loose when you separate the device in half! Run the pry tool along the edges of the device to begin separating the device in two halves.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NLpZ1AKon51I5Js5.standard">
