  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate screen to upper vertical position. Remove the 8 (1.0 mm) black screws from the screen backing with Phillips screwdriver. Make sure to keep track of these 8 screws. They are very small and easy to get lost.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/riG4IlkuxfNWQyGc.standard">
