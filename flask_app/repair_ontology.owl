  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn camera upside down. Remove five 5 mm Phillips #000 head screws securing the backplate to the bottom of the camera. Grab the backplate and gently pull away from camera. The backplate will still be attached by the wires running to the LCD touchscreen. The screen will still be attached to the camera and won't be removed until step 10.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

