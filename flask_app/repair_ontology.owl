<owl:NamedIndividual rdf:about="#Step_67308">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove ribbon cable, gently lift the black tab with a flat head screwdriver.  Lift from the top of the camera towards the bottom. This releases the cable. Be gentle, as the cables are fragile.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_60812">
  <rdf:type rdf:resource="#Step"/>
