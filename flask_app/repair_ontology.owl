  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TYdkuDZL4n4A3qIj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the plastic opening tool to gently remove the top cover from the camera. It is glued on, so you may need to work at it to get it to come off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

