<owl:NamedIndividual rdf:about="#Step_118300">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aiOyHYRhGCM4POJo.standard"/>
