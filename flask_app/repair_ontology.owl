  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T4Dsywxofr5GsZZM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the connection between the motherboard and LCD screen by pulling out the connector in the direction of the arrow.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

