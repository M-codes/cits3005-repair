  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the back panel of the screen, using a spudger or opening tool if necessary.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rRXYxyRcWedgmH61.standard">
