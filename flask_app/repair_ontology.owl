  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the following two Phillips screws from the side of the camera with the three connector ports with a Phillips head screwdriver: One 2.5mm screw One 3.3mm screw Pull the metal shield away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</has_order>
</owl:NamedIndividual>

