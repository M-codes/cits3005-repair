  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the black ZIF connector located directly below the lens. Use the flat end of the spudger to flip up the black tab on the ZIF connector and pull the ribbon cable straight out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

