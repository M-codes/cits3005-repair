<owl:NamedIndividual rdf:about="#Step_145237">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6GemHTC5HyR2WmJt.standard"/>
