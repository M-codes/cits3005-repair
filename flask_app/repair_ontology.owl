<owl:NamedIndividual rdf:about="#Step_112818">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qclPyZSUwxXbbAHK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eG3N5cpkW6IWj4Il.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the eye piece by firmly pushing  straight up. The eye piece will slide right off. Remove the 3.4 mm Phillips #PH00 screw, that appears after removing the eye piece, using a PH00 screw driver. Remove the two 9.9 mm Phillips #PH00 screws using the PH00 screwdriver once again.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

