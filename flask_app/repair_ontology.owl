  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 4 screws from the bottom of the camera All silver screws go into the side of the camera that is silver All black screws go into the side of the camera that is black</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

