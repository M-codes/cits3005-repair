  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the edge of a coin to twist open the battery compartment on the bottom of the camera. (Twist counterclockwise)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

