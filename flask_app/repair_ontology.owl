</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96915">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/f6i3tdvUUXnoLINN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take out two silver Phillips #00 5.0 mm screws on each side of the viewfinder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/f6i3tdvUUXnoLINN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96916">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cIYXXUvkujBKtNDR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the flash and take out the silver Phillips #00 4.0 mm screw underneath it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cIYXXUvkujBKtNDR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96917">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DLHyGNjcFEq5m3PZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the back-cover of the camera using the back-cover release found on the lower right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DLHyGNjcFEq5m3PZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96922">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/A2qhfFlIvhsOmSGT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black Phillips #00 4.0 mm screw from the inside top right section of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/A2qhfFlIvhsOmSGT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96918">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2mJfMfdcd5kUaU6T.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black Phillips #00 5.0 mm screw from the back of the film compartment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2mJfMfdcd5kUaU6T.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97931">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gaAUs6j1ywuDQ25r.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RtQELaDOuIUoFfXM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the seven black Phillips #00 5.0 mm screws from the bottom panel. The bottom panel is now free to come off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/gaAUs6j1ywuDQ25r.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RtQELaDOuIUoFfXM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96914">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QmgPsSXcZyBZkXWC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take out two black Phillips #00 2.5 mm screws on the right side panel of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QmgPsSXcZyBZkXWC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96919">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_metal_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/B3I3AwqkhpVMS3l3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kJHfb1PVEWmdbGXl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uWDcYFWAHEGCfxgV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting beneath the "SPOT" button, use the round side of the metal spudger and firmly pry underneath the grey top panel of the camera. Work your way counterclockwise around the camera prying at different spots until the top panel starts to come loose. Pry all the way around until you reach the "STsi" logo. This prying will not completely release the top cover. It is also necessary to take off the side panel, as explained in the next step.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/B3I3AwqkhpVMS3l3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kJHfb1PVEWmdbGXl.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uWDcYFWAHEGCfxgV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97930">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YKCaqrNWuGWp2gsV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FSmukF2RNuEgR3rn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be careful when removing the right side panel. There is a plastic component underneath the side panel that will come free. Note the orientation of this plastic component for reassembly because it is connected to the back-cover release switch. Also be gentle when removing the top panel because it is delicate and is connected by wires. Carefully remove the right side panel by grasping it at the bottom and rotating is counter-clockwise. The top panel is now free to snap off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YKCaqrNWuGWp2gsV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FSmukF2RNuEgR3rn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_42078">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_screwdriver"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_step rdf:resource="#Step_96932"/>
  <has_step rdf:resource="#Step_96935"/>
  <has_step rdf:resource="#Step_96937"/>
  <has_step rdf:resource="#Step_96939"/>
  <has_step rdf:resource="#Step_96940"/>
  <has_step rdf:resource="#Step_96941"/>
  <has_step rdf:resource="#Step_96962"/>
  <has_step rdf:resource="#Step_96963"/>
  <has_step rdf:resource="#Step_96966"/>
  <has_step rdf:resource="#Step_96967"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Panasonic SDR H-100 HDD Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96962">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3SnGgGVI3b6Gmu4C.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the casing with the HDD, unscrew the two silver 4 mm screws on the upper interior.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3SnGgGVI3b6Gmu4C.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96963">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1lJcmFOoK3FIpdgD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the plastic black brace where the screws were attached gently with your hand to gain access to the HDD (The black brace will be able to come apart from the camcorder).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1lJcmFOoK3FIpdgD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96966">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OWPlyjsK4W33D3GD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry under the HDD gently with the blue opening tool and the HDD should easily come out of the casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OWPlyjsK4W33D3GD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96967">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mUA1Em1LIGsSc3KM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The HDD is now out (The HDD is ready to be replaced).</has_title>
