  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the four 6 millimeter screws with the Phillips screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tjEwI2jmMqilWueQ.standard">
