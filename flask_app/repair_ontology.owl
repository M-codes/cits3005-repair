<owl:NamedIndividual rdf:about="#Step_139352">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_phillips_screwdriver_j000"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nQyWiPKObBsXXmpL.standard"/>
