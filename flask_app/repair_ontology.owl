  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AHkRkx1kGrm5JHAB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open battery door by sliding sideways and flipping outward. Be careful so as not to break any components, Damage to an internal part could have affected the sliding mechanism so don't force anything open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

