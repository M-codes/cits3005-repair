  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the LCD screen away from the top of the device to reveal the ribbon cable. This is water damage the has afflicted the camera. Remove the 3 screws from the LCD screen holder. Pry the screen holder from the circuit board connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
