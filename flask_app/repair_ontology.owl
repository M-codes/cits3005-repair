  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[https://www.ifixit.com/Guide/How+To+Solder+and+Desolder+Connections/750|Desolder] five wires connected to the  camera motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eBLF1gBZSdWkRawm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_134581">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SOOV2k2DNUo2yYqq.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hJXZmtNKluvOsIEP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tip of a spudger or your fingernail to flip up the small retaining flaps on the five ZIF connectors on the motherboard. Be sure you are prying up on the hinged retaining flap, not the connector itself. Detach the five ribbon cables from the camera motherboard. The white line on the ribbon cables mark the edge of the connection area. To reinstall, insert the cables into the connector up to this line, and then close the retaining flap. If a cable doesn’t insert easily up to (or very near to) this line, it’s probably misaligned and needs to be gently removed and repositioned.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SOOV2k2DNUo2yYqq.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hJXZmtNKluvOsIEP.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_134582">
  <rdf:type rdf:resource="#Step"/>
