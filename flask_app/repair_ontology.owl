<owl:NamedIndividual rdf:about="#Step_97045">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5QvTPumPQHliOs54.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dak5BBX4EdtdrSuT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Lr6ZP5wH2WXE5YGc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the LCD screen panel, the battery compartment door, and the 'A/V Out Digital" flap are all open. Using your fingers, carefully pry off the back encasement (you may need to use a plastic opening tool to help you). Do not remove the back casing too far or too quickly. There is a wire ribbon attaching the back encasement to the motherboard that is very delicate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5QvTPumPQHliOs54.standard">
