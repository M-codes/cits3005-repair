  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BBC46DSkXE2chl5H.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_25946">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XZbXPoKfJfmcOeKN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ndlQK5QfmHAJGKjG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MWWjUkluRo2cigTG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now the camera body is loose. gently lift the rear of the case to remove it from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XZbXPoKfJfmcOeKN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

