</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_147492">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vtlPFsXOYfmgTKwj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XFpGmJZ1qi34Dud4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YxfSKYXPsnSRTS3o.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two, 2mm screws from the top of the screen. Using the J000 screwdriver. Remove the 3, 5mm screws on either side of the camera. continue to use the same screwdriver from step 1.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vtlPFsXOYfmgTKwj.standard">
