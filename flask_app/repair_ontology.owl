  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XGCRoCeF6qeCpSSV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black 3.8 mm screw on the far left side using a Phillips #000 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XGCRoCeF6qeCpSSV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_120727">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DMhfeasWuoxQ1TyY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/K6NW46UihXNqVO2N.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grip the left and right halves of the camera and wiggle them apart.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</has_order>
</owl:NamedIndividual>

