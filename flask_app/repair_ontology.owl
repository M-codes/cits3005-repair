  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the nylon spudger tool, peel back the metallic plate. A metal spudger is shown in the photo, but a nylon spudger should be used. Do not rip the gold-colored ribbons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
