  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81985">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/O4dBPHOFmTLX1CTt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the ribbon connector cable from the metal portion of the display.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/O4dBPHOFmTLX1CTt.standard">
