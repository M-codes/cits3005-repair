  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97312">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DdXajwfdrpIQrv2w.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KiUhDQUsvUmWHVrV.standard"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew four screws on the front right of the camera, where the orange motherboard is located. There are three black 5 millimeter screws and one silver 4 millimeter screw. The silver screw is located on the front right of the camera, and is attached to the main panel of the camera. Use the spudger tool to remove the cover over the LCD joint.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

