  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coolpix S01 The power button won't turn on Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118228">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LKBSXU5dYy2fXjnD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uNXjbH2BVvGEC3XM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sK1NsRl2iO3dHjxc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First make sure the camera is powered off. Then take the Hex and PH000 bit to remove a 2mm screw on the left side of the camera. Next, remove the 2mm screw on the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LKBSXU5dYy2fXjnD.standard">
