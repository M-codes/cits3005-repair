  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the opening tool, pop up the screen assembly. The screen is glued to the black cover. Use more force if needed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

