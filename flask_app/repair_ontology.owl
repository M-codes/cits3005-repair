  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two screws shown in first picture Unhook the first easy to access clip on the side of the lens body Unhook the second more obstructed hook. Be careful not to touch the capacitor's connectors (black round thingy), it might still be charged. If the two hooks are unhooked, the lens body can be lifted upwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

