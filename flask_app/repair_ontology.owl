  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera upside down and remove six 3mm PH00 Philips screws with a Philips screwdriver. On the thumb grip, remove the one 4mm PH00 Philips screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
