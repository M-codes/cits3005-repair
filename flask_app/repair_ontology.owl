  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loosen, but do not remove, the 4 screws on top of the flash shoe.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
