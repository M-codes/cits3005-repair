<owl:NamedIndividual rdf:about="#Step_97760">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PGHVNhvLAFxdZUWG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PZEwUbptpwN2KydM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew one silver 5 millimeter screw from the front right side of the camera, located where the orange mother board card is. Unplug the wire. Underneath will be another silver five millimeter screw. Using tweezer, release the clip attaching the main internal system to the main frame on the bottom of the camera. Allows the rest of the camera to be freely taken apart. The side panel will have cords running through the frame; unplug these and frame will be removable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

