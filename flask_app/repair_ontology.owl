<owl:NamedIndividual rdf:about="#Step_95542">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/A2Vj4q6nLKexMy1C.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ix4ecIkNT6vNyDLM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip up the little black tab on the connecter of the display's ribbon. '''Don't use a metal object for this step'''. A fingernail will do. Simply slide your fingernail under the lip and lift slowly. You may need to lift in different areas along the tab to get it all the way up. The top tab in the second picture is up while the bottom tab is down to show a comparison.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/A2Vj4q6nLKexMy1C.standard">
