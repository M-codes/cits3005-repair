</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ugWd4RwmLJUnMmrY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_36330">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eLFmRrfB2hDjJBgO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TSpsACvX3CE1rQGo.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tifMGLRhjsXT2ScT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fold the LCD from the top downward. DO NOT try to remove the LCD, it is still attached. Obviously this camera has had water damage. Remove the Kapton tape from the top of the camera. you will have to de-solder the battery frame on one point.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

