  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the flash assembly located on the right  side of the camera, remove the 1.8mm screw from the right side of the bracket that is holding the flash assembly in place. Swivel the bracket away from the body of the camera, and remove the remaining 1.8mm screw underneath.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

