  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tSCiPCE1OfyXIWot.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, use the spudger to remove the green ribbon from the attached ZIF connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

