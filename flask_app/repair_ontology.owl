  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera and remove the frame from the opposite side of the camera by pulling from either the top or the bottom in an outwards direction. As in the previous step, it may seem like you are breaking the camera, because the frame makes snapping noises, as you pull it apart.This is to be expected, and will not harm the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MZb1oMjLpKEnSANY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35297">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fwCs3UB4ZZrDshBy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two screws (4.08mm" Philips) that are indicated in the picture. Flip the camera 180 degrees and remove the corresponding screws on the opposite side of the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fwCs3UB4ZZrDshBy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35298">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kOL6fyaxKNHGZnce.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the backing of the camera from the side opposite the screen To make it easier for yourself, pull the screen outwards from the bottom of the camera, near the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kOL6fyaxKNHGZnce.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

