  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screw (3.5mm) near the sync button holding the opposite side of the camera on. Remove the second screw (3.5mm) on the back of the camera to remove the second housing. Once the screws are removed use an opening tool to pry back the second plastic mount.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
