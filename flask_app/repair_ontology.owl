  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grab the metal frame with the flash assembly that was removed from around the lens assembly. Remove the 2 mm screw on the circuit board using a Phillips #00 screwdriver. Lift and remove the circuit board from the flash assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42</has_order>
</owl:NamedIndividual>

