  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_123339">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m1UUaIFRY3JULUIe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fxg3ZPfm1KTVOEwL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jg4RkuSthod1iUcZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, lift the HDD from its right end, pivoting on its left end. The HDD ribbon wire is now exposed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/m1UUaIFRY3JULUIe.standard">
