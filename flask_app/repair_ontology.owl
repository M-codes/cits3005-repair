</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2qKTxGqWdfpqIrgR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_184508">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WFihWOKBtJMoK4yK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RhpMIliOIJnWxCQG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There is a small black clasp that holds the circuit ribbon in place. The LCD screen can be removed without undoing the clasp but will need to be put back in place when installing the new screen. Gripping the screen with your fingers, gently pull and wiggle back and fourth until the circuit ribbon detaches from the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

