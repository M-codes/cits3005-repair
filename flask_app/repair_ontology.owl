<owl:NamedIndividual rdf:about="#Step_164471">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/M5TZonUMLPgmayxj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NCKGCW5p5VOU5P33.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Looking at the left side, flip the top of the camera towards you to locate the top side of the camera. Take out the screw sized 9.75 mm, located on top side of the camera, with a Phillips #000 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/M5TZonUMLPgmayxj.standard">
