  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aKU4OIuZfeIktRPW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the flat edge of the spudger between the gold front casing and the black back casing. Pry the spudger upward until the black back casing snaps out and is dislodged on that edge of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

