  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OGCMoJbhKnNSjj2K.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 1.5 mm Phillips #00 screws from the bottom of the screen mount assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OGCMoJbhKnNSjj2K.standard">
