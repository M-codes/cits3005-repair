  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift off the capture button by wiggling it back and forth while pulling upward. Be careful not to damage the two clips.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

