  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fujifilm  FinePix Z90 Lens cover/case Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_magnetic_screw_collector">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118854">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_magnetic_screw_collector"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ffHFMLvYJecGA5K2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Le2pAlU2SklZwxxm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a small #000 Phillips screwdriver to take the screws out. Keep all the screws in a container and the two different types separate. Remove the two screws on the right side.On the same side there is USB connector, open that little door and unscrew the little screw inside of it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ffHFMLvYJecGA5K2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Le2pAlU2SklZwxxm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118855">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_magnetic_screw_collector"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xf5O3NhXvevssNyA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lItJLobvMDPiIkfW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the two screws on the left side and the two screws on the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xf5O3NhXvevssNyA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lItJLobvMDPiIkfW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118856">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IYLAQenBrjrfs2HA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BvZwXdT3dYKnrCmb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">By now you will have the front case and the back case separated from each other.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IYLAQenBrjrfs2HA.standard">
  <rdf:type rdf:resource="#Image"/>
