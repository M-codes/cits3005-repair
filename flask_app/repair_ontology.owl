  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With a flathead screwdriver, twist the metal washer counter-clockwise to remove it. Remove the washer underneath the advance lever in the same way. Keep these pieces separate. They look similar but are not interchangeable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

