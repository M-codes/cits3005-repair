  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_21461">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bAwhEu4pQh31nnCs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ViAETEnLYnUaXsJK.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lay front casing flat on surface as if you are looking through the camera lens. Remove the 4.3 mm silver screw in the upper right hand corner of the casing near the shutter and power button.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

