<owl:NamedIndividual rdf:about="#Step_97308">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6WyJZ4QPqVnGRwKD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QjkPHIXc2WKAol3E.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SvNDhI1sTeTNvtot.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the Phillips Head #00 size screwdriver, unscrew the two 5 millimeter screws located on the top left and bottom of the join attaching LCD screen to the device. Using the same size screw driver  unscrew the 3 millimeter screw located in the middle of the joint assembly; attaching the LCD screen to the device. Next, unscrew the two five millimeter screws located on the left interface of the camera that the LCD screen rests on. (Should be located where the USB jacks are.) Locate the battery assembly, on the top of the camera and unscrew three screws; two 5 millimeter screws and one 3 millimeter.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6WyJZ4QPqVnGRwKD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QjkPHIXc2WKAol3E.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SvNDhI1sTeTNvtot.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97884">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FWmd6LTabuXJMT3W.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the bottom of the camera unscrew all 5 five millimeter screws from the bottom panel. This step will remove the bottom panel covering the internal motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FWmd6LTabuXJMT3W.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97310">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VodXvdQWE1l2UOdp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dEkLXI6XiGkXTpQe.standard"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Underneath the handle unscrew the two 5 millimeter screws. Using the spudger tool, remove the cover for the recording buttons. This should remove the small panel located over the recording buttons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VodXvdQWE1l2UOdp.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

