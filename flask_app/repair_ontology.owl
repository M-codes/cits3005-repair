  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the lens over On the back are four screws. Remove the two silver phillips screws (4.36 mm) from the back of the lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Rg5vYLBfYNr1hRZo.standard">
