  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tweezers to disengage the yellow and red wires from the camera body. Some variations of this camera may not have unplugable wires. Make sure to take note of which cable goes where if you decide to remove the solder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

