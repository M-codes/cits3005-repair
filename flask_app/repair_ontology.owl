  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/R4dLwLMcU1p52DrR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully pull the bottom cover to separate it from the body of the D70. Remove the bottom cover from the D70.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

