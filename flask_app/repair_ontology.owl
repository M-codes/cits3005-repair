  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the audio/video inputs underneath the microphone assembly. The inputs should still be connected to the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

