  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the 2 connection ribbons attaching the lens to the circuit board. Using a plastic opening tool or finger nail, gently lift the ZIF connector flaps up. The connectors are hinged and will fold up and away from the ribbon, do not disconnect completely.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

