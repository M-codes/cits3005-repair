<owl:NamedIndividual rdf:about="#Step_128747">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KG3Fe4FNRQMAyGaw.standard"/>
