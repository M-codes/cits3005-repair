  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you should be able to remove the flash unit from the camera. When removing the flash, be careful when handling the capacitor. It may contain a powerful charge. Discharge may result in damage and personal injury.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
