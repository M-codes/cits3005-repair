  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your fingers, manually pop open the USB cover, labeled as “A/V OUT DIGITAL.” This is located on the side of the camera (refer to picture). Gently pull the tab of the side cover and completely detach it from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

