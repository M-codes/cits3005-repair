  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove both the top and bottom copper strips by gently pulling them off with the tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

