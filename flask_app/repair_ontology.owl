<owl:NamedIndividual rdf:about="#Step_96836">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZhPSdIpKrJVpSgkO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black Phillips #00 5mm screw at the bottom of the battery chamber. If it is too dark to see the screw, it may help to use a flashlight.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZhPSdIpKrJVpSgkO.standard">
