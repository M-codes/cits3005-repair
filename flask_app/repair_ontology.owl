  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_155324">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/25CJHnEI55ldYOPI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/G4Jp36hf3sDNyUtB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mCpv2K4ZOgcgyJFJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the plastic opening tool into the seam where the front and back parts of the case meet on the bottom of the camera, and slide it along the bottom. Continue along the next side to separate the back part of the case. If necessary, continue along the third and fourth sides until the case separates easily. Lift the back off of the case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

