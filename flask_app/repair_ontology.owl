</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/h1ZfkKOtk2dyND15.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_38453">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/N5L2IdRvAN1Pxjbi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the new screen. The ribbon will already be attached.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/N5L2IdRvAN1Pxjbi.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_38454">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/S6rilXNQSogOMgvf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Warning:'''  The ribbon and black bar are fragile. You will want to be very delicate with it. It will be difficult to insert. Insert the ribbon into the white socket. You will have to hold this ribbon in place while placing the black bar back into the socket. You may need assistance with this part of the step.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/S6rilXNQSogOMgvf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

