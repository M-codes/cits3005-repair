<owl:NamedIndividual rdf:about="#Step_10102">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/K4lauHMNIcQxoxxM.standard"/>
