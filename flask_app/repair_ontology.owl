  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85787">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ipKKRcQUhHSXIj54.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cUhMwCkhTHUBTXYV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yLsfCci6JY1EKo1w.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly and gently pry open with your hands to separate the back case panel from the rest of the camera. The gray rubber cover labeled DC IN DIGITAL A/V OUT may fall out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

