<owl:NamedIndividual rdf:about="#Step_121007">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BRVseGQ5VUyjGoZi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not yank out the electronic ribbons attached to the motherboard, or you may damage them. To properly detach these ZIF connector ribbons, see [https://www.ifixit.com/Guide/Recognizing+%26+Disconnecting+Cable+Connectors/25629#s64969|this technique on disconnecting ZIF connectors]. Pull to disconnect from the motherboard the seven ZIF connector ribbons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
