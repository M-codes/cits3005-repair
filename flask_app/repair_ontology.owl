<owl:NamedIndividual rdf:about="#Step_120728">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MDNJMs4g4ZG6WG1F.standard"/>
