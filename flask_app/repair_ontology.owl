  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the secondary battery, reposition the camera to where the display screen is facing upwards. Place your finger inside the empty battery compartment and pull away from the camera on the ridged battery tab.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

