<owl:NamedIndividual rdf:about="#Step_88963">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aPtZbJpBdM53Xvax.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2BhqrNoqBRLUFnp6.standard"/>
