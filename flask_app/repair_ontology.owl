  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove outer camera frames by carefully pulling the frame apart from the body of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/iGHqDVY6a5lLcYt1.standard">
