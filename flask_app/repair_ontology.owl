  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ribbon wire connects the inside of the top panel to the body of the camera. Slowly lift the top panel to about an inch above the body of the camera. Carefully use the flat end of the spudger to detach the ribbon wire from the top of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

