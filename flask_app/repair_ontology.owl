  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OrjVOmqAJtWTGrde.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Q6qqLEOYvqyWrJSk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the screen with monitor side out. You may have to hold this in place until covers are back on properly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OrjVOmqAJtWTGrde.standard">
