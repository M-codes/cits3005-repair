  <has_tool rdf:resource="#Tool_spudger"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD screen should now only be attached by two LCD data cables. Lift the screen from the left side and use a spudger or a small flat head screwdriver to flip the black portion of the connector upward to unlock it. Carefully slide the data cable out of the connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hX4wQBYwJAPMxTvK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_18950">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dBwFjMfTWtVLGtnk.standard"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD should still be connected by the backlight cable. To remove the backlight cable, use a spudger or a small flat head screwdriver to unlock the backlight cable. Carefully slide out the backlight cable. The LCD screen can now be fully detached from the camera body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

