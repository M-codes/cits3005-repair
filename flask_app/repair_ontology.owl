  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, remove the ribbon strip by pulling on it. This will remove the connection. Push down on the three wires with the metal spudger and the clip will disconnect from the motherboard. During reassembly, remove the black tape on the ribbon cable, turn the camera upside down so you can see the port, and reinsert the cable with tweezers. It's a lot easier!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

