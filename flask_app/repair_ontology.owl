  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OrqayvJeqgIZEtmh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the screen away from the backing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OrqayvJeqgIZEtmh.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_64234">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AiK66n3uMgUKwJ22.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mCrvmC2PqJXhFRAT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peel away the large rectangular black sheet with the tweezers. Rotate the sheet so it is to the opposite side of the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AiK66n3uMgUKwJ22.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

