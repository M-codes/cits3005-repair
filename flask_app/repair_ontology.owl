  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HjWhFj6X4KNFddLv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KkplcFuUrSsnlSNQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Osi42IlOtlbk1dAg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the camera by removing the 5 external 4.0 mm screws with the 1.0 flathead.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

