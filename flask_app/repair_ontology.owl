</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125709">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qfuoXDfNgtcDnOnQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lB3Vlls1Y5aUcMgS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jixywaunjW6HgbBg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tweezers. Move the thick red cable, attached to the secondary board, outside of its place in the camera housing. Gently pull on the red/black wire in order to free the photo lens cylinder from the housing. Remove the secondary board from its position and move it upward, out of the way. From this point on, do not damage the connection between the motherboard and the secondary board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

