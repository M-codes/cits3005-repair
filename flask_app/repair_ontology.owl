</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_114547">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_magnetic_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MZh1J3w2fOydOlZF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/X1sabFiQ3KI6KVkX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a Phillips screwdriver to unscrew the two 5.556 mm screws under the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MZh1J3w2fOydOlZF.standard">
