  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Look at the camera from the side with the lanyard and 4 screws. Remove the two 3.4 mm screws on the metallic colored part.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EUrNU1GdHJq1Mraq.standard">
