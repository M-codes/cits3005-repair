<owl:NamedIndividual rdf:about="#Step_165006">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IWDvFPsogpgNFSZc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips #0 screwdriver, remove the six 6mm screws. The seventh screw in the bottom middle is not connected to the motherboard and does not need to be removed. As you remove the screws, hold on to the motherboard to prevent it from falling and sustaining damage.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

