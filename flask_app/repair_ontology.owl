<owl:NamedIndividual rdf:about="#Step_85427">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TYAOCeU6QZXBq2Yd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fU5LLINg2wRKUBnp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IE1s5MpvHEsoMB3t.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the LCD screen off the unit it is time to work on the rest of the screws. Face the camera with the viewfinder towards you. Remove the five 5 MM Phillips #1 screws circled here. Flip the camera where the bottom faces toward you. Remove the four circled 5 MM Phillips #1 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TYAOCeU6QZXBq2Yd.standard">
