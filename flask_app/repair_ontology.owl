  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the control dial from the motherboard. Locate the ZIF connector for the control dial. Use  tweezers or screwdrivers to lift up on the retaining flap to remove the ribbon cable. The connector ribbons are prone to tearing so use care during removal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

