  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VEalkjR6a6C6uAiR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Using the tip of the tweezers, press on the latching mechanisms one at a time to free the flash housing piece.''' '''Once the flash housing piece is free gently pull up to remove.''' '''Note''': You may have to wiggle the flash housing back and forth to free the circuit board located on the bottom of the flash housing</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VEalkjR6a6C6uAiR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_29654">
