  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn your camera so that the bottom is facing you. Remove the 5mm Phillips #000 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
