  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the wrist strap attachment. Use the spudger to pry it open. Remove the small circular cover underneath the wrist strap attachment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2wgKgSWKJAnU5JF2.standard">
