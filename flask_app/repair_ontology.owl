  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert a plastic opening tool in the gap between the camera body and back panel. Pry along the right side of the camera to separate the back panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
