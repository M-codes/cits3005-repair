  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove six 3 mm x 5.5 mm Phillips head screws from around the lens ring and remove the lens ring. Remove two 2.5 mm x 4 mm Phillips head screws from above the lens ring to allow the front of the camera to be removed. Lift and remove the grip and the front panel of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

