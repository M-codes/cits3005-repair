  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all screws listed below using a Phillips #000 Screwdriver: Remove the two 3.4 mm screws at the bottom of the silver plate. Peel back the clear strip to reveal a  2.8 mm screw on the left of the silver plate and remove it. Peel back the copper plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

