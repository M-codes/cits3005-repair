  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Philips 000 screwdriver, remove the 5-(2.7mm long) screws  from the silver plate  that the lens is mounted to on the back (screen side) of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</has_order>
