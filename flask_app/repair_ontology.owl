  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the display screen and remove the three 5mm Phillips #00 screws. Look to the swivel point for the screen to find the last two 5mm Phillips #00 screws that must be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KG3Fe4FNRQMAyGaw.standard">
