  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the other two screws on the opposite side of the panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cmCjBXsCiKr54hGs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81980">
