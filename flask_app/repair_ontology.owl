  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 6.4mm screw from the inside of the flash bezel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/I2WKBTpYSkLOOlDL.standard">
  <rdf:type rdf:resource="#Image"/>
