  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the five screws on the bottom of the camera with a JIS #000 head screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pya2ByPY3yFShbBb.standard">
