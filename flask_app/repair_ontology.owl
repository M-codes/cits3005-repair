</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85776">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qAJsUhciMuEjNGVc.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cqlNlNtkJ5cCy4kW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WVYLhWHQm2hPNNqW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unsolder all of the wires attached to the motherboard and move them aside with the tweezers. Be observant of where you are soldering because you can easily disrupt the power distribution.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qAJsUhciMuEjNGVc.standard">
