  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The battery connections are reinforced by black potting compound. Gently pry it away with a plastic spudger. Be very careful with this step, as applying too much force can damage the motherboard or the components on it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

