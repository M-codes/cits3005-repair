  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stand the camera back up. Remove the two 3.6mm screws on the side with the A/V Out port.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5deMqk4XUCV1YxLK.standard">
