<owl:NamedIndividual rdf:about="#Step_89404">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UmmXsKjdAceT4qAA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a #000 Phillips screwdriver, remove the 6.0 mm screw on the bottom left hand corner. You can locate the screw on the picture as the green circle.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UmmXsKjdAceT4qAA.standard">
