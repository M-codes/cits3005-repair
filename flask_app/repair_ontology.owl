  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NymkRvSBBQcJBWPY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sever motor connection to motherboard and remove wire carefully. Optional: Use electrical adhesive to prevent dislodging of new  wired connection. The regular black nylon spudger should be used whenever possible, especially around sensitive internal components.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

