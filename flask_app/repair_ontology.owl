<owl:NamedIndividual rdf:about="#Step_120232">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wsR6MLVbNDtmuJN4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once you have the battery compartment open, slide the orange tab away from the battery until it ejects.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wsR6MLVbNDtmuJN4.standard">
