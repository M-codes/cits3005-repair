  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_156940">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4CHFgHswWFfvoWsI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4J3I612NJ5U5ynW1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the hinged connectors folded up and out of the way, carefully pull the ribbons out of their connectors. These are the only 2 connectors holding the lens assembly in place. If disconnected the lens assembly will be completely detached from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4CHFgHswWFfvoWsI.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4J3I612NJ5U5ynW1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_156941">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DcRJgINU5H6TWOVg.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fCfxXKrPs2PllahA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gGVafDgKyfQEgS1g.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Firmly grasp the camera body in your right hand and grab the lens assembly with your other hand. Gently pull the lens assembly directly up and out of the camera body. There are no further screws or connections hold the lens assembly in place. If it does not remove easily check your previous steps.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

