</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_197049">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YNQaeSpFlPQrUDVT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1QghQ3OnYx3lJcAv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the silver 2mm screw on the protection panel. Remove the three black 8mm screws that remain. Be sure to remember which length of screw goes to which slot. Failing to do so could damage your device. Proceed to remove the protection panel entirely.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

