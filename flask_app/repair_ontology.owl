  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oskuTiCnnWoPrrjp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two clearly visible screws from the control dial The dial should come off easily</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
