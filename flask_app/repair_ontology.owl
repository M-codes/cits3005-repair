  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the cable strap bracket by lifting it away.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6ugHcwLaNpKI1mvq.standard">
