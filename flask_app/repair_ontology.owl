  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently unplug the ribbon cable with your tweezers. '''Be careful not to rip it.'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

