  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the single 3.4mm screw on the left side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qJlCBUGDDkNUcLJr.standard">
  <rdf:type rdf:resource="#Image"/>
