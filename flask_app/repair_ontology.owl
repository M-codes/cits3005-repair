<owl:NamedIndividual rdf:about="#Step_85491">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FwZZYavFtxLeuVw6.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aVG22SKgtXZkYNTc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To begin, the LCD screen must be removed. Bring the LCD screen to the fully open position. Remove the three 5 MM Phillips #1 screws on the front of the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FwZZYavFtxLeuVw6.standard">
