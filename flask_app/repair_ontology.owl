<owl:NamedIndividual rdf:about="#Step_83625">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nq63vPgAGKoDWnor.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vmYGA5xBrMJEIc4M.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The first set of screws you should remove are found on the right side of the camera, when the LCD screen is facing you. Grab your Phillips #00 screw driver from your tool kit. Use this screw driver to remove the two screws located on the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nq63vPgAGKoDWnor.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vmYGA5xBrMJEIc4M.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83626">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QBDD6WLhCqVCoVCv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Gp33mE5wxGfcRDhH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5lPpKSgQP3VUpMx1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now flip your camera over so that the bottom of the camera is facing up. Notice that there are three screws. Grab your Phillips #00 screwdriver from the tool kit. Use this screwdriver to remove the three screws on the bottom. Grab your plastic opening tool and stick it in between any crack to lift the cover containing the patent information off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QBDD6WLhCqVCoVCv.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Gp33mE5wxGfcRDhH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5lPpKSgQP3VUpMx1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83627">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/D1KXXUSud5EaJhcW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KTGjKPRvuxHrUkoD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, with the same plastic opening tool, stick it in the crack between the metal circle and the black piece on the left, in order for it to be removed. Once you slide the plastic opening tool in between the crack, slide the black cover and lift in order for it to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/D1KXXUSud5EaJhcW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KTGjKPRvuxHrUkoD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83628">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ojKVUyUl2vpmheah.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5HjsAXMgV3Se2iCm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/x2frcYdiHyNrcelX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The first picture shows how the left side of the camera looks once we remove the side piece. Notice that there are now two screws that need to be removed. Grab your Phillips #00 screwdriver and remove the two screws. Now grab the plastic opening tool. Flip your camera to the right side where we removed the first two screws. Slide the tool into the crack and lift in order to loosen that side of the shell. Loosening one side makes removing the entire shell easier.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ojKVUyUl2vpmheah.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5HjsAXMgV3Se2iCm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/x2frcYdiHyNrcelX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83629">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eXyCVVIIxXM4gCUx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1CebPpKuNJXJjrtM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the side is loose, apply a small amount of force to remove the shell. Make sure to push each side off individually so that you do not break any piece of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eXyCVVIIxXM4gCUx.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1CebPpKuNJXJjrtM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83630">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rJTY1ovHRR5NOBbc.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oRdBNqr1ZGRUKKQv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NnlpDqARQhtNbWqs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After you remove the outer shell, you will see that the green chip, also known as the motherboard, is now exposed. Carefully grab the motherboard and proceed to flip it over. Grab the ribbon that connects the motherboard to the camera. Grip the ribbon wire as close to the white piece as possible. Slightly pull it to disconnect the ribbon wire.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rJTY1ovHRR5NOBbc.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oRdBNqr1ZGRUKKQv.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NnlpDqARQhtNbWqs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83632">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/F3Y2eiUHPXDwPZNR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3Im2iMwHptKfghqF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kHLRsJBG6hQHVCwC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In order to remove the LCD screen we must detach the metal frame that connects the screen to the camera. Pull the metal frame from left to right. As you move towards the right, you will notice on the right end, the screen is attached by a ribbon wire. This may be the most challenging step. Slowly remove the metal frame, and eventually it will pop off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/F3Y2eiUHPXDwPZNR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3Im2iMwHptKfghqF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kHLRsJBG6hQHVCwC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83633">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WB1K4WckuQk6enZE.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2LUab5LGMdkGUFGl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gLvgLvdXUCQuJpsV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the metal screen over, so that the screen is facing down. You will see a small black clip on the white connector that will allow you to remove the ribbon wire. Carefully lift the black clip and slide the ribbon wire out. The LCD Screen should now be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/WB1K4WckuQk6enZE.standard">
