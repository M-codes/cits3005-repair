  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6iOkc46XvlRmwTeU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the top control panel (connected to the flash battery) from the camera. The top control panel is connected to the rest of the camera by a delicate multi-pin plug. Be careful as to not bend the pins!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

