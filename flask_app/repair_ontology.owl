  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HSaPRJt4KZbDuJ2Q.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3 (3.10 mm) screws that are located on the back of the lens cover.</has_title>
