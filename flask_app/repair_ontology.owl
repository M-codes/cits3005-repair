<owl:NamedIndividual rdf:about="#Step_95549">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WQZvE3CURGLMvijj.standard"/>
