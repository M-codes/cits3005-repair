  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_54496"/>
  <has_procedure rdf:resource="#Procedure_54718"/>
  <has_procedure rdf:resource="#Procedure_54743"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_54496">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_step rdf:resource="#Step_119348"/>
  <has_step rdf:resource="#Step_119347"/>
  <has_step rdf:resource="#Step_119349"/>
  <has_step rdf:resource="#Step_119350"/>
  <has_step rdf:resource="#Step_119351"/>
  <has_step rdf:resource="#Step_119352"/>
  <has_step rdf:resource="#Step_119353"/>
