<owl:NamedIndividual rdf:about="#Step_36328">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2UTOj6UroAX1PKC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/McXJofFmywqLQlXF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ugWd4RwmLJUnMmrY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the battery compartment and start carefully to separate the front and back half of the camera. On this camera the front half will come of first. In the top left corner is one screw that will have to be removed. It holds the back cover to the body of the camera. Once that screw is removed, the camera separates easy.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2UTOj6UroAX1PKC.standard">
