  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not proceed to the next step unless you have previous soldering experience because you can damage the motherboard if you are not careful. Unsolder any remaining wires on the motherboard to completely remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</has_order>
</owl:NamedIndividual>

