  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The circuit board will still be connected to the body of the camera by two pairs of cords. Gently lift the circuit board away from the camera and turn it over. Use tweezers to disconnect the final two plugs and completely remove the circuit board from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
