<owl:NamedIndividual rdf:about="#Step_185897">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PPb3p1IidYLQ2auS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QYDUTEVKHElv5TiV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips #000 screwdriver, remove the three bottom screws connected to the back plate on the bottom of the device. Remove the screws under the flaps covering the HDMI and mini USB ports.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PPb3p1IidYLQ2auS.standard">
  <rdf:type rdf:resource="#Image"/>
