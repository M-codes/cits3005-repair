  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4x3mm on the opposite side near the selector wheel. Remove the 2x2mm and 3x2mm screws underneath the a/v flap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
