  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4 mm black screw on the bottom right corner of the mother board. The black screw may be hard to remove. Use the tweezers if necessary.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
