<owl:NamedIndividual rdf:about="#Step_118229">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hQ1yNNuAM2GItn54.standard"/>
