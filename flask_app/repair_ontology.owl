<owl:NamedIndividual rdf:about="#Step_10366">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QyvbtBNrhmpvNV4n.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iMZNE3iEHhNiYuFm.standard"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingernail to flip up the ZIF locking flap on the LCD ribbon cable socket. Be sure you are opening the locking tab, not pulling against the socket mounted to the board. Pull the LCD board ribbon cable out of its socket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
