  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qeGwqV3PeFKSABLA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the outer frame of the camera by unscrewing the screws around its sides with a JIS J000 screwdriver. 3.2mm screws (not fully threaded) 3mm screws 4.2mm screws (coarser thread)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LNjXoHltBh6m6GPc.standard">
