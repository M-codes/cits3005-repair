<owl:NamedIndividual rdf:about="#Step_120851">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heavy-duty_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MwgGZodkgeBSQ4Va.standard"/>
