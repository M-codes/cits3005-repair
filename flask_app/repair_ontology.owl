  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4.3mm screw below the camera strap ring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

