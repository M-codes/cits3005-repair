<owl:NamedIndividual rdf:about="#Step_84748">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JHLINlf1JtbpokXD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dNJMebRDgyjkHhLS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the camera on to the side that has the image stabilizer label. Remove the 5.00 mm screws that are on this side using the screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JHLINlf1JtbpokXD.standard">
