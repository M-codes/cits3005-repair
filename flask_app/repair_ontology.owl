  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OnWdSq1ef45PHFXB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the following eight screws securing the bottom cover to the D70: Six 5.8 mm Phillips screws One 10.7 mm Phillips screws One 8.2 mm Phillips screws</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OnWdSq1ef45PHFXB.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10343">
  <rdf:type rdf:resource="#Step"/>
