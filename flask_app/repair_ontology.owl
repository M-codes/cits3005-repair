  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew all 16 screws around the back plate of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tPpM1IocSfwUMHwi.standard">
