  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With a screwdriver, remove the (7) black Phillips #00 5.0mm screws on the bottom of the camera. The screws are located on the outer edge of the bottom panel. Be careful when removing the screws from the panel because they are easy to lose.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

