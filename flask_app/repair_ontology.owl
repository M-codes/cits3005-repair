  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2 screws inside the camera on the back corners.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HJdsbtTj1leoNgYg.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198182">
