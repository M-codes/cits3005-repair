<owl:NamedIndividual rdf:about="#Step_118302">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_precision_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cxkdTdRNNfyuMDfg.standard"/>
