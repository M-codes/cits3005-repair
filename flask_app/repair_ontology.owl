  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oEmNZFoshWbRZvr1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that all screws are removed, gently pull off the back cover of the camera. This is done by pulling the cover back. There is an orange wire connected to the motherboard of the camera. When the back cover is removed, gently pull the wire up and off of the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oEmNZFoshWbRZvr1.standard">
