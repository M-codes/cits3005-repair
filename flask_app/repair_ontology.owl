  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a Phillips #000 screwdriver to remove the two 4.5 mm screws. Use a Phillips #000 screwdriver to remove the 2.5 mm screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3Qx1hNYMbZE2os4e.standard">
