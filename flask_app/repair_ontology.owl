  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Tl3oMYYqHJ1p2Ide.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orient the device so that the LCD is facing you ("back view").</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Tl3oMYYqHJ1p2Ide.standard">
