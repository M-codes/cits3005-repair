  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grip the sides of the top cover and gently lift the cover until it detaches from the camera. Do not completely remove the top cover; an orange ribbon cable still connects it to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
