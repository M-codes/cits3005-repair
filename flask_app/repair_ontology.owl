  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iTZtDdRBSGFtXpLy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once you have the face plate removed the first thing to do is pry off the slider (the light grey bar near the bottom). The easiest way to accomplish this is to place the tweezers where the red circles are to pop the piece out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

