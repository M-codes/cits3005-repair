  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift LCD display off. There will be two data cables still attached to the camera. Do not break them. There may be a loose strip of metal along the inner side of the LCD display for a secure fit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
