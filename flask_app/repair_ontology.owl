  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CQqCWeGKwS13kCYG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once you have revealed the ribbon cable, gently let the top cover hang off the front of the camera. Use the plastic opening tool to gently pull the white tabs on the ribbon cable, releasing the ribbon cable. If you pull the white tabs all the way out, just insert them back in to avoid losing them.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CQqCWeGKwS13kCYG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

