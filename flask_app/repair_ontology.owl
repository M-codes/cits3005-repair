  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 4 screws from the right side of the camera. There are two 3.4mm screws at the top. There are two 2.2mm screws at the bottom.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/V6rd2QEIRGfAYJRJ.standard">
