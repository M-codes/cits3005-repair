  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZvD1ATLKgxS2FTOZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While pulling the bottom down, remove the back of the camera. Be careful not to pull too hard on the back as it is connected via a ribbon cable. Be sure to disconnect this cable on the main board. To disconnect the ribbon cable pull the small black tab upward and pull gently on the cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

