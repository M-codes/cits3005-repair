</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_10460">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jdaxAQJZrA4FB6N6.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZFSSvfX2EycQPPvL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting with the bottom-left corner (below the screen), lift the flex assembly away from the camera chassis.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

