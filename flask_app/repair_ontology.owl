  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cAOn5BtvwnZbttaX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the front camera case in order to access the remaining ribbons: Slowly pry around the edges using a spudger. A circular ring pad will detach. Set this aside. You now have access to the logic ribbons on the front of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4cWXUVIa2ImuqoNV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TEWGRZusKhQKSE6v.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cAOn5BtvwnZbttaX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_100314">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/arI2SMmqYoNJRQCt.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JFtDN1Tt1AYE3eX2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/A5sGRQJFPHnxWQW1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the spudger, flip the small tab that is holding down the logic ribbon located at the top left corner. Flip the larger tab that is holding down the logic ribbon located directly to the right of the previous ribbon. Detach both ribbons from the circuit board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/arI2SMmqYoNJRQCt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

