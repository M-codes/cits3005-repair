  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the mic assembly by pulling it away from the camera base. Do not pull too hard as the wires are still connected.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/p1fxLu6mrxIkWFZL.standard">
