  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YCAWuWUgbNlNNbsD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_92989">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fBUq2bmHJGoVmVBm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the tabs at the end of both ribbons Disconnect each ribbon from the circuit board</has_title>
