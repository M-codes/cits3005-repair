  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wCYMaIahD1AEVZtQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the entire flash housing needs to be replaced... Unsolder the black and red wires from the back of the circuit board behind the flash.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

