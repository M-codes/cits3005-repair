  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly remove motherboard (and attached components) from the camera casing. Be careful not to disconnect the wires by pulling it too hard. Unscrew speaker bracket. Lift up copper speaker plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

