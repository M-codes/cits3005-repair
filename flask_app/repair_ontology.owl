  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two  Phillips #00 screws from the back of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BMVA4fMH3QqLHnha.standard">
  <rdf:type rdf:resource="#Image"/>
