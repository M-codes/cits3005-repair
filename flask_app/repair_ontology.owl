  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMZJokwo2JY3DHbq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the LCD ribbon cables and power cable from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMZJokwo2JY3DHbq.standard">
