<owl:NamedIndividual rdf:about="#Step_88912">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hrGVEfaVEPtekMiY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the small plastic pry tool lift the back of the camera off carefully. Be aware of a few flex cables that connect the mother board to the screen. Open the devices slowly and disconnect the flex cables. When the flex cables have been disconnected you can take the device apart.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hrGVEfaVEPtekMiY.standard">
