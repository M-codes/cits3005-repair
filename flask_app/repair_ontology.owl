  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4mm Phillips #00 screw on the inside of the flap that hides the battery and memory card slots. Remove the light grey, plastic piece. Remove the plastic portion of the battery flap cover. The metal piece will remain attached.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

