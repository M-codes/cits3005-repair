  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VpTdSQspOe42fnOO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all seven screws (4.1mm) from the metal plates (#000) Carefully lift out the lcd screen component from the camera casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

