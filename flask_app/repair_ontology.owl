  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/m2SYOXiy6eQ1QojB.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_54301">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LSBWX2f4nQpaTnvy.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/q2HQEcwaCEVWUPCy.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PgSTGGpnHyyUlhAo.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the lens assembly pulled out of the camera, grasp one of the ribbon cables and gently pull it out of the connector. Then grab the other ribbon cable and remove it. Now the lens assembly is detached from the camera and can be removed and replaced if necessary.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LSBWX2f4nQpaTnvy.standard">
