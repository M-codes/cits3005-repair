</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RmivkHVoZSgXSChN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35415">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bPnHGIhc6x6wo2FY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HdjELeVMNRCkHmPD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desolder the wire (both black and red) from the motherboard. Remove the orange ribbon cable.  This is done by sliding each side of the lock bar toward the center of the camera.  Gently pull on the ribbon cable to remove.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

