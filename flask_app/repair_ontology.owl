  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the "A/V Out Digital" charging station and lift up the flap. Remove the two Phillips #000 screws, length 5 mm, that are under the "A/V Out Digital" flap. Remove the one Phillips #000 screw, length 5 mm, that is outside the "A/V Out Digital" flap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

