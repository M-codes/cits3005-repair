</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_165347">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uGVA3tfBYBpuuCjQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 6 screws on the bottom panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uGVA3tfBYBpuuCjQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

