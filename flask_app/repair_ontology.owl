  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 5 mm screws that sit near the camera strap eyelet. Remove the camera strap eyelet.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

