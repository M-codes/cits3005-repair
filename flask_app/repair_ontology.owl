</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112836">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jimmy"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Dal4V6MIOycBcfCk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly insert the tip of the Jimmy between the damaged plastic cover and the plastic frame, which holds it, to loosen the connection between them. The Jimmy is sharp, so take special care when using it to avoid damaging the plastic frame or causing personal injury.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Dal4V6MIOycBcfCk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112952">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jimmy"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZXYI4HGGIgOesfBO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wG1gknW3TVCWSjXa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully slide the Jimmy through all corners of the plastic frame until it is detached from the plastic cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZXYI4HGGIgOesfBO.standard">
