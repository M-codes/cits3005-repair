  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/d1oXFRASgIeJaBEA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, gently disconnect the plastic piece on top of the flash/speaker wiring by prying open the claws on either side. The flash unit can now be removed and replaced. Be careful not to touch the capacitor attached to the flash unit as it may still be holding a charge!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

