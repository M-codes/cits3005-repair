  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry off the rubbery cap that covers the buttons using the same process as the previous two steps. You should slide your prying tool underneath the entire cover to ensure that the glue breaks cleanly so the cover will not snap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

