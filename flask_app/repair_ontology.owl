  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Set the LCD screen to the side Grab the orange band holding the LCD screen and gently pull to detach from the camera body. Do not pull the white strip on top of the orange band. This is part of the circuit inside the camera and detaching this piece could permanently damage your camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

