  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the pointed end of a spudger, flip up the two black tabs holding the ribbon cables in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

