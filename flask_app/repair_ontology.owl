  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingernails to carefully pull the ZIF cable lock away from its socket. Do not try to completely remove the ZIF cable lock. It will move about 1 mm and stop. Use a pair of tweezers to pull the Compact Flash ribbon cable out of its socket.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

