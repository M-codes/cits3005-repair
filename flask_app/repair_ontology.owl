<owl:NamedIndividual rdf:about="#Step_112140">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BWpKqTLc2HkdEo1r.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hTIR1IihVu2AbiPT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove six 3 mm x 2.5 mm Phillips head screws from the bottom right back of the camera bottom. Remove three 3 mm x 5.5 mm from the bottom left of the camera bottom. Lift the battery cover and remove two 3 mm x 5.5 mm screws from the bottom left of the camera. Remove the screws from the bottom of the case to access the shutter gear.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BWpKqTLc2HkdEo1r.standard">
