<owl:NamedIndividual rdf:about="#Step_145025">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_2.5mm_flathead_screwdriver"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
