  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1QRRrlcgXuNPJ1ni.standard"/>
