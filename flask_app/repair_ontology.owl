  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2Q2D5cEnOZOLXT4D.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HPfsAaZiLfAwxTIK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pFvQBpofxYM2HNxQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure that the batteries are removed and the camera is not connected to any external power source. Never touch any part of the interior of the device when powered. Pry the case apart. Note that the case is very tightly sealed and will be difficult to open. Use a plastic opening tool on the crease between the two halves of the case and put two fingers in the battery compartment to create leverage to pull apart. The battery compartment is attached to the half of the case that contains the lens. Once the two halves of the case have begun to come apart, pull the wrist strap away from the front of the camera to remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2Q2D5cEnOZOLXT4D.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HPfsAaZiLfAwxTIK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pFvQBpofxYM2HNxQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_127278">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YWBHtAGFxIH4GaCQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3oxWC2RmqKydwyJY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1MTYyOLbUWWi1n4t.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the wrist strap has been removed, continue to '''carefully''' pull the two halves of the case away from each other. Tilt the back half of the case away from the battery compartment. Proceed slowly to avoid damage to the ribbon cable that is connected to the screen. Locate the speaker at the end of the pair of red and black wires holding the halves of the case together. Take care not to pull the wires, else they may detach from the motherboard and damage the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YWBHtAGFxIH4GaCQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3oxWC2RmqKydwyJY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1MTYyOLbUWWi1n4t.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_127279">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IKBkRiCAtRFtv2Rf.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ejr5b5mhmF1jJ32l.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rHBBO4NdIIUnLODH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the speaker pad away from the back half of the case and out of its holster. After the speaker pad has been removed, the two halves of the case will be connected solely by a ribbon cable leading to the screen. The speaker wires will remain attached to the motherboard. To completely remove the speaker, use a soldering iron to desolder the red and black wires connecting the speaker to the motherboard.  Note the black wire goes to the terminal closest to the outside of the camera. If you lack experience in soldering, or need a refresher, refer to the iFixit [https://www.ifixit.com/Device/Soldering|soldering guide]. Desoldering the speaker is '''not''' a prerequisite for subsequent guides.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IKBkRiCAtRFtv2Rf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Ejr5b5mhmF1jJ32l.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rHBBO4NdIIUnLODH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

