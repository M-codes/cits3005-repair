  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KscMXI4iQOnARB2N.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a pair of tweezers, gently remove the metal plate covering the gears. Part of the plate's tab fits into a socket. Try to pivot around it when removing the plate to prevent bending the plate. Be careful with the gears because some may be loose.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KscMXI4iQOnARB2N.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97377">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_soft_cloth"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WKKdpOPignMWpLwx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ugAxfMaZCfEufx3Z.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to rotate gears or remove any large particles obstructing their rotation. Smaller particles can be cleared using a microfiber cloth only.  Other fabrics may leave residual fibers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

