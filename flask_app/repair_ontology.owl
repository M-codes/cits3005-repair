  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger to peel rubber matting on left hand side to expose camera backplate mounting screws. Remove three 4 mm Phillip #000 head screws that mount the backplate to the left side of camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
