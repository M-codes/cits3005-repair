<owl:NamedIndividual rdf:about="#Step_163909">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_cotton_swab"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Clean your camera buttons.''' This can be done using isopropyl alcohol and a cotton swab. If the button is still jammed, proceed to Step 2.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_163922">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_driver_set"/>
