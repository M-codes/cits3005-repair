<owl:NamedIndividual rdf:about="#Step_120723">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/E6eNlYTaFknTXocb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reorient the camera so that black lens cover is facing you with viewfinder on top. Remove the four 5.3 mm screws around the lens using a Phillips #00 screwdriver. Remove the 3.8 mm screw above the lens using a Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/E6eNlYTaFknTXocb.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_120726">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eEwLdsTBsRRrMMWQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black plastic cover surrounding the lens by gripping and lifting upwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eEwLdsTBsRRrMMWQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

