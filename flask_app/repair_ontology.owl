  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use one of the plastic opening tools to pry off the back covering of the LCD screen. Use your fingers to carefully remove the back covering.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

