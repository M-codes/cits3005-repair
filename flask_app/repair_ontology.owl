  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the LCD screen out of the metal casing. This is especially easy if you run the plastic opener along the bottom of the case When the screen pops out, replace it with the new one.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

