<owl:NamedIndividual rdf:about="#Step_34683">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/W3sgXJmj2KVLBApe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T11eQDRCVZlMliQW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OMR6XIZ5leubSJjT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers or your finger nails, pull up the brown flaps where the two orange film strips connected to the lens meet the circuit board. Use the tweezers to pull the orange film strips out of the port. It should come out easily. There are two additional film strips connected to the circuit board that do not need to be removed. These are connected to the side of the circuit board that is opposite to the lens</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

