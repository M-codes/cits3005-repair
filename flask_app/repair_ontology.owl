  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull off the plastic tape cover by lifting it up and out of the camera base.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QAXuQLTr1L1HoUHf.standard">
