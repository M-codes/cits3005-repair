  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the spudger again and wedge it in the thinner frame to pry the LCD screen from the frame. Make your way around with the spudger just enough to separate the screen and frame once again.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

