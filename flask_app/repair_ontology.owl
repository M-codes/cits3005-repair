  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the lens barrel out by pushing slightly from the front Unhook the inner control ring as shown. The spudger needs almost no force and the ring springs out The inner ring can be lifted out. It has three guides with different shape, so fitting back in is possible without a marking</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

