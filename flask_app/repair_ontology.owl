  <rdf:type rdf:resource="#Step"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the modified mainboard, put everything to its place and close the camera. Simply reverse the disassembly procedure</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_180692">
