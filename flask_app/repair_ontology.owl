<owl:NamedIndividual rdf:about="#Step_148526">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MJECISI4FkVfExdF.standard"/>
