<owl:NamedIndividual rdf:about="#Step_13532">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EgcAI2XRXQqlRJlb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the case, LCD screen, and release button housing removed, the broken flash unit can be removed and replaced. Begin by disconnecting the hanging flash/speaker unit from the connector on top of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EgcAI2XRXQqlRJlb.standard">
