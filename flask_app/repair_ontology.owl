<owl:NamedIndividual rdf:about="#Step_37588">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lAOIcIrLBTjIT6jk.standard"/>
