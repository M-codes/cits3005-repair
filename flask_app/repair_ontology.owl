  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_147759">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gsLvXx5MVv4KfulR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZIFYSdEFS1NATxKX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Follow the speaker towards the input on the motherboard. Pull it from the motherboard horizontally for it to loosen easier. You may have to wiggle the head of the wire to efficiently remove it from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

