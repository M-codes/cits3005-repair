  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the battery cover. Remove the 5 mm screw that sits on the top of the battery slot. Remove the three 6 mm screws that sit at the bottom of the battery slot. Close the battery cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

