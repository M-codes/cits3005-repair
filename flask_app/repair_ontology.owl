  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34684">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5ZLcPIRDs2pOqEPp.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You can now remove the lens completely. There should not be anything else holding it in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5ZLcPIRDs2pOqEPp.standard">
