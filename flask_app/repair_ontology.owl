<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nElH1eKMjIM1MFEn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_88738">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BIjDjdk2WiwKK1c6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger to pry up the black rubber ring around the lens cover. The black rubber ring is vey thin and can easily tear. Use caution when removing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BIjDjdk2WiwKK1c6.standard">
