</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35299">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6etwfI6JYSBNQ4BK.standard"/>
