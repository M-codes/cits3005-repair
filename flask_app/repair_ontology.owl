  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the lens assembly away from the motherboard assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xVqoyPcEEJLiMKQK.standard">
