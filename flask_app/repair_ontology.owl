  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3.5 mm exterior-side screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PfAGAMSGqqpb4NSW.standard">
