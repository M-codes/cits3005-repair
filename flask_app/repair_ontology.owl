  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take note of the spring. You will need to re-install it later. Remove the 3.1mm screw holding speaker to the housing. Remove the two clips and the metal cover will be released When you remove the metal cover the spring will shoot out. Image of the spring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

