  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once all screws are removed, gently pry open the front casing with your hands or a prying tool. Do note that there will be a spring that attaches the front casing and the main circuit board, so take care as to not break the spring.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

