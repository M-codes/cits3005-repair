  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4kVeTciDxJmFMbp3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the 1.5mm hex screwdriver, remove the four screws from the rear of the case. Remove the screw from the bottom of the case. The bottom screw and the top-right screw are both .15". The two bottom-right screws are both .4". The top-middle screw is also .15" but has a different size thread and a blue mark.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

