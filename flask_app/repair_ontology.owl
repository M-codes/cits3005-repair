<owl:NamedIndividual rdf:about="#Step_84479">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EVOTlxUIXSsuiXmm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3DfwhJqkEULJd2ds.standard"/>
