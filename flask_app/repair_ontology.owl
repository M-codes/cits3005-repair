  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peel back the black plastic revealed under the LCD screen on the metal plate. Remove the two 4.3 mm black screws on the left edge of the metal plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

