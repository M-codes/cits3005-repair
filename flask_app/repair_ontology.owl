  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ayR1toNVRCMYGSDX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MI4qAKhkfGALD5Ql.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RLrlLeup4pHjuUuw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Keep the part flat and still. Do not forcefully and quickly pull parts out because the pieces are still connected. When reassembling the device, make sure to properly place the metal frame before putting in the tiny circuit board. There are tiny holders that will hold the frame in place. Gently lift out the tiny circuit board with your hands. A metal frame and a tiny side attachment should come off too. If it does not come off, lift out the white connector piece.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

