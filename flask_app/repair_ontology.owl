  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips #00 screwdriver, remove the seven 3.0 mm screws. Remove the remaining five 3.0 mm screws which hold the rear case and the control panel together. The rear panel is now free from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

