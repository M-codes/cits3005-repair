  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the inner lens mount ring, remove the two silver 2.0 mm Phillips #00 screws. This will complete the removal of the lens mount.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

