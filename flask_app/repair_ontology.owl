  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The buttons are now free to be replaced or cleaned.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

