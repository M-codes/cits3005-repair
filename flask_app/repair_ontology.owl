  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power off the device then Open component door and remove two screws with PH000 bit or small Phillips screwdriver. Place aside the faceplate which the screws were holding down and component door.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
