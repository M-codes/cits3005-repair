  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the wires no longer holding the circuit board and screen together, remove and replace the broken screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

