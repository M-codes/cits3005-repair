  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the one Phillips #000 screw, length 2 mm, on the outside edge of the inner encasement of the LCD screen. Rotate the screen counterclockwise as shown and remove the one Phillips #000 screw, length 2 mm, on the inside edge of the inner encasement of the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

