  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fujifilm FinePix A350 LCD Screen Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_127475">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Umrrlg6pTUoiakOU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FjGS1bISNwR1mWnx.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/V1L4YFrNwdXL2MVk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the four 3.0 mm screws holding a thin, black plastic film to the back of the LCD screen.  Remove them using a Phillips screwdriver with a #0 bit. After the screws have been removed, the black plastic film and LCD screen can be removed by lifting up the end opposite the attached ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Umrrlg6pTUoiakOU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FjGS1bISNwR1mWnx.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/V1L4YFrNwdXL2MVk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_127476">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cVJGd4WoSRhAUWUe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lDA62jTeT5rSN2Q6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the wide ribbon cable connecting the screen to the motherboard. Place your thumb at the base of the ribbon cable where it connects to the motherboard. Carefully pull the ribbon cable out of its connector without pulling it up or away from the motherboard. The ribbon cable should detach from the motherboard but remain connected to the screen, which can now be removed from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cVJGd4WoSRhAUWUe.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

