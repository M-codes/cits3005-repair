<owl:NamedIndividual rdf:about="#Step_112821">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nSOUG6je3BW13Yjk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/THBJqtRVSwhZoT1m.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the plastic opening tool, carefully pull up the rubber grip around the port side of the camera. Remove the  four different sized screws located beneath the rubber grip. 6 mm Phillips #PH00 screw in RED, 3.4 mm Phillips #PH00 screw in ORANGE, 3.9 mm Phillips #PH00 screw in YELLOW, and 2.2 mm Phillips #PH00 screw in GREEN.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nSOUG6je3BW13Yjk.standard">
