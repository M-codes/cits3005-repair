  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by removing two silver  0.080in screw on the left side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

