  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a #0 Phillips screwdriver to remove the following screws: the 2  screws on the  side of the camera near the HDMI input panel, the 2 screws on the opposite side of the camera, and the 2 screws on the bottom of the camera near the tripod mounting hole.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

