  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cVykpxcKZqiunVhw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fKYSGf5yCrjwUsYX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the 3 wiring strips from the device by gently pulling with tweasers from the base of the strip. Do not use sharp tweasers because the wiring might tear. Make sure to use small force so the wiring is not damaged.  It may help to gently wiggle the tape.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

