  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y66y6oaAACpaw6uf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There will be a brown plastic piece keeping the thin plastic ribbon in place. Use the spudger to pull out the brown plastic piece attached to the orange plastic.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Y66y6oaAACpaw6uf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

