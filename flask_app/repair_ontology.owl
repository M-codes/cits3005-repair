  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pry with a plastic opening tool around the perimeter of the camera. The plastic HDMI cover can become loose and fall off during this step. Once the back cover is free from the camera you may remove this piece to store in a safe place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

