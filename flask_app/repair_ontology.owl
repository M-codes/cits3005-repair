<owl:NamedIndividual rdf:about="#Step_64551">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4cBdZMwigA3QHNJj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nRZOIDwoyqND2XRu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingers to grip the top of the image sensor and pull it slightly outward. Lift the sensor out toward the top of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4cBdZMwigA3QHNJj.standard">
