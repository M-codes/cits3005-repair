  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FMDnBBhNgcPlS4BU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove black plate with tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

