  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the image sensor is removed, turn the camera over and find the screw in the bottom right corner. Remove this .01 inch screw to free the ribbon cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
