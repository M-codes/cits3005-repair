<owl:NamedIndividual rdf:about="#Step_120876">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RLyyDigbMA3pvQ4A.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not pull the connector upwards because doing so may harm the connector housing. Be carful not to pinch the cable while pulling it out. Disconnect the cable in the top left by pulling it straight out of its connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RLyyDigbMA3pvQ4A.standard">
  <rdf:type rdf:resource="#Image"/>
