<owl:NamedIndividual rdf:about="#Step_21492">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DlJpOQnMAFPk4tQf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not remove the metal plate this step refers to. Removal at this step may damage the ribbon cable. Wait until the next step to remove the plate. Remove the 3.5 mm screw that sits on the metal plate at the bottom of the camera. Remove the two other 3.5 mm screws that sit on the side, to the left of the screw you just removed. In the image, we have already removed some of the screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DlJpOQnMAFPk4tQf.standard">
