<owl:NamedIndividual rdf:about="#Step_35339">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oE2joK2BkWuT23A6.standard"/>
