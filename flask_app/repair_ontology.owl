  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the four screws in each corner of the LCD screen, unscrew and remove them. Keep them separate from the 3mm case screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
