  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VZJEOIRqkYhQq1FE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift open the rubber flap covering the A/V Out port. Remove the 3.4mm screw in the center. During reassembly, put the A/V out rubber door on before replacing the front panel of the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VZJEOIRqkYhQq1FE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

