  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your Phillips #000 Screwdriver, remove one 3.2 mm screw above the menu buttons panel. Next, remove the two 3.2 mm Phillips #000 screws to the left of the menu buttons panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

