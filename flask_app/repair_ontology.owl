  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the paper door of the camera, then locate and remove the screws that are on the top and bottom edge of the inside of the camera. Screw head: Phillips, Screw length: 3mm</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
