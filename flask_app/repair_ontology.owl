<owl:NamedIndividual rdf:about="#Step_38432">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PCcP1X1Eyq4MtiKa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove both screws at the top of the screen. The silver bracket in between the screws will come out after removing these screws!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

