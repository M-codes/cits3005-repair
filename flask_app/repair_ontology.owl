  <has_step rdf:resource="#Step_22648"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Panasonic Lumix DMC-F7 Fixing the Lens Apparatus Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22647">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/46iOPJHYSUNQUwDd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the "V" shaped spring to see if it is connected at shown location.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/46iOPJHYSUNQUwDd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22648">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QRfJAqGg1vVLuVQC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manually move the Lens Apparatus from the inside to shown position. Check to see if the spring is aligned correctly and lens opens. If not, you will need to take out the spring and place it into the proper position, or get a new spring all together. To reassemble your device, follow these instructions in reverse order.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QRfJAqGg1vVLuVQC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Canon_EOS_5D_Mark_II">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_5042"/>
  <has_procedure rdf:resource="#Procedure_33381"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_5042">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_heat_gun"/>
  <has_tool rdf:resource="#Tool_suction_handle"/>
  <has_step rdf:resource="#Step_22757"/>
  <has_step rdf:resource="#Step_22758"/>
  <has_step rdf:resource="#Step_22759"/>
  <has_step rdf:resource="#Step_22760"/>
  <has_step rdf:resource="#Step_22761"/>
  <has_step rdf:resource="#Step_22763"/>
  <has_step rdf:resource="#Step_22764"/>
  <has_step rdf:resource="#Step_22765"/>
  <has_step rdf:resource="#Step_22766"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canon EOS 5D Mark II LCD Window Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_suction_handle">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22757">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tBSZZAKcnMheta4e.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Here is the part we need to replace with a new LCD lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tBSZZAKcnMheta4e.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22758">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_heat_gun"/>
  <has_tool rdf:resource="#Tool_suction_handle"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tBOni4CnasQVFSpJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a hairdryer or heat gun, heat up the lens for removal. This should not take longer than 30 seconds. Now using a suction cup, I used a suction from a sponge,apply the suction cup to the plastic lens. Now just pull the lens away from the camera to remove the old lens.  This may require a small amount of force. If it does not want to budge, try reheating.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tBOni4CnasQVFSpJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22759">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3xILWwM2ZdA53nhf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At this step you may need to reheat the bottom of the lens if it does not come fully off. You may need to cover the cracked area of the screen with a screen protector, or just regular packing tape. After removal, clean off remaining adhesive.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3xILWwM2ZdA53nhf.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22760">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yswBfALxYq5xL4RR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dYedNJuipv1sERbF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removal, make sure to remove all pieces of the old lens. Checking for fragments of plastic, and dust on the LCD.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yswBfALxYq5xL4RR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dYedNJuipv1sERbF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22761">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WbVabeKLFDqPNeJa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now grab your new adhesive tape from your new lens, and apply to the camera side only.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/WbVabeKLFDqPNeJa.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22763">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DWjG4ewaJUVmVXQC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once lined up apply pressure around the sticker until the tape is firmly in place</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DWjG4ewaJUVmVXQC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22764">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/P6QHCYtlev2Qvfkm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now remove the backing of the adhesive.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/P6QHCYtlev2Qvfkm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22765">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pD61YKTUbIJrEWUP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the protective film from the screen and apply to your camera. Make sure everything is lined up, and placed properly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pD61YKTUbIJrEWUP.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22766">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/63UPaDSNADiTAjM6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You now have a camera that looks like it just came out of the box!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/63UPaDSNADiTAjM6.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_5043">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_step rdf:resource="#Step_21826"/>
  <has_step rdf:resource="#Step_94052"/>
  <has_step rdf:resource="#Step_94040"/>
  <has_step rdf:resource="#Step_94041"/>
  <has_step rdf:resource="#Step_22774"/>
  <has_step rdf:resource="#Step_94278"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canon EOS Rebel XS LCD Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22774">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RTwAU4yKJ6HDIUg6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the tweezers to gently remove the straps (in the teal box). Use the Phillips Screwdriver to remove the four screws (in the red dots). Use your fingers to remove the silver plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RTwAU4yKJ6HDIUg6.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94278">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TNPQpUfmByAKgI4h.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Spudger on the edges of the screen. Once one end is lose, use the tweezers to lift the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TNPQpUfmByAKgI4h.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_5069">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
