</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198320">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cdFQylaVbMC6FnHH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NTwrlqM2aXiBEIuB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the front face of the camera and test to see of the Lens Barrier will slide. Make sure items are not trapped or stuck between the Lens Barrier and the camera lens. Check to see if the camera power turns on by sliding the barrier. If not check to see if the lens barrier is on the correct track.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

