  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your plastic opening tool to gently lift and remove the back face plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/He5eUnsqtDhZ5rCL.standard">
