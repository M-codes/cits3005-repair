  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yGrg1bDGZGB6fLhQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You may remove the loose black film from the back of the LCD screen. When purchasing a new LCD screen be mindful that some do not come with the original plastic frame. You may have to separate these pieces by pushing the LCD out of the frame from behind. It takes force to break the adhesive bond, but be mindful to not break the frame when applying force. Upon reassembly place the tape on the inner edges of the LCD frame. When pressed back together there may be excess, use a knife to remove this overlap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

