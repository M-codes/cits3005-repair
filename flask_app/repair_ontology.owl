  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JLK4wZiN2gIRbSVT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Phillips #00 screwdriver to remove the 7 screws on the sides of the camera: Four 3.95mm Phillips screws located on the bottom of the camera Two 3.95mm Phillips screws located on the right side of the camera One 3.95mm Phillips screw located on the left side of the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wsYj1rAy1Mqy3gox.standard">
