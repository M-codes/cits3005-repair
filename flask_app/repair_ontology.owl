  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, pull connecting strip away from its socket on the logic board. With the plastic opening tool, take the display screen out of its socket by gently lifting each corner. Flip the screen up towards the logic board that it is still connected to. With the spudger, gently lift the film underneath the display bracket and peel away. Set aside. With the plastic opening tool,  gently pry open metal display bracket to remove from logic board. Using fingernail, pry black tape up from zif socket to remove the partially attached display screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tKEa1XAAblSnVMr1.standard">
