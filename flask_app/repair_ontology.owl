  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the flash cover and place in the new one, with the holes of the flash cover oriented in the top right and bottom left corners.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

