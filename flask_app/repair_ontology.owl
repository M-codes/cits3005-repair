<owl:NamedIndividual rdf:about="#Step_143113">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6e24L1GFdRbhQPTl.standard"/>
