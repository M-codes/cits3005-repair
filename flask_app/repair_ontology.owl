  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VgHr5GQBDxoDFnWB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wpRWC4vbTeihGBCO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4.8 mm Phillips screws securing the LCD bracket to the rear cover. Lift the LCD bracket out of the rear cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
