<owl:NamedIndividual rdf:about="#Nikon_Coolpix_995">
  <rdf:type rdf:resource="#Item"/>
  <has_procedure rdf:resource="#Procedure_6709"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_6709">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_step rdf:resource="#Step_28521"/>
  <has_step rdf:resource="#Step_28522"/>
  <has_step rdf:resource="#Step_28524"/>
  <has_step rdf:resource="#Step_28533"/>
  <has_step rdf:resource="#Step_28534"/>
  <has_step rdf:resource="#Step_28535"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nikon Coolpix 995 LCD Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28521">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GbgSAVUOppwC2ZHS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uVmim3EYn5vkPTBS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the lens/flash assembly 90 degrees, until you see the two Phillips #00 screws. Refer to the image to locate the two screws. The screws are highlighted in red. Remove the two screws with a Phillips #00 screwdriver. Flip the flash so that you can access the remaining two screws. Remove these screws following the same method as before. Refer to the second image to locate the second set of screws. The relevant screws are highlighted in red. Be careful while removing the screws. Do not strip or ruin the screws. You will need them to reassemble the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GbgSAVUOppwC2ZHS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uVmim3EYn5vkPTBS.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28522">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FXUgHvhqGkvWRbUW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera up-side down, so you can see the bottom of it. Remove the two Phillips #00 screws located near the battery compartment. Do not strip or ruin these screws. You will need them to reassemble the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FXUgHvhqGkvWRbUW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28524">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6cWe5qjFRqJFoIf1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hold the camera so the memory card compartment faces you. Flip the compartment cover of the memory card and the rubber cover of the AUX port. You can now see four screws under the cover. Remove all four screws. Refer to the image to locate the four screws. Make sure that you remove only the four screws identified in the image.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6cWe5qjFRqJFoIf1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28533">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jWmT1wPGXFsLywNo.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OgExg5YY6cV5ZQCa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your thumb to carefully lift the bottom side of the casing near the battery. Pay attention to a cable located at the top of the assembly, as it is prone to breakage. Refer to the second image to locate the cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jWmT1wPGXFsLywNo.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OgExg5YY6cV5ZQCa.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28534">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEeEjcPUtPNYC1UL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a spudger to move the left tab, so that the screen can move. Repeat the same process on the right tab. Refer to the image for more details. The tabs are circled in red.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jEeEjcPUtPNYC1UL.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_28535">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BjbRZVuNBKSPZZV3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully lift the LCD from the bottom. It should come out fairly easily.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BjbRZVuNBKSPZZV3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

