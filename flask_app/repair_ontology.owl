  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/H1twWgrTwNiW4vEk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finally to separate the motherboard from the base skeleton frame, one last silver screw and one ribbon cable need to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qysqKCypvOlrGPFG.standard">
