  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_100312">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EBLQxQlbiIPpTheB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/joYReKhLsrsdHHCV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TWiRZIXKhZmGY6ga.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To detach the first logic ribbon: Use a small, relatively soft pointed tool to slowly pull out the ribbon using the hole shown in the image. Completely remove the ribbon. The display is now partially disconnected from the back side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EBLQxQlbiIPpTheB.standard">
