  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a plastic opening tool pry off the back cover from the screen assembly. Remove back cover by lifting it away from the screen using tweezers.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

