<owl:NamedIndividual rdf:about="#Procedure_73052">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_64_bit_driver_kit"/>
  <has_tool rdf:resource="#Tool_padded_surface"/>
  <has_tool rdf:resource="#Tool_rubber_band"/>
