  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift the circuit board from the camera. Remove the display ribbon receptor lock to remove back panel from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CJ2oIfQwBjmRLhsD.standard">
