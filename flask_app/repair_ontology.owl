  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start by removing the two  6mm Phillips #00 screws located on the right side of the camera. Remove four more 6mm Phillips #00 screws found on the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

