  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ds1GaoMWXfJXhQch.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UfTTthCp6mXWqN6N.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn screen up, and toward the camera. Remain perpendicular to camera. Replace monitor cover using single screw, making sure cover is on the outside. (Screw from step 6)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ds1GaoMWXfJXhQch.standard">
  <rdf:type rdf:resource="#Image"/>
