  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two 3 mm x 5.5 mm Phillips head screws from either side of the viewfinder. Remove four 3 mm x 5.5 mm Phillips head screws above and below the USB port cover and above and below the SD card slot cover. Remove two 3 mm x 4 mm Phillips head screws inside the SD card slot cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

