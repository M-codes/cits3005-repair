  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the brown ZIF connector located on the front of the camera. Use the flat end of the spudger to push the small top brown tab out towards the lens. Repeat for the bottom brown tab. Pull the ribbon cable out from the ZIF connector.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</has_order>
</owl:NamedIndividual>

