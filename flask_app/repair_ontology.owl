</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_192861">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GDYlOgsxy1DSioM5.standard"/>
