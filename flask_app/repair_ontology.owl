  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The removed panel should look like this</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
