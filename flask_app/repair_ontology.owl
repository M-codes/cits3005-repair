<owl:NamedIndividual rdf:about="#Step_96125">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lDbhRV2XxTEMwlMT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/w5ExSV3uAIHkG4il.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mjSjEBtlIBGIEAyQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To detach the larger wire ribbon, lift the release latch on the connector of the circuit board. Remove the wire ribbon with tweezers. Now remove the smaller wire ribbon by pulling on it firmly but gently. The wire ribbons are very delicate; be very cautious when detaching them!</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/lDbhRV2XxTEMwlMT.standard">
