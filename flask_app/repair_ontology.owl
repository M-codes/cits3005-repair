  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the remaining piece over, careful not to rip any of the connecting wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
