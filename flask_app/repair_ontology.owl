  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When the compartment opens, pull the AA battery out of its slot.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/O1uVgZLaYuPmaqB2.standard">
