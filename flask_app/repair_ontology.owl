  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip open the four ribbon gates using the Spudger. Gently pull out the ribbon cables from the gates using the Spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NmZ5oAku1bpERQRE.standard">
