</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_125996">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mOVAhaVERGGGHnru.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gfwZEgVdBsgTQRMZ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Dwu1IIGQCFFsPOBD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The display cable has a ZIF (zero insertion force) connector on the end. This has a tab that has to be pushed out before the cable can be safely removed. Using a plastic opening tool or fingernail, pop up the black clip holding the display cable. This will release the cable. Slide the display cable out of the connector. The display cable can be damaged due to excessive bending, therefore avoid putting unnecessary strain on it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mOVAhaVERGGGHnru.standard">
