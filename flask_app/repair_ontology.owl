  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 5.7 mm Phillips screw in the top corner of the battery compartment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xX6dgE3ScZrFcBdD.standard">
