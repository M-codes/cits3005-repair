  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the one 2.6 mm Phillips screw on the top of the lens assembly holding the viewer in place. Pull out the view finder from the rest of the lens assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</has_order>
</owl:NamedIndividual>

