<owl:NamedIndividual rdf:about="#Step_129904">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/F31QVqtBvIVZONhh.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4CDu3VNU4fOlFK1n.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/lVqoYJLM3Crbd3Bo.standard"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use A #00 Phillips head screwdriver and turn counterclockwise to remove the four indicated screws. Set the screws aside.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
