  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, remove the lens cover from the lens. Be sure not to damage this delicate piece.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/R6ZTXpOHjypcNTAC.standard">
