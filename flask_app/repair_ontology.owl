  <has_step rdf:resource="#Step_65103"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nikon D5000 Sensor Filter Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65095">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2KNfAhsGTuArxgXQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3yw5EGpY1E6OJFw3.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/orM3PbnBTxAZC42R.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect the six ribbon cables by releasing the clips and pulling the cables out. Pry off the gold-plated connector with an opening tool, spudger, tweezers, or a fingernail. Disconnect a seventh ribbon cable in the lower-right corner.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2KNfAhsGTuArxgXQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3yw5EGpY1E6OJFw3.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/orM3PbnBTxAZC42R.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65785">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Jy13FnveOtafGhNF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desolder the five wires attached to the back of the board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Jy13FnveOtafGhNF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65786">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nmKRPSjCXuFX1oxW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OTYSqUVAeZZjtBkR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the five silver Phillips #00 4x4mm screws. One is hiding under the wide ribbon cable in the lower-right corner.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nmKRPSjCXuFX1oxW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OTYSqUVAeZZjtBkR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65098">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/E4MFXNRCUGCvJNTV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TZucMr2lJRggOgSG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip up the motherboard. Remove the white cable connector by pulling it out of its socket with a spudger or fingernails.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/E4MFXNRCUGCvJNTV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TZucMr2lJRggOgSG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65099">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rLJ4md2BYE6Dakrl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2AZkONtYsh6QNSih.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the L-shaped ribbon cable from both of its connectors.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rLJ4md2BYE6Dakrl.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2AZkONtYsh6QNSih.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65101">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/F1H2d1RlfIOMBLEn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EY3pEPHtrHXaMhgq.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three silver 5x5mm screws. Between the metal backing plate and the standoffs for each screw is a copper washer. Don't lose them! Flip the sensor board out. Be extremely careful from this point on. Dust or scratches on any part of the sensor or its filters can affect picture quality.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/F1H2d1RlfIOMBLEn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EY3pEPHtrHXaMhgq.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65102">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4LTtdHDNACMk4gIY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kLJBJlRrQVxYFXTw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four silver 3.5x3.5mm screws securing the dust cover. Pull the cover straight up to remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4LTtdHDNACMk4gIY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kLJBJlRrQVxYFXTw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_65103">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CgVuEYIYjJXT3Zrk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/slOdReFsfxvf2KbO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove the sensor filter, pull back the rubber gasket to expose the edge. Use a spudger or opening tool to carefully pry out the filter.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CgVuEYIYjJXT3Zrk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/slOdReFsfxvf2KbO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_25666">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_step rdf:resource="#Step_65083"/>
