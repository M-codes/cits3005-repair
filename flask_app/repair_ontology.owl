  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip camera to other side-with flash farthest from you. Unscrew top two 6.2mm Phillips screws on this side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

