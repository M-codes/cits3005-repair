</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22054">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZxDN3K3hyTgvRvcK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wsGTdrCIvwowmIhh.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The batteries will slide right out. When putting new batteries in, make sure they are pointing the right direction.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

