<owl:NamedIndividual rdf:about="#Step_37298">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iKxmSaprI5WQlJBG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/k4NOxtlEJWlIQmdQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the next few steps, you will be releasing the clips that hold the lens in place. Do not try to completely remove the lens until all the clips have been released. Hold the iON in your hands with your thumbs on the clips next to the middle of the lens. Pull the rubber housing apart to release the first two clips.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/iKxmSaprI5WQlJBG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/k4NOxtlEJWlIQmdQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37299">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZCe2ox1cglhnnKrk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SBH2mQQKDGmCrvFE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grab the inside of the plastic nose rest with your thumb and index finger. Rotate the nose rest upwards until you feel that it is free from the lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZCe2ox1cglhnnKrk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SBH2mQQKDGmCrvFE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37300">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fQpG4HRxXIebH6qH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/f1K1STWgJp1neYkC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotate the device 180 degrees. Grab the top of the goggle frame that holds the camera assembly. Rotate the frame outwards until you feel that the clips inside it are free.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fQpG4HRxXIebH6qH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/f1K1STWgJp1neYkC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37301">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/i1JNLPNawmTORMVC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/f3BFTtHOCLdDbfHL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While firmly holding the goggles with the palm of one hand, grab the top right corner of the frame and rotate it away from the lens.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/i1JNLPNawmTORMVC.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/f3BFTtHOCLdDbfHL.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37302">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZXDNLCn2oyCe6IZW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qmotDjKo3vbgSkLg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lens should now be barely attached to the frame. If it still feels firmly attached, repeat any necessary steps to free the clips. While holding the goggles in one hand, use the other to grab the lens from opposite ends, and rotate it out of the housing and away from any remaining clips.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZXDNLCn2oyCe6IZW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qmotDjKo3vbgSkLg.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37585">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BOKPVMrKZsBALWjY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 7.1 mm Phillips screws securing the camera housing to the goggle frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BOKPVMrKZsBALWjY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37586">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/urjIlYSScEwVCJ4d.standard"/>
