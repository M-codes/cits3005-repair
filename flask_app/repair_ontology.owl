<owl:NamedIndividual rdf:about="#Step_34313">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pcUmacIwYDEKaeKJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vhLIWCAVkl1jaFww.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera over so the bottom is facing you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pcUmacIwYDEKaeKJ.standard">
