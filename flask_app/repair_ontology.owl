  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_207453">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PAsN3ph6dMhn4sLG.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oPpcTRCX2GGfAG2R.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tNmxg2EdNYtX2UVL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull on the battery holder to remove it from the case, exposing the capacitor. Pull up on the backside of the capacitor  to remove it from the battery holder. The capacitor will have a small amount of adhesive holding it onto the battery holder.  Keep this intact, but don't worry if  it is damaged. Be careful not to touch the wire leads on the front of the capacitor, as you could get shocked.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PAsN3ph6dMhn4sLG.standard">
