</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_97915">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2b6KilQQPOQfCd51.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After the screws are removed, the bottom cover should easily pry off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2b6KilQQPOQfCd51.standard">
