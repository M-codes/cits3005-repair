<owl:NamedIndividual rdf:about="#Step_89405">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qjDPCBCTc4OQPEq4.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LEyKZBevpxTiTdFL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ySoxNZUOJVoXHXTB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you can lift out the sensor assembly. The following steps will explain how to lift it out. First, sightly lift the bottom half following the direction of the arrow. Second, lift the top left up side up. It may be a little stuck so you will have to wiggle it out. Finally, pull the entire assembly towards the bottom and away from the case. '''There is a ribbon connector that is beneath the assembly. Be careful when lifting the assembly out. Do not yank it out very hard or you may damage the ribbon connector.'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qjDPCBCTc4OQPEq4.standard">
