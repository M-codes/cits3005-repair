<owl:NamedIndividual rdf:about="#Step_21039">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HlEyvPCyhmgLSTPo.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the film door latch located on the side of the camera. Insert the spudger under the latch. Caution: Be careful during the following step in order to not break any parts within the camera. Prying the latch in any other direction than perpendicular may result in broken parts. Pry the latch upward, applying force perpendicular to the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HlEyvPCyhmgLSTPo.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

