  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/521ZTHPSfwIsVQFe.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 5.00 mm screws in the bottom of the casing with a Philips #000 screwdriver</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YHvZvvDp1Lw22E4T.standard">
