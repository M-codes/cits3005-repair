  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 9.0 mm Phillips #00 screws at the four corners of the lens. Push up on the lens from the front/outside of the camera to remove it.</has_title>
