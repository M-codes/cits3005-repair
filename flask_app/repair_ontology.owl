  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the camera facing LCD side up, slide the battery compartment lid to the right. Remove old batteries.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MdQOCkVQ1tsYw2sC.standard">
