  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JWjn3seCjSnjxNqL.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the circuit board is removed, you will want to remove the Phillips screw (3mm headsize x 2 mm length) near the ribbon cable. ONLY REMOVE THIS ONE SCREW.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JWjn3seCjSnjxNqL.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_82628">
