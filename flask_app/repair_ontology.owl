  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T1rZCw3YqhWUw5fS.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GVZaCrVbZUe63ye5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently, lift the screen using the plastic opening tool as shawn in the picture.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

