<owl:NamedIndividual rdf:about="#Step_163648">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FvJFRBjZ26mRQg1O.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dhhO2lNcIpSrqa3T.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a screwdriver to remove the three 2 mm screws from the back cover plate. Gently lift the back cover away from the device, but do not pull or yank free. The LCD screen is still connected to the motherboard via a small ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FvJFRBjZ26mRQg1O.standard">
