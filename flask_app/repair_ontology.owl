<owl:NamedIndividual rdf:about="#Step_92413">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ryCoyEVDSkqJEWI2.standard"/>
