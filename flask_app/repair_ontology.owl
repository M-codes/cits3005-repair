<owl:NamedIndividual rdf:about="#Step_110009">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MYSWJJ1ZZQUHQB5S.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingers to gently remove the ribbon connected to the lens. Be careful when removing the ribbon cable. Pull off gently or you can separate the ribbon from the contacts.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MYSWJJ1ZZQUHQB5S.standard">
