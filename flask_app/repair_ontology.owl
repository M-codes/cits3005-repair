  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the plastic panel surrounding the screen. (it should pop off easily) Remove the one 5mm screws on the right using the size J000 screw driver from the button plate.  Remove the two 4mm screws on the left, then move the button plate out of the way. carefully unlatch and then detach the button plat's flex ribbon from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nQyWiPKObBsXXmpL.standard">
