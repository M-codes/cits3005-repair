  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove four screws (9.4mm) on the front of the camera using a Phillips #000 Use the plastic opening tool to release the holding clip. Using tweezers separate the plastic strips from their connectors located on the main circuit board by lifting the small, black flaps on the connectors and pulling on the ribbons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

