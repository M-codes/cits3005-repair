  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CMCsnMpthspujvkF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a Phillips #000 Screwdriver to  loosen the 0.008 mm screw  located between the USB and memory card slots. This screw is really tiny and can easily fall off and get lost! Make use of a magnetic mat to hold it in place or better still put the magnetic clip to use for keeping the screw safe.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CMCsnMpthspujvkF.standard">
