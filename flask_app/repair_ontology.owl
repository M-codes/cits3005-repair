  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate where the ribbon cable is attached on the back of the motherboard. Use a spudger or small pry tool to lift the black flap on the zero insertion force (ZIF) connector which secures the ribbon. Gently remove ribbon and replace motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

