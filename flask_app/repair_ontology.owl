  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two more 3.2 mm screws on the silver panel using your Phillips #000 Screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/1CAWFXQFEnBlmBae.standard">
