  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REMINDER: Pieces may become loose when you separate the device in half! Apply upward pressure to fully separate the device into two halves.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/w2v55uROJrsOHM2f.standard">
