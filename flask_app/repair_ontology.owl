  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 4mm Phillips #00 screw from above the ribbon.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

