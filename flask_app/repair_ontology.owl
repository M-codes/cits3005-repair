  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the flat end of the plastic spudger to release the plastic retaining clip on the side plate closest to the lens. Rotate the side plate closest to the lens toward the lens of the camera and then pull the plate away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

