  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desolder the battery connectors. Desolder the black and red wire. Remove the logic board from the midframe.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
