  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VColMOaHGjmlpnpZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take your flat head screw driver and wedge under holder. This part is fairly easy. But gentle fists, gentle fists, use only as much force as you need ( delicate touch)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VColMOaHGjmlpnpZ.standard">
