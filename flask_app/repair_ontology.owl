  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not touch the black cylinder on the top edge. This is the capacitor for the flash and it may shock you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

