</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_122288">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jgOS2yk6V3GtnAgw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oYERWC4rRn3Dknwn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xxt3VHIb3PvPBrc6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using Phillips screwdriver 000, unscrew the 4 screws from the outer casing. Now the small white microphone should disconnect and is free to be set aside. With Phillips screwdriver 000, unscrew the 3 screws which secure the aluminum USB bracket. Using tweezers, remove the USB port from the device. Your device is now a skeleton and is ready for replacement. To do so, follow these steps backwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

