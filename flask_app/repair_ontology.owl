<owl:NamedIndividual rdf:about="#Step_19226">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FmWByHI6lWgYqRdm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 1.85 mm #00 Phillips located on the left side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
