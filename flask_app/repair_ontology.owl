  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not pull on the wires themselves as they are fragile and may break from the connector. Locate the power connector next to the lens protector on the infrared LED board. Using your fingers, wiggle the power connector back and forth until it is loose.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

