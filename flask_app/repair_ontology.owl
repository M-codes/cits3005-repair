  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unplug the ribbon cable from the LCD screen. Replace the LCD screen and re-assemble in reverse order of these steps.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

