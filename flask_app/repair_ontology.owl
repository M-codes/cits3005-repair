  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the three long black screws from the bottom using a #00 Phillips screwdriver. Use tweezers to lift the panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
