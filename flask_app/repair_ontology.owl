  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using tweezers, gently wiggle the locks up and out on the ribbon housings of the three ribbons still connected to the LCD board. Slip the ribbons out of their housings.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

