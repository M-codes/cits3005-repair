  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With your right thumb, pull back on the tab while using your left hand to pull the face of the camera away from the body.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

