  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2 screws above and below the SD card flap.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
