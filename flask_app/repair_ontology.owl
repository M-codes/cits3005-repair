<owl:NamedIndividual rdf:about="#Step_24191">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FavaCMbHX6jkSlQw.standard"/>
