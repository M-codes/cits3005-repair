  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the LCD screen panel. Remove the two Phillips #000 screws, length 3 mm, on the outside edge of the LCD panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

