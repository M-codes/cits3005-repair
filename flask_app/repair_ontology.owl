  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dBSxRdOVTsCaYaOP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 1 screw on the outer side of the battery chamber. This will be under the rubber grip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dBSxRdOVTsCaYaOP.standard">
