  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the flat end of wide metal spudger into the seam of the plastic buffer surrounding the buttons and pry it open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
