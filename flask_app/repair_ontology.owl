  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the back case of the camera by pulling from the top. Be careful when pulling off the case. There is a delicate gold ribbon connecting the bottom of the camera to the back case.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

