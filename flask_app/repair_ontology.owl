</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DkZYLIQRuhwUpoLD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_81803">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nMDteIHQhGFGN1BZ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dYLvEVGtQL42W2Xs.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bAAHXjCIARNnTJoa.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The entire CMOS sensor assembly is now free. To replace the assembly's low-pass filter, infrared-absorption glass and/or the piezoelectric element only, use a Phillips #00 screwdriver to remove the two 4mm screws on the top and bottom sides of the sensor assembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nMDteIHQhGFGN1BZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dYLvEVGtQL42W2Xs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/bAAHXjCIARNnTJoa.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

