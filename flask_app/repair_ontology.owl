<owl:NamedIndividual rdf:about="#Step_155277">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EWLen4kNhwHCAKYI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YpEWVPLVP4KOEeWu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EeYeQqxSfu6cMNbN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure the camera is turned off and the battery is removed. Using a Phillips #000 screwdriver, remove the four 2-mm screws from the side of the camera. Remove the two 3-mm screws from the other side of the camera. Finally, remove the three 4-mm screws from the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

