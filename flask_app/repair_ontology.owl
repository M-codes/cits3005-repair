  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the ribbon away from the logic board. You can now separate the cover from the rest of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

