  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the white cable on top of the camera where the eyepiece was. Using tweezers, grasp the white cable as close to the connection point as possible and gently remove the cable. The cable should just slide out with a slight tug. Remove the 2.9mm screw directly underneath the white cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

