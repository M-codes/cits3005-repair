  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure the camera is turned off and battery is taken out before you begin. Remove the two external screws from the camera using a Phillips 000 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
