<owl:NamedIndividual rdf:about="#Step_92412">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yqBRdax3DW3RwpQj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MIKXJVZnNRReNeaQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully remove the font panel piece from the rest of the camera. Carefully remove the top/side plastic piece. If the the camera and flash buttons fall out of their slots set them aside. If you haven't already done so, remove the side casing as mentioned in Step 3. It is secured by a single screw near the bottom corner.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yqBRdax3DW3RwpQj.standard">
