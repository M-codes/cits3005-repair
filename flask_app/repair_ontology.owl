  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the battery cover and split the housing carefully. Start at the battery compartment and work your way around it. You can use an opening tool or your fingernails. Also make sure to open the USB port cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3mUJA5RhdXXCxgtF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_36278">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OhUgvMH26cnxJGoF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AF6lWGExhMuTpvNT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/s5pH14ehvJEuVRKf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">You now look directly onto the LCD. Gently move the LCD out of the frame and fold it toward the bottom of the camera. Do not try to remove it. It is still attached. Remove the four screws that hold the frame to the logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OhUgvMH26cnxJGoF.standard">
