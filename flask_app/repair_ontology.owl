  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pS11Qa63iqwM4SWl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Put screen cover back on and replace screw from step 7.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

