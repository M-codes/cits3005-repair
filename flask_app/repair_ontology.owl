  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WoxWYRMvU53bvBhu.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the rear part of the cover out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
