  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_189435">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KG3nfmJFOcM6YHJU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lens has two 5 mm JIS 0 screws located under the motor's previous location. As a final step, the wires that connected the board to the containment shell will need to be removed from the board. The lens should be the first component placed when reassembling the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KG3nfmJFOcM6YHJU.standard">
