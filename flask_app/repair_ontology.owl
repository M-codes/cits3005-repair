  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RYMqkGQtdN2I5ITO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tGnDpaTycm12eRHE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the #000 Phillips screwdriver, remove the 4.3 mm screw as shown by the screwdriver and the 6.0 mm screw holding down the ribbon. '''These screws have washers on them, do not to lose them.''' Using tweezers, gently lift the ribbon off the sticky pad.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
