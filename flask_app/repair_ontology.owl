<owl:NamedIndividual rdf:about="#Step_110010">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/anHNNXhmKiGNVcyW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bwMtAMvIb5ZLQqYa.standard"/>
