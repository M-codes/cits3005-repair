</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_29652">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UXmbTTxegcCrBktv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Lift the black locking mechanism up and gently pull the ribbon circuit free.''' '''Remove the wires by using a tweezers to grasp the white plastic plug and pull gently until free.''' '''Note''': The wires shown by the red circle are connected on the opposite side as the ribbon circuit.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UXmbTTxegcCrBktv.standard">
