  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JAGv11SDWIH1uhWt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the LCD screen away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
