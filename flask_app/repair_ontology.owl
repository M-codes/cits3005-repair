  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the rotary selector and controls up over the top. Holding the controls  in place, pull the two frame pieces apart. There is a connection between the motherboard and the LCD screen still attached to both halves, so don't pull to hard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aJffROmlsGJrlEyB.standard">
  <rdf:type rdf:resource="#Image"/>
