  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85779">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nKQra6kpWxatxrJ2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GhXddfuTMuTGK6nj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OY3CWgjeTDGF4Net.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the soldering iron to remove the red and black wires from the battery contacts. Be aware of the placement of the red and black power wires during reassembly.  Misplacement can cause further damage to you camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nKQra6kpWxatxrJ2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GhXddfuTMuTGK6nj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OY3CWgjeTDGF4Net.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85605">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QSHXpjsOiSpqNjTT.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Lbvoim4hFS1MuoRf.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finally, use the soldering iron once more to melt the wire contact points and detach the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QSHXpjsOiSpqNjTT.standard">
