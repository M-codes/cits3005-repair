  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the one visible screw that is attaching the flex assembly to the back of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pCwVB6wu2E3kQfVX.standard">
