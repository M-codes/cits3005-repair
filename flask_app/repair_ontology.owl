  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Detach the blue cable by sliding the pointed end of a spudger between the motherboard and the silver prongs connected to the cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/dySU2jNbGkNdY6To.standard">
