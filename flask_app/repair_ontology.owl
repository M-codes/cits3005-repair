  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SSmTDx1rxQetmqC4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xICshyDDXr2gQqRm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_45743">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xTScY1VesiLM6JUO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/p5GUSJ3U6xntbeLC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/c6LDlPFkUGkZpivM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure to take care in prying case apart. There are two wires (one red and one black) that could get disconnected from the motherboard. Gently seperate the two halves of the device. To remove the circuit board from the right section of the device, unscrew the two 5.6 mm Phillips #00 screws. When the screws have been fully unscrewed, use the tweezers to remove them from the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xTScY1VesiLM6JUO.standard">
