  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 3.5mm Phillips #00 screws that hold the back case - located on the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

