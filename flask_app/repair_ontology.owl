  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 3.4mm screws on the right motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
