  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YT5wvQ2DluRQBh4g.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace back panel. Make sure the metal part of the panel goes under the metal part of the rotating arm or the screw won't go in. Put the four screws back in from step 2 and 3 respectively. Step 2 screws go in the outside of the panel. Step 3 screws go in on the underside of the panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

