  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pop the LCD display out of its frame using the plastic opening tool  in order to get to the screws under the display. Use the plastic opening tool to complete this step</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/sQiUZHXRTQuiB3Yw.standard">
