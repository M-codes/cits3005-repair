  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uApBpWHMeiiVgAeF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/B6nV1iTMVqFdlHP6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3.4mm screw inside a deep hole on the back copper panel beneath the circular mode switcher. This screw is a little difficult to get out.</has_title>
