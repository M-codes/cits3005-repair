<owl:NamedIndividual rdf:about="#Step_147494">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xRNRn24hAWD6q6Is.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two, 4mm screws from the bottom of the camera. Continue using the same screwdriver from step 1.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xRNRn24hAWD6q6Is.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_148924">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3C1MbwJH1UilFaLt.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove back plate from the camera and locate the orange button plate to the right of the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3C1MbwJH1UilFaLt.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_151714">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tT6NfqtamaTw1eQM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/dpTqGx1x3unNBbqJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/KvdG5g1L2fqOJP4F.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the back plate is removed. Locate the buttons to the right of the screen. Using the tweezers carefully lift up the tabs connecting the buttons to the button plate. After lifting the tabs the buttons should come right off, then replace with the new button.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tT6NfqtamaTw1eQM.standard">
