  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the Phillips #0 6mm screw on the shutter mount and the washers using a size 5 nut driver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

