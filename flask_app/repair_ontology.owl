  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/EwYin6vJQRrnnHMU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the cover has been removed, you will want to remove the three Phillips screws (2mm headsize x 2mm length) that are underneath.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/EwYin6vJQRrnnHMU.standard">
