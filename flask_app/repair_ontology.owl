  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screw located above the center film strip. This holds the top frame in place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/sOG3IQmnDurRMWNK.standard">
