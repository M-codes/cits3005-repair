  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wMcfHPDTQBwp3uYN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the screwdriver wedged, pull the casing away from the device. Be careful not to damage any other parts in the process, apply force gently to prevent any further damages.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wMcfHPDTQBwp3uYN.standard">
