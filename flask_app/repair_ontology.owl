  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Underneath the button contact panel, you will find a large connector. Using the spudger as leverage, unplug the connector and pull it away from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

