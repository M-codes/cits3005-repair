  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peel off the adhesive leather screw cover and  remove the 2 screws under it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/tQIRQtySkXxALeSj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_201305">
