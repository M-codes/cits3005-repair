  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wtHJX1qIAmwLHscS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers to remove the small metal plate and the thin strip of black tape underneath it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wtHJX1qIAmwLHscS.standard">
