  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/x5Rq1HjT5CoDqVoP.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RAyXwjOeU4ZQxfnp.standard"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3.5mm Phillips screw from the grey tab on the top of the camera with a Philips Head screwdriver. Rotate the camera so the back panel is facing you. Remove the 1.4mm Phillips screw from the sliver tab near the top of the camera with a Philips Head screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

