  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the switch to the left to open the battery chamber using your fingertip or plastic opening tools. The spring loaded battery chamber door will swing open after the switch is moved.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

