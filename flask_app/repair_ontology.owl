<owl:NamedIndividual rdf:about="#Step_120848">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1iahwaR12kmYxLey.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the front plate off the camera body. It should slide off easily. If it does not, ensure that all screws and ribbon cables from previous steps have been removed or disconnected.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</has_order>
