</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_120194">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BxPhxv5RcJCniZEC.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/24qG21PMoPF15qTP.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bFoIAGf2cKngBUWn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Looking at the bottom of the camera, slide the OPEN/LOCK switch to the left into the OPEN position. The battery housing door should swing open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BxPhxv5RcJCniZEC.standard">
  <rdf:type rdf:resource="#Image"/>
