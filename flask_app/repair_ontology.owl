  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unclip the four connectors that hold down the orange copper film strips. Then carefully pull out the three film strips with the ifixit plastic opening tool.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

