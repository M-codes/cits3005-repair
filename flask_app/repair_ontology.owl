  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use an Exacto knife to cut the white calking on the side of the side panel Pull the side panel away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

