  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96128">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vGgdR64sKODLtCDQ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/tGyAwZUNbMt2uWQj.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IWtEiUXOVOhX2rJi.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the curved tip tweezers to detach the metal plate that holds the screen in place. There are four latches you will need to detach. Remove the metal plate from the rest of the LCD screen panel.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

