  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3 mm screw that sits at the bottom of the camera, near the front side. Remove the 4 mm screw that sits at the bottom of the camera, near the back side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

