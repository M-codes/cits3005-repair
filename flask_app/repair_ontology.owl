  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by removing all six #00 screws holding the outer chassis together with the Phillips #00 Precision Screwdriver. Remember to keep track of all screws as they are small and very easy to lose</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
