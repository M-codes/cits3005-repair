  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the left-hand side of the camera screen, unscrew and remove the four 3mm screws, as shown in the photograph. On the right-hand side of the camera screen, unscrew and remove the two 3mm screws. On the bottom of the camera, unscrew and remove the three 3mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

