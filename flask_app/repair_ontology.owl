  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3.5 mm Phillips #00 screw on the side of camera - located between the charging and HDMI ports. Remove the 4.0 mm Phillips #00 screw on the side of the camera - located next to the WiFi sign.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

