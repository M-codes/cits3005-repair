  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The red wires may be adhered to the CPU as indicated and will need to be severed as shown. Be careful not to scratch the CPU in this step. This is not a wired connection. Sever the  additional adhesive connections so that the wired connections may be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

