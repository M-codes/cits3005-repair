  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the opposite side of the camera, remove the two 3 mm screws. Remove the bottom side panel and place it with its respective 3 mm screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

