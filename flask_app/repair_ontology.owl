<owl:NamedIndividual rdf:about="#Step_44244">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pVTNFROrLVEquMs1.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DviSDkml5nnYZ3WW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The picture viewing screen is glued to the backing as well as wired in with pink and white wires. Exert minimal force required to pull the screen loose from the camera Remove the pink and white wiring from the internal paneling.  These wires are soldered in Remove the orange data hookup cable which feeds into the back circuit board</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pVTNFROrLVEquMs1.standard">
