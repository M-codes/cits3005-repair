  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the LCD screen from the casing of the camera Now you may replace the back case with a case with working buttons.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NQRfpYJ31Bp13y2J.standard">
