  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bZGIWd4P1croQtCU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/sRJDvXAHc2udt51B.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finally, pull the lens assembly away from the camera frame. Make sure that none of the ribbon cables are tangled up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

