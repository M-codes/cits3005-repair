  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that the panel is off, unscrew the 9mm screw holding the battery notch in. Use the pliers (or your fingers) to take off the white notch. There is a spring underneath the battery notch. Do not lose this spring or let it fall off.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

