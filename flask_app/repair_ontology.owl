  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6AII3ElOi5rY5rS2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The button will pry off easily and shouldn't take much force</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

