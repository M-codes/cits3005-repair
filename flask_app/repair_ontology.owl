<owl:NamedIndividual rdf:about="#Step_198016">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/taQHTAlNWNFfTTGm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert the flat end of a spudger underneath the motherboard and twist. This will disconnect it from the rest of the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/taQHTAlNWNFfTTGm.standard">
