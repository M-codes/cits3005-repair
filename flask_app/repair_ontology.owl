  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GoPro Hero+ LCD Motherboard Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_109996">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jkj2rKFchNDjXfLu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3Uwc4ndlw6bWNVaD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rZDhlx5IFsAuT1IO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 6 mm Phillips #00 screws. Remove the single 4 mm Phillips #000 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jkj2rKFchNDjXfLu.standard">
