  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198321">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_flathead_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UpS34jTNLg1XrITV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fAhdrSu4O6dYSkVR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6DUKVBxfniTFDGbZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the camera by removing the 5x4.0 mm external screws with the 1.0 flathead.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UpS34jTNLg1XrITV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fAhdrSu4O6dYSkVR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6DUKVBxfniTFDGbZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198322">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4RwdRfWvobRm4hPd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SrUAS1OKfAQbF6WQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the top and bottom apart. Make sure the circular spring on the back of the door is intact by manoeuvring the lens barrier and finding the sticking point.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4RwdRfWvobRm4hPd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/SrUAS1OKfAQbF6WQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198323">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NCICGHSueb5RNUMn.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pMhJClwAR21XYBQM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the thin, flat orange cable connector that operates the lens barrier and connects it to the main circuit board. Check to make sure the cable is not stuck or broken.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NCICGHSueb5RNUMn.standard">
