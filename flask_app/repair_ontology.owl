<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/X12mCJjkt2MLHbEM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_37587">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/35SCVriqAopuMvWf.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/SnHLvRpiphWoFeeV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the bottom is free, continue pulling to free the top of the strap mount cover from the frame.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/35SCVriqAopuMvWf.standard">
