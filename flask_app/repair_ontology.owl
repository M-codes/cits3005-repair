  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use your fingers and carefully pull out the motherboard from under the lens. It may take a little bit of adjusting to get it out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

