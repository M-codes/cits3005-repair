</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62967">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ERaBYbygfJK5PUMM.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/C5TQELHJQQsaW1PU.standard"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Put the camera with the lens facing up, turn it to the side where the compartment of the battery (CR1220) for time/date is located. Unscrew the black 3.4 mm screws with a #00 Phillips screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

