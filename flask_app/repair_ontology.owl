  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a spudger, gently separate the back panel from the rest of the camera and remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
