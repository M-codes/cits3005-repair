  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the battery from the camera by pulling the battery door outwards.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

