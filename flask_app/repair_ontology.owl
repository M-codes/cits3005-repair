  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you see why the electrical tape is needed for isolation. If the connector roll is touching the wrong parts you may get a short cut, that may brick your PCB.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/raIwCRLdAZFtsosU.standard">
