  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Then unscrew the remaining screws holding the back plate to the LCD. Then simply remove the plate with the LCD.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

