  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a PH0 Philip’s screwdriver, unscrew and remove the two 1.2mm Philip's screws located on opposite sides of the lens mount. Using your fingers, pull off the lens housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
