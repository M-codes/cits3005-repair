  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the yellow tab towards the back of the camera. The battery should pop out. Remove the battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/25iLjt3MANUhMmPP.standard">
