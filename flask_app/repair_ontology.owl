<owl:NamedIndividual rdf:about="#Step_37199">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cgvSgeTe2UDXDCXN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/flRoaqm4BEMWplmk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ISgKOL3s4SrMasgn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the batteries and the memory card from the camera, if so equipped. The batteries can be located on the bottom of the camera, and the memory card can be located on the left side of the camera. Remove the three screws on the bottom of the camera, where the battery hatch is located. Remove the two screws on the left side; this is one of two short sides and is the same side of the memory card storage.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

