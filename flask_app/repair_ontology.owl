  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use tweezers or a finger nail to peel back the rubber cover on the left handgrip. Remove the 3.4 mm Phillips screw. Remove the 3.7 mm screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

