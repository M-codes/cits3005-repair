<owl:NamedIndividual rdf:about="#Step_126800">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/p6LTJMDEyaxProCn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screws from the silver back-plate with a PH000 screw head. Two 1.5x2.5mm screws on the left side. One 1.5x2.5mm screw on the right side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/p6LTJMDEyaxProCn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_126807">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rGkabYPoMZBsPrZb.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The marked red box contains a highly charged capacitor. Check the charge  using a voltmeter and discharge it first before  continuing. [https://www.ifixit.com/Guide/Constructing+a+Capacitor+Discharge+Tool/2177|Discharge capacitor guide]. Remove the screws holding the motherboard with a PH000 screw head. Two 1.5x2.5mm screws on the right side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rGkabYPoMZBsPrZb.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_126810">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MD3sHDNaPxb4IlQg.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a plastic opening tool or fingernail, pop up the black clips holding the ribbon cables. This will release the cables. Slide the ribbon cables out of the connectors.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MD3sHDNaPxb4IlQg.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_126811">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pIVSU4ie5OqsCXNh.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NKeJxUKGVuCf5NEk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/gYCkJNS6FRvoQDC4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black sticker covering the electrical connections. Desolder the eight wires from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pIVSU4ie5OqsCXNh.standard">
