  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the ribbon wire attached at the bottom right corner of the front of the camera.  You do NOT need to remove this from the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

