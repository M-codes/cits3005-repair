  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Try to isolate but do not cover the writings on the PCB so you can still see, what is already wired.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

