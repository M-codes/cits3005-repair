  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pry the tab holding the ribbon cable connecting the cameras control board to the camera sensor and battery housing. The camera control board is now removed and can be replaced if faulty.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

