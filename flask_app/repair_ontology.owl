<owl:NamedIndividual rdf:about="#Step_38469">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bjLu4EeNiRlkLMop.standard"/>
