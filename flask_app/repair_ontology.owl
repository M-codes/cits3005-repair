  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the bottom part of the case away from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

