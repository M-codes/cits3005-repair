  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TwRiMN3tAJAZYK5m.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the five 4 mm Phillips #000 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
