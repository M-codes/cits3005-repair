  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bRTOhoMJIdvPe5Se.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you have separated the back half of the camera from the rest of it. If you have problems with your menu buttons, you must replace the entire back half of the outer case. Not including the screen. If you do not have problems with your menu buttons ONLY your snap button (the one that you push to take pictures) skip ahead to step 7</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/bRTOhoMJIdvPe5Se.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

