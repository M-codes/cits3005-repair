  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the bottom of the camera, locate the USB port. Gently slide the USB cover off of the camera with your fingers or tweezers. You can replace the USB cover by purchasing one from a local electronics store or online at iFixit.com.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

