  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The LCD display screen is now removed from the camera sensor and battery housing. The main camera controls are now removed from the camera sensor and battery housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

