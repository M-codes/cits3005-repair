  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the black, white and the beige wires. Desolder these wires at the point of connection with the bulb. See the guide on this link for [https://www.ifixit.com/Guide/How+To+Solder+and+Desolder+Connections/750|soldering and desoldering].</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

