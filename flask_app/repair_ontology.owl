  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are a guhzillion tiny screws and pieces in this lens. Get a bunch of ziplock baggies to hold each piece and its screws. Trust me on this.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

