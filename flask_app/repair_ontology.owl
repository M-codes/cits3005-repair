  <has_step rdf:resource="#Step_154491"/>
  <has_step rdf:resource="#Step_154492"/>
  <has_step rdf:resource="#Step_154493"/>
  <has_step rdf:resource="#Step_154494"/>
  <has_step rdf:resource="#Step_154495"/>
  <has_step rdf:resource="#Step_154496"/>
  <has_step rdf:resource="#Step_154497"/>
  <has_step rdf:resource="#Step_154498"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sony Alpha ILCE-6000 Screen Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_phillips_0000_screwdriver">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154227">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Pllu45jPAOo6Sk4e.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn off the camera by sliding the power switch to OFF.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Pllu45jPAOo6Sk4e.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154228">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rQ1bgYRMjNFFyEnu.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cVeVTnwQDDCYyyap.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/5QKyShWcUPcQA15R.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera upside down and locate the battery compartment. Slide the compartment lock to OPEN to unlock it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/rQ1bgYRMjNFFyEnu.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cVeVTnwQDDCYyyap.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5QKyShWcUPcQA15R.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154229">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VF3KUNViysoSckY2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/S6IOnU3kDDjdOYBV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the blue lever that keeps the battery in place. Push the blue lever back to release battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VF3KUNViysoSckY2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/S6IOnU3kDDjdOYBV.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154230">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PTjTNsRFKhZUXES5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the battery is free, you are able to take the battery out of the compartment.</has_title>
