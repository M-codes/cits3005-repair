  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the motherboard from the casing. Carefully remove the large ribbon-wire by pulling the wire where it connects with the motherboard. In order to completely remove the motherboard, you must desolder the small ribbon wire from the casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</has_order>
</owl:NamedIndividual>

