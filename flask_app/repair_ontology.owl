  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canon PowerShot SD780 IS Flash Capacitor Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62980">
  <rdf:type rdf:resource="#Step"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by making sure the camera is turned off and the battery has been removed to avoid any shock injuries.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62981">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J3XZHpsgp3RkHJHm.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TNtxNFEQDkGO4qbE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Having removed the battery, you can begin removing the outermost screws on the camera to allow for case replacement. There are 5 screws in total. This will require a Philips head # 00 screwdriver. Keep track of where each screw came from in order to avoid complications during the reassemble process. The screws highlighted by the red circles in the second image (on the left side in the first image) are 2.0 mm long.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/J3XZHpsgp3RkHJHm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TNtxNFEQDkGO4qbE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62983">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/TaAWp2ZYUjOSQ1j4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the front panel of the camera case to expose the top left copper strip, and gently pull the strip upward to disconnect from camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/TaAWp2ZYUjOSQ1j4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62984">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AaXQ1BEnVbodmQZD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screw on the far left hand side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AaXQ1BEnVbodmQZD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62985">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AbiqvLHg2NjOrx4Y.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that you have removed all of the screws, carefully pull the case apart at the seem. The case will detach from the camera in two pieces.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AbiqvLHg2NjOrx4Y.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_62995">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/6rnyDBS126AdAe1E.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the image stabilizer on the top right of the camera and pry the internal battery away from the camera. Having done this, the internal battery can be removed easily.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

