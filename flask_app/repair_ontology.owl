  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Phillips #00 head to remove the following 5.5mm screws and remove the lens compartment by carefully pulling it out of the metal casing. Do not pull the lens compartment too hard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</has_order>
