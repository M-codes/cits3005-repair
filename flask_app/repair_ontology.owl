  <has_procedure rdf:resource="#Procedure_53868"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_53867">
  <rdf:type rdf:resource="#Procedure"/>
  <has_tool rdf:resource="#Tool_ph000_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_1.5_flathead_screwdriver"/>
  <has_tool rdf:resource="#Tool_magnetic_pickup_tool"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_step rdf:resource="#Step_118847"/>
  <has_step rdf:resource="#Step_118849"/>
  <has_step rdf:resource="#Step_118848"/>
  <has_step rdf:resource="#Step_118850"/>
  <has_step rdf:resource="#Step_118851"/>
  <has_step rdf:resource="#Step_118852"/>
  <has_step rdf:resource="#Step_118853"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fujifilm FinePix Z90 LCD Screen Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_magnetic_pickup_tool">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118847">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_magnetic_pickup_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cKlnWpAu63mVst2L.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fMuFlsNEGgRoKrPw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a small #000 Phillips screwdriver to remove all the screws and the magnetic pickup bit to take the screws out easily once they are unscrewed. Keep all the screws in a container and the two different types separate. Remove the two screws on the right side. On the same side there is USB connector, open that little door and unscrew the little screw inside of it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cKlnWpAu63mVst2L.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fMuFlsNEGgRoKrPw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118849">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/cMRGVMcgyZYKIBXK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aVtEivnRTdyQfFwy.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Take the two screws on the left side and the two screws on the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/cMRGVMcgyZYKIBXK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aVtEivnRTdyQfFwy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118848">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZVbYPNiM44F4bonR.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/wuPGTd6asvCf1qCd.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JYAwhSssTqdVFOYU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the camera case from the screen side and then release the lace out of that little frame on the right side. There will be a ribbon cable attaching the front panel to the motherboard, be sure not to tear this.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZVbYPNiM44F4bonR.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/wuPGTd6asvCf1qCd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/JYAwhSssTqdVFOYU.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118850">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/jsD6FNwdxm1LD1gD.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ABZGYmrIBPD5IvYW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the three screws of the frame next to the ribbon cables attaching the LCD to the motherboard. Unscrew the screw on the middle of the right side, where the lace is attached.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jsD6FNwdxm1LD1gD.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ABZGYmrIBPD5IvYW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118851">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2LHY1QWxIKCXXGQA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the LCD screen to the left slightly, lift it and flip it open to the right. There is also a ribbon cable attaching the LCD screen to the motherboard, be careful not to tear it. Be careful by tearing the electrical tape out first.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2LHY1QWxIKCXXGQA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118852">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HnyIQxKZVA2PAnKo.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/4h55HPKnenqqE1R2.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mnssFMgnxgVVCORQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a small flat head screwdriver or a plastic opening tool flip open the black lever to release the ribbon. Gently slide the cable out of the lock; the LCD screen is now ready to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HnyIQxKZVA2PAnKo.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4h55HPKnenqqE1R2.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mnssFMgnxgVVCORQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_118853">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vsc2fc35o1fSVgMN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FrjZfXOlabsXmDA4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using your index finger, guide the cable of the new screen into place. Lock it in by pushing the black level back down. Make sure that after replacing the new LCD screen make sure to put the ribbon cable frame back in the right spot to secure the ribbon cables.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vsc2fc35o1fSVgMN.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/FrjZfXOlabsXmDA4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Procedure_53868">
  <rdf:type rdf:resource="#Procedure"/>
