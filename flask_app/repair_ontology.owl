  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the components apart. Remove the 2.0mm screw to the left of the SD card. The LCD screen is located on the back of the circuit board and can be accessed after removing the internal components.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

