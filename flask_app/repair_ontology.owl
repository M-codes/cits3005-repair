<owl:NamedIndividual rdf:about="#Step_83422">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ingM2pQpxUHCcJTA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OV2r3Q3dEyC3p12i.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On the bottom of the camera, use your thumb and push the battery lock up to open.  The battery compartment door should then spring open and batteries will slide out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ingM2pQpxUHCcJTA.standard">
