  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/r1e5PuGaIhXloVrr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4.8 mm Phillips screws securing the battery side of the rear cover to the D70.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
