  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera over again so that the rear is showing and remove the two .065 inch screws holding the flash unit in place. They should be on the left side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
