  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aQfqN4DcARi4UYOH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that there is a capacitor in the flash bulb assembly, under the small circuit board. Do not touch the two metal terminals, as the capacitor may discharge. Damage and personal injury may result. Use the spudger to carefully lift the flash bulb out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

