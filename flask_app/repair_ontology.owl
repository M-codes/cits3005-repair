<owl:NamedIndividual rdf:about="#Step_128033">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fS5UcOW6LpCqCOJb.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eOPywfoJRcOkfpYX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QocaMwx5jY3oTEEj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 7 screws on the outside of the camera Two 5 mm PH000 screws on the right side of the camera body Four 3mm PH000 screws on the bottom  and the left side of the camera body. Use the plastic spundger to push the back casing out. Start from the right side and work your way clockwise around the case. The HDMI / AV tab might fall out. this is supposed to happen as it is not screwed into place in the back casing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

