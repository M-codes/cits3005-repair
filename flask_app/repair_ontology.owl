<owl:NamedIndividual rdf:about="#Step_20787">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BAOqcKk1hmR1ELFd.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two 2.4mm Phillips screws from the right side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BAOqcKk1hmR1ELFd.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20788">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/B1jNCRJJK1HAqj5r.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove two 2.4mm Phillips screws above the label on the bottom of the camera. Remove two 2.8mm Phillips screws next to the tripod hole.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/B1jNCRJJK1HAqj5r.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20789">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RhasuYkms6yQROUn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 3.2mm Phillips screws that are closer to the top and bottom edges of the camera. Remove the two 3.8mm Phillips screws on either side of the strap base.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RhasuYkms6yQROUn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20790">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aInHbZxnnndrdSsZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove one 1.6mm Phillips screw from the above the CF open button on back of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aInHbZxnnndrdSsZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20791">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CBnYxBkPtsmfOuSv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HcsYLUCi2AOraWa1.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yoPyEQMOUYwCRHoG.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the front casing from the camera. The following items will either fall off or will be loose: the strap base, the gray rubber cover labeled "Digital A/V Out", and the black rubber piece over the view finder. Remove the memory card cover by sliding down the CF open button and moving the pin.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CBnYxBkPtsmfOuSv.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HcsYLUCi2AOraWa1.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/yoPyEQMOUYwCRHoG.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_21645">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CKisYQZxVD1kXeop.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pnmaHqVLrd16blyx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently pull the back casing from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CKisYQZxVD1kXeop.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pnmaHqVLrd16blyx.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20793">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/I6lQtuOxYFB1qLCK.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eRXCNY2pbWTihHvj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate the reverse side of the buttons by looking at the inside of the back camera casing. Locate the button sensors, which connect to the logic board by a connecting ribbon, by looking at the back of the camera once the back casing has been removed. The button sensors on the back of the camera should appear to match up with the reverse side of the buttons on the inside of the back camera casing. Imagine one as being the reverse image, or mirror image, of the other. This will help you locate where a problem is occuring if a button or a button sensor has been damaged.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/I6lQtuOxYFB1qLCK.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eRXCNY2pbWTihHvj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20794">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/mOoHosxGNDJ3k63V.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove one 4.3mm screw directly below the power button on the top of the camera. This screw attaches the entire panel for the power and picture-taking buttons. Be sure you are removing the screw from the top of the camera, as it is close to another screw on the back side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/mOoHosxGNDJ3k63V.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20795">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HDg5JkOfukDA3dYH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YkZQQTXMCwllYa2C.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently lift the button panel from the top of the camera. This is what the reverse side of the button panel looks like after removal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HDg5JkOfukDA3dYH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YkZQQTXMCwllYa2C.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20955">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/COFDxdVdpE3ypiCQ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 3.9mm screws holding down the copper flap that insulates the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/COFDxdVdpE3ypiCQ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_20957">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GhZS5jiHaUQ2wYlp.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MRNolxZ1h3UD4w2t.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ryY54TMyD4Z4VjPI.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The motherboard can be damaged easily and must be treated with care. Try to avoid removing ribbon cables with your fingers, since motherboards are extremely sensitive to static discharge. Use a spudger or plastic opening tool to lift any flaps or tabs or to pry connectors straight off their sockets on the motherboard. Before the motherboard can be removed, several ribbon cables must be disconnected from their respective ports. A few of the ribbon cables are held in place by locking ZIF connectors, which you must release before removing the cables. Removing each ribbon cable may require a gentle tug. First, release the ZIF connector securing the ribbon cable in the bottom left corner of the motherboard. To do this, insert the flat end of a spudger under the connector's dark brown flap and gently wedge the flap open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GhZS5jiHaUQ2wYlp.standard">
