<owl:NamedIndividual rdf:about="#Step_22080">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rWNTLx6Vlib1PEpX.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hVHXs6YTDsjKlSB6.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reorient the camera so you are looking at the front with the lens in the upright position. Remove the 4.3 mm black screw in the upper right hand side of the camera as well as the 4.3 mm silver screw in the lower right hand side of the camera. Reorient the camera so you are looking at the back with the metal plate on the right side.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

