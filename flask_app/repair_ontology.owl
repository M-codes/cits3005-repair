  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3mm screw from the bottom of the camera. Once you have the 2mm and 3mm screws out, gently pull the sides up with the smallest plastic opening tool. This will reveal the inside of the camera. Be sure to remove the battery before continuing your repair.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

