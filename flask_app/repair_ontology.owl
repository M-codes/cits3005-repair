  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the LCD screen from the side opppsite the battery terminals. Watch for the two cords mentioned in the previous step. These will still be connected.The side will flip up as shown in the next step.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/5GmxdOeNVU4BpP1G.standard">
