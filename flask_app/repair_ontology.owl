</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_177951">
  <rdf:type rdf:resource="#Step"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are two screws that hold the eye piece on to the main housing, just underneath.  Remove these.  Once these have been removed, gently pull and remove the eye piece and remove  the now accessible top two screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_120962">
