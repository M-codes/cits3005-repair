  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pL6vROgghEGJB2p2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera so that the back is facing to your right. Remove the 5mm Phillips #000 screw above the rubber USB port cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
