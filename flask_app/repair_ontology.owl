  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/jg4RkuSthod1iUcZ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_123340">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QnCtIMk1sgQAHfHU.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AsqAraXGFIiI5b2X.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While securely holding the HDD in your left hand, use the soft pad of your right hand fingers to gently pull the ribbon wire out of its socket, toward your right. The HDD is now free from the device. Replace HDD.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/QnCtIMk1sgQAHfHU.standard">
