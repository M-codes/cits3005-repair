</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/KOTHDhJLy4nNikLs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_83438">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2mrGZ5sLjnDOE1EW.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/kUi1E6ZmlqUl5PXP.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JTZZGCHvNo6tgFrk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly and gently pry open with your hands to separate the back case panel from the rest of the camera. The gray rubber cover labeled DC IN DIGITAL A/V OUT may fall out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

