<owl:NamedIndividual rdf:about="#Step_96571">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hXfQoiTdLdeRD5lE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the black M1.4 X 3.5 Phillips head screw in upper right corner of the device. Service manual for reference: [https://docs.sony.com/release/mdsm/983465933_sm.pdf#page=26|Click to go to the service manual.]</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hXfQoiTdLdeRD5lE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96573">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pohNPEBYfANOQEg4.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reorient the camera so you are looking at the "top view". Remove the black M1.4 X 3.5 Phillips head screw next to the ON/OFF button circled in red.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pohNPEBYfANOQEg4.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96961">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/BxxWohDoBdKBMDbl.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orient the device so you are looking at the "bottom view". Remove the black M1.4 X 3.5 Phillps head screw located next to the tripod attachment.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/BxxWohDoBdKBMDbl.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96575">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/H4OymIoiSP2CkNLm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the aluminum back plate. This should not take much force. If it doesn't come off easily, there is probably a screw still in. Take note of the back plate's orientation for reassembly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/H4OymIoiSP2CkNLm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96578">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/k3SASvYqrYlxQs5u.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/X1XvrRid6OhNtctk.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The connections (red squares) have small black retaining clips. Using a plastic opening tool, lift upward towards the cable to unlock. The upper ribbon cable simply pulls loose. There is no retaining clip securing this ribbon cable.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/k3SASvYqrYlxQs5u.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/X1XvrRid6OhNtctk.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96983">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AF2MtsaFXXRNNrNO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lift the lens block from the case. You may need to gently push on the front part of the lens, from the front of the device, to help free the lens block. If you must, push on an edge, not the shutter.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AF2MtsaFXXRNNrNO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

