  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swing out the screen on the back of your camera by 90 degrees. Remove the two 2.2 mm Phillips #00 screws on the outside edge of the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
