  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the plastic opening tool to carefully start lifting up the camera's left-side panel. Then use your fingers to pry off the rest.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

