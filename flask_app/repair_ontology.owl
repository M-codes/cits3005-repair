  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Separate the back of the camera frame from the body by taking apart the bottom and the sides of the camera. This will require a little force. You will feel tension and hear clicking noises. That is normal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

