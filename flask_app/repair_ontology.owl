<owl:NamedIndividual rdf:about="#Step_125216">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2OLSAdrvmW4J2YHF.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QKPlAcFedFNOriAV.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/O2VEKWfCyFBrU5ZO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the lens housing by pushing it, from the front, through the housing and lifting it out. Gently pull on the large ribbon wire (connecting the Lens housing to the motherboard via ZIF connector) with the tweezers. Gently pull on the small ribbon wire (connecting the Lens housing to the motherboard) with the tweezers. Be careful not to damage either of the ribbon wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2OLSAdrvmW4J2YHF.standard">
