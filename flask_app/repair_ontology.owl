  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the connector and move the black clip into the upward position, freeing the cable. Remove the LCD screen and the holder. While the camera is disassembled, use isopropyl alcohol to remove rust and clean the device. Follow these steps in reverse order to reassemble. The device should be fully functional upon completion.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

