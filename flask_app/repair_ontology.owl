  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Melt the soldered battery connections with a soldering iron and gently pull the battery wires away.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

