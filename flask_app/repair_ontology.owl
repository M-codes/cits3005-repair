<owl:NamedIndividual rdf:about="#Step_92984">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uEKVfxRVCsJobvAI.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IdIERUxdKqSK1oFO.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YCAWuWUgbNlNNbsD.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four following phillips #00 screws from the metal frame There should be two screws top right, one bottom left, and one on bottom of the frame The screw dimensions should follow: Top right should be 2.3mm and 3.6mm long. Bottom left should be 3.6mm and the bottom of the frame should be 1.6mm</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/uEKVfxRVCsJobvAI.standard">
  <rdf:type rdf:resource="#Image"/>
