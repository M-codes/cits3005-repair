  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the screen cover by applying slight pressure at the top, then pulling the screen protector away from the camera. Do not apply pressure to the surface of the LCD screen or it may be permanently damaged. If fingerprints are on the LCD monitor, gently wipe with a soft, clean, dry cloth.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4vhuFZBHUXYHJI3q.standard">
