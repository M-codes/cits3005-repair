  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the main motherboard from the casing, which is connected to the flash unit, capacitor, and bottom motherboard. Do not damage or remove the cables connected to the motherboard. The motherboard is connected to the bottom motherboard by two wires. There are also two red wires on the outside of the motherboard.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oE2joK2BkWuT23A6.standard">
