<owl:NamedIndividual rdf:about="#Step_127242">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_y0_tri-point_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1if6GbS3KgoZGTpc.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First begin by flipping your camera upside down. Remove the seven 4mm screws from indicated circles shown using a Y0 screwdriver. There are three on the bottom, and two on each side Remember to store the screws in a secure place.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

