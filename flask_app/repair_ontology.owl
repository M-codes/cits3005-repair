  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4.5 mm screws that sit next to the battery slot. Remove the 3 mm screw that sits below the CF card slot. Remove the 4.5 mm screw that sits above the digital I/O cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

