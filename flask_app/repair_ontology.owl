<owl:NamedIndividual rdf:about="#Step_118003">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/qFdAyjwBVmjTdOQB.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/NwflfPkmhbV4SBau.standard"/>
