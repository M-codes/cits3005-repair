</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/4t5IJfQ2ioegABlH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_22174">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/aR65oqdcViu3r2Iy.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vLvvGNvMn5aXM1Qt.standard"/>
  <has_tool rdf:resource="#Tool_ph0_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the door to the CompactFlash memory card slot by sliding it towards you and swinging it open. Remove the memory card if it is still in the camera. Use the Phillips screwdriver to remove the Phillips screw (shown) underneath the memory card slot door.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/aR65oqdcViu3r2Iy.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

