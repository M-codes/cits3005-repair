  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pCKtBs14WsJZgKaN.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/iB6iTFVJdiWbO1IZ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the silver 2mm screw from the protection panel. Unscrew the three black 8mm screws from the protection panel. Be sure to remember where these screws go, inserting a longer screw in a short slot can damage your device! Remove the protection panel entirely.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

