  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the battery chamber and remove the battery. Pry the front half of the casing from the camera. Be careful that the sensor cover—the small piece of translucent plastic—doesn't fall out of place. Return it to its original location if it does.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

