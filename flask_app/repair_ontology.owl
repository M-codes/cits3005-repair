  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press down on the metal plate and gently lift the motherboard up from left to right. Be cautious when lifting the motherboard since there is a copper ribbon and two wires attaching the motherboard to the flash unit. Reorient the camera so you are looking at the top edge with the metal plate on the right.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
