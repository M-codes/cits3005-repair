  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently remove the LCD screen from the circuit board. There will be a ribbon cable and some wires attached to the LCD screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
