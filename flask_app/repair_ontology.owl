  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/g4xwtnHAS122J54E.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ejJlmHhfgacgVElv.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/1iMX3hXcDj5DtXAY.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing both plates, remove the 2 (1.75 mm) Phillips screws on the bottom of the LCD screen. Take off the 2 metal sliding side components. This will allow for us to slide off the screen.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

