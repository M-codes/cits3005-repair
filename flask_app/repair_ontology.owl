  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sanyo VPC S1275 Logic Board Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tool_capacitor_discharge_tool">
  <rdf:type rdf:resource="#Tool"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12173">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/APrtyVswdnflVeRW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the #00 phillips screwdriver remove the four screws on the outer edge of the LCD holding plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/APrtyVswdnflVeRW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12177">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CDOCgBKVELP4n6gr.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be careful when rotating the plate in the next step to prevent the ribbon in the top right from ripping. Using your right hand grab the left side of the LCD holding plate and rotate it to the right.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CDOCgBKVELP4n6gr.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12178">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/pZloQheqqj5lsHmH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the ribbon from its slot by gently pulling the LCD holding plate to the right.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/pZloQheqqj5lsHmH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12179">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_capacitor_discharge_tool"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VAMeMFmhdl2uE1TH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YFxdF6odKFDtLTZm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not touch ANY part of the logic board previously covered by the black film until the capacitor has been completely discharged. This camera has a 330V, 100 µF capacitor which can cause painful electric shock. Using the spudger (or any non-metal prying tool), gently remove the black film.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VAMeMFmhdl2uE1TH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YFxdF6odKFDtLTZm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12180">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_capacitor_discharge_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Eqa1EUuQFDGx5iKM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the capacitor discharge tool carefully touch each end of the capacitor discharge tool to the each terminal of the capacitor. Click the link below for instructions on how to make the capacitor discharge tool: [guide|2177] NEVER touch both both capacitor terminals with just one of the wires. This will create a large potentially dangerous large spark. This will also cause serious damage to the camera. Keep the wires connected to the capacitor terminals for 2 minutes to completely discharge the capacitor The camera should be completely safe to handle now.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Eqa1EUuQFDGx5iKM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12626">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RNKcWOiVDS5ACgUw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Touch the hot tip of the solding iron to the first solder connecting the flash mechanism to the logic board until the solder melts. Repeat this for the next 10 solders. Verify solders have detached logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RNKcWOiVDS5ACgUw.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12635">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Aew11Pq3GxfpLWsE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Touch the hot soldering iron to the solder in the lower left corner connecting the logic board to the red wire. When the solder has completely melted, gently pull the wire free from the logic board. Repeat for the red, blue, and then black wires.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Aew11Pq3GxfpLWsE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12628">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_soldering_station"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VQ6ecrKnKhBexvRe.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LlQVCoLbfYaoCBCx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Touch the soldering iron tip to the solder in the upper right corner connecting the logic board to the battery lead. Pull the battery lead out of the slot in the logic board. This must be done immeadiately after the solder melts. Repeat for the solder to the left. The logic board will now be completely free from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VQ6ecrKnKhBexvRe.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LlQVCoLbfYaoCBCx.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12665">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/OmPKkQURSXXXUqQ5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">insert the battery leads into the slots in the new logic board. Solder both leads to the logic board.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/OmPKkQURSXXXUqQ5.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

