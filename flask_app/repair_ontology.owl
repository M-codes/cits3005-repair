  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_96141">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZIncbIkLdLSjE2yg.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DZvQFa4RvrMOgERc.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AXu2JBi2sGHJxJQW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the wires have been desoldered, pull the flash out of its casing. Remove one end of the rubber band holding the bulb in place. Slide the bulb out of the flash.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

