  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nikon Coolpix L820 Device Ports Replacement</has_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_94862">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/xvDHLckIul1CGXqM.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by removing these five screws</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xvDHLckIul1CGXqM.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

