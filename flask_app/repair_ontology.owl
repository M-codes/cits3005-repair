<owl:NamedIndividual rdf:about="#Step_14608">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MdQOCkVQ1tsYw2sC.standard"/>
