  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove copper sheet from the front paneling and back. You will need to use a spudger to unsolder the copper paneling Use the spudger to separate the back circuit board from the camera</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

