  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gently turn the device over. Carefully pry up the ribbon cable. It may be helpful to work from the lower right corner where the ribbon curves.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</has_order>
</owl:NamedIndividual>

