<owl:NamedIndividual rdf:about="#Step_81676">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fIgm3xhoHANN3H6Z.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ELFZ4nVS2fXZoLt3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the bottom of the camera facing you, slide the latch on the compartment to the left. Swing the battery compartment door open. Remove the 3.5 mm screw from the inside with a #00 Phillips screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/fIgm3xhoHANN3H6Z.standard">
