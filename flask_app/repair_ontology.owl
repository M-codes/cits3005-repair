<owl:NamedIndividual rdf:about="#Step_85599">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ldxsy2lHHMZlVEYs.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are total 6 Phillip-head screws with the size of 2.93 mm on the outside of the camera. To open the case, first gently remove the 2 screws at the bottom of the camera. Make sure the battery compartment door is in lock position.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ldxsy2lHHMZlVEYs.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85601">
