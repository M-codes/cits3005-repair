</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_33609">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rouutvIqHOlHvMfH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/hI4PAHenWPLbEQFg.standard"/>
