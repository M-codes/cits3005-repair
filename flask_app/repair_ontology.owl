  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 3 screws under the battery flap and remove the bottom cover.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/kxJSNZycpJsO2bIe.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_198193">
