  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flip the camera upside down and remove the 5.4mm screw below the lens bezel on the front of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IQ1vVri2SYLETprn.standard">
