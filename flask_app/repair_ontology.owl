  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Poke the capacitor out of its housing with the spudger.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/sQyvAMGVXPRYRXWF.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12668">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/QoOVOYNlRRG6GkOb.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/e5dsGxNVHtjVYdSB.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Break the tabs on the camera housing that hold the flash logic board. Lift up on the logic board. The capacitor and the flash bulb will be removed as well.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</has_order>
</owl:NamedIndividual>

