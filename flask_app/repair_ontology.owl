  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZGaUhhNrHlAdVUK3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raise the screen by wedging the spudger between the bottom of the screen and the mount hole.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZGaUhhNrHlAdVUK3.standard">
