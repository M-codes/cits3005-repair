  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a Phillips head screw driver, remove the two screws for the metal plate on the bottom. Detach the smaller ribbon cables by  sliding them out. Detach the large ribbon cable by flipping the small black holder in an upright position and then sliding the cable out carefully. Detach the ribbon cables slowly and carefully or they will rip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

