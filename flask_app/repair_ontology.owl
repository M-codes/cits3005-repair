  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the top cover up slowly. A ribbon cable is attached to the bottom of the top cover and the camera. Pull up very carefully to avoid damaging this.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/hbDYhRkqASC1XyJ3.standard">
