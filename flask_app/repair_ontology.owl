  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Release the plastic locking tab of the upper ribbon cable with the plastic spudger. Pull the top ribbon cable from its mount with the fine tip metal tweezers. Remove the bottom ribbon cable with the fine tip metal tweezers by pulling it toward the flash switch side of the camera. The bottom ribbon cable does not have a locking tab; it simply slides in and out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/P2YGYGkIDjLyVUlK.standard">
