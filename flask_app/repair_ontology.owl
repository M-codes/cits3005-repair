<owl:NamedIndividual rdf:about="#Step_148887">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/oJvAogQaPnj2H6NA.standard"/>
