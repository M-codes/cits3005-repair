  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The battery compartment is located on the bottom of the camera. Place your thumb on the battery door. Slide the door away from the camera in the direction the arrow points to.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
