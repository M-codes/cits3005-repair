<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/xmwNjAxMpl2LRKdJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_170369">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nLWT6eTNswBJkHVL.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/StOAEUX4GPAvNSNJ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GqKON3apC5AAMeCU.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera around and locate the holes on the metal panel. With a heavy duty spudger, gently poke through the holes, releasing the lens from the main portion of the camera. With your index finger and thumb gently pull the full lens out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

