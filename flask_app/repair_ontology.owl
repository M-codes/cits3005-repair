<owl:NamedIndividual rdf:about="#Step_43797">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/DNAR6XvqGNonBwfE.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the switch on the battery cover labeled "CARD/BATT. OPEN." to the right. While still holding the switch, pull the cover down, allowing it to release and open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/DNAR6XvqGNonBwfE.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_43802">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/2YcGZ2tQ3mQKy4np.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tilt the camera slightly to allow the batteries to fall out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/2YcGZ2tQ3mQKy4np.standard">
