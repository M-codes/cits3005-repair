  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_154665">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YCQo1qhtXsJxbiXr.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/J2TVWQekPRGq2S5m.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ebUnhlBqmKOLsCor.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note from the wiring diagram the B3-connector of the PCB is unused. So we add electrical tape to isolate it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/YCQo1qhtXsJxbiXr.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/J2TVWQekPRGq2S5m.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

