  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the two 3.5mm Phillips screws from the side with the AV outlet. Unscrew the 3.5mm Phillips screw from the opposite side of the camera. Unscrew the six 3.5mm Phillips screws from the bottom of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
