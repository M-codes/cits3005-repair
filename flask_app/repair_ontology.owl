  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/YhhSLBNrxZ2WRyu5.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/uvPAqDocLXHZKXwn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the Diopter adjustment control sticker and remove the screw under it.</has_title>
