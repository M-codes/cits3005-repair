  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the four 3.4mm screws on the bottom of the camera around the tripod mount. Make sure to keep these screws separate from the previous 5.3 mm screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/6xccUTkl1BHbDwin.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_35569">
  <rdf:type rdf:resource="#Step"/>
