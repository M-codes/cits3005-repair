  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/MfAETGCnHJ56QLW3.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now that the cover with the screen attached is removed from the rest of the camera, locate the four screws at each corner of the LCD screen. Remove these four screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/MfAETGCnHJ56QLW3.standard">
