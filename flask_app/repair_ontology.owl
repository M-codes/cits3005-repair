  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry open the screen frame using a plastic opening tool. It may be necessary to start by prying at one end of the screen and moving around the edge of the screen frame, until it pops out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
