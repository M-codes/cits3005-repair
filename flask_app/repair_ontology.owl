  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_129390">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/AZZanNA2JmaLrdyw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/WGLSVCuwvWmoRe1E.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/yWE4n46vhGeekAdP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the flat edge of the plastic opening tool between the inner casing and the back outer casing. Push up on the plastic opening tool so that the back casing starts to lift from the inner casing. Lifting the casing too far may result in damage.  Lift the casing slowly.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/AZZanNA2JmaLrdyw.standard">
