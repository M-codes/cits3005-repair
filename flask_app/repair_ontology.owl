<owl:NamedIndividual rdf:about="#Step_142492">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rsZAamkHqfMkC6pk.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/bX4VOQ55GmpDOXDw.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sever the indicated adhesive connections to the motherboard allowing the wired connections to be removed. All wired connections to the motherboard are removed by the thin plastic male connector inserted into the larger female plastic connection. The regular black nylon spudger should be used whenever possible, especially around sensitive internal components.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

