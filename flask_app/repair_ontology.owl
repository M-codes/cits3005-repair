  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using the spudger, remove the mini speaker from the housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

