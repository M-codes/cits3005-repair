  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3ZLn5kSusVObauRO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn screen parallel to the camera. Refasten metal bracket with the screws from step 5. These screws are small, and you may need assistance in screwing them back in.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</has_order>
</owl:NamedIndividual>

