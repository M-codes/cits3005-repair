  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_29150">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ubBLM2VkvllEUNZm.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Remove upper left ribbon circuit by lifting black locking flap and gently pulling out.''' '''Remove the lower right ribbon circuit by gently pulling out.''' '''Remove the lower left screw.'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ubBLM2VkvllEUNZm.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_29152">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/XBlPijoDBSlmfJih.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Remove the three screws securing the rear circuit board.''' '''Lift up on the left side of the circuit board and gently pull to the left to dislodge.'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/XBlPijoDBSlmfJih.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_29651">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/CunS2G1UxZiECm3h.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/eANNQQfTbTTlMmdP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'''Gently lift the rear circuit board away from the camera.''' The film behind it is attached, but not securely.  Keep the circuit board and the film together to avoid damage. '''Rotate the circuit board 180 degrees so that it is directly below the camera.''' '''Now gently remove the front circuit board and rotate both the rear and front circuit boards 180 degrees so that they are directly above the camera (picture 2).'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/CunS2G1UxZiECm3h.standard">
