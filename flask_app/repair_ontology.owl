<owl:NamedIndividual rdf:about="#Step_113878">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/Kuf3XZUxAnXEhiQY.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HmhuPUcyqymaOvnH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Push the tab on the back of the device left to remove the plate covering the battery.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/Kuf3XZUxAnXEhiQY.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HmhuPUcyqymaOvnH.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_113879">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/nCvCa1KTBccODJEj.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the strip of tape on the battery to remove the battery from the housing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/nCvCa1KTBccODJEj.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_113876">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/i2omQKno2BjLCVpX.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert a plastic opening tool in between the front face plate and the black housing. Make sure you insert the plastic opening tool next to the microSD card slot. There is a small gap that will help separate the face plate.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/i2omQKno2BjLCVpX.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_113877">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ATG2vRDwKQMFMqTO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Continue to use the plastic opening tool and separate the front face plate from the rest of the device. There is adhesive that helps attach the front face plate. Some extra prying may be required to separate the face plate, but do not use excessive force.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ATG2vRDwKQMFMqTO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_113952">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
