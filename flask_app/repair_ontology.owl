  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LWIfNtUfrWYHgdOl.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/f4WQbOn6aoEthLxH.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the flat end of the spudger to lift up the small black connector from the back side of the motherboard. The connector should just lift straight up.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/LWIfNtUfrWYHgdOl.standard">
