  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/vGSAWESQaf1gwJX5.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/khVYquWFMuyfWfXP.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Next, use the spudger to remove the pictured ribbon from the ZIF connector. Be careful not to rip the ribbon cable out of the ZIF connector while removing.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/vGSAWESQaf1gwJX5.standard">
