  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now turn the camera so that the front is facing towards your right. Remove the two remaining 5mm Phillips #000 screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
