<owl:NamedIndividual rdf:about="#Step_129352">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/T2bo14b4TSfGOpZ2.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move the menu button panel to the right as well as the screen. Be careful because each are connected to the camera by a ribbon.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
