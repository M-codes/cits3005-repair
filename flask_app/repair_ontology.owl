  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Now you can completely separate the back encasement from the rest of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
