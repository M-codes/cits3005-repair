<owl:NamedIndividual rdf:about="#Step_109357">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/JZpuhYn5aNx2a5k5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lay the camera on its back so that the card/battery door is facing you. Using your fingernail, slide the tab on the battery door up to release the battery door latch.</has_title>
