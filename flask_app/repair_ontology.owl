  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The logic board should now be loose and easily liftable. DO NOT lift the board out completely the wiring that is still connected must be disconnected before proceeding.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IdDWIH2BMOIaAs4Q.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_12718">
