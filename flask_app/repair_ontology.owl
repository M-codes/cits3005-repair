  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/LcQ1PSShfIYDlBWg.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GkOMANcqLIPF3jxA.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZSjVVStRKnnNJ6BC.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Begin by opening the top of the camera (flash assembly) to a slight angle. Next, angle the flash assembly slightly upward and pry off the connections carefully. Be careful not to damage the ribbon cable. This is essential to the operation of the flash.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

