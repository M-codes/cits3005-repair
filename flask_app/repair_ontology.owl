  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the circuit board over and with a soldering gun remove the two wires on each end. Use a screwdriver to pull the loosened wire away.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/HvXiIOiNt2bdNucd.standard">
