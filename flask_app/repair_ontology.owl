  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/ghPMRjdGdprrXnIS.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a J0 screwdriver, remove the 4mm screw holding the metal plate to expose the gears.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/qvfx5jAbMJ4rl316.standard">
