  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the front panel (the panel around the lens casing) from the camera. Remove the two ribbon cables connected to the back panel (the panel this the LCD screen) by lifting up on their respective tabs and gently pulling out the cord. Caution: When removing the back panel, the two ribbon cables are relatively delicate and must both be disconnected before the panel can be entirely removed. Remove the back panel from the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/41KOYZOEER2qPaoT.standard">
