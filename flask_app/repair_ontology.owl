  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Once the casing is unscrewed, hold the camera with one side facing down, and lift the opposite face of the casing to open it. Remove the internal camera components and layout out all pieces on a clean surface. The front and back cover may require gentle rocking to remove.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

