  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carefully detach the two light brown ribbon wires on the top panel: The right ribbon by prying it out with the flat end of the spudger. The left ribbon by using tweezers to gently wiggle it out toward the top.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</has_order>
</owl:NamedIndividual>

