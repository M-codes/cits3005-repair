  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_112820">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UGtxhHCxj5gThlx1.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After removing the screen, there will appear a single 3.8 mm Phillips #PH00 screw located on the back of the camera. Using the PH00 screwdriver, remove the screw.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UGtxhHCxj5gThlx1.standard">
  <rdf:type rdf:resource="#Image"/>
