  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Add a bit of solder on the connector you want to use next. I started with B+ and connected it to the + pole of the first battery. Test again if everything fits in the housing. '''Warning! The housing is metal. Make sure not to short-cut something!'''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

