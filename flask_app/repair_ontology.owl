  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IIooOZgFDnWoJLdV.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove screw from top of the flash mechanism</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/IIooOZgFDnWoJLdV.standard">
