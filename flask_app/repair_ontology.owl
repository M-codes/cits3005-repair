<owl:NamedIndividual rdf:about="#Step_37201">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/puQeM2W2LTZUjiVp.standard"/>
