  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UFVVLFCKhJUrp3DN.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert a plastic opening tool into the gab between the camera body and the back panel. Carefully pry open the camera and separate the back panel. When working with electronics, it's important to choose a tool that's ESD-safe to avoid accidental damage to the device. The metal spudger is great when you need serious prying power, but the regular black nylon spudger or a plastic opening tool should be used whenever possible.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

