  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the LCD assembly from the rear cover. Be sure both the face of the LCD and the inner face of the clear LCD cover are perfectly clean before reassembly, as any dust or fingerprints trapped inside will be annoyingly visible when the device is turned on.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
