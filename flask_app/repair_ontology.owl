  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pry off the front-side cover with the small plastic spudger. There is a adhesive holding the front-side cover to the camera frame, so more force may be necessary to remove it. Be careful as to not break the cover while prying.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

