  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and unscrew the indicated screw using the (PH1) Phillips head bit. ''Screw Measurements: (Length= 5.3mm)''</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/ZdJsvsL1TgSfUaLl.standard">
