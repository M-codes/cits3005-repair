  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place the plastic opening tool underneath the ribbon tab as shown. Gently lift the tab up. Gently pull the ribbon from the logic board with tweezers. With the ribbon disconnected, the back casing should now be detached from the rest of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
