  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open the camera back by pulling up on the film rewind crank. Once open, push the rewind crank back down and  insert a screwdriver into the notch. With one hand holding the screwdriver in the notch, wind the crank counter-clockwise to remove it.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

