  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Located near the tripod mount area, unscrew one silver five millimeter screw. Tripod mound comes off with mount assembly underneath.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

