  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/StxUPcuO3UuZghiA.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the camera sideways, remove the two screws located on the left side of the camera.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/StxUPcuO3UuZghiA.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_85602">
