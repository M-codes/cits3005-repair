  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/fV1xT3HMUTfo2ULw.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/rBSBKXD51JjhkO4E.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PmXGq2wqShDZAFKR.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the film advance lever by unscrewing the bottom screw with a Philips screwdriver. Remove the plastic cover to uncover the metal lever.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_order>
</owl:NamedIndividual>

