  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When the back casing is removed, orient it so that you are looking at the interior of the back casing. Make sure the glass case of the LCD screen is on the left hand side. Peel back the black sticky film on the right side to reveal six screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

