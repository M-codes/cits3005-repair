  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turn the device over again. Unthread the ribbon cable. The lens assembly is separated from the device.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</has_order>
</owl:NamedIndividual>

