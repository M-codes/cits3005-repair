  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_21944">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_spudger"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/r5WDXBYiwNGBFyye.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/HlPGGVnKaPCA1nFZ.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/IIyw2KDJOilyli6V.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tools Required: Spudger To pry off the screen cover, gently grab the sides of the camera. If necessary, use spudger (refer to pictures). Once the screen cover is removed, the front cover and side plate will slide off (refer to pictures).</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_order>
</owl:NamedIndividual>

