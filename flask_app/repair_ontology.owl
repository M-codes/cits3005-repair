  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the 3.80mm screw inside the film compartment with the Phillips #00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

