  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use two fingers to gently pull the viewfinder toward you and out of its housing. The black plastic piece is still on the viewfinder in this image, but should have been removed during LCD screen removal.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</has_order>
