  <has_tool rdf:resource="#Tool_ph00_phillips_screwdriver"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 7.0 mm Phillips #00 screws on the underside of the viewfinder. Pull out the viewfinder.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</has_order>
