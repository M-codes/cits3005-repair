</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/eWLdIKofQ5CPEs5P.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34909">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/F2YVjGlGJxLMqdEn.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pull the two halves of the camera apart. Place the two halves down with the insides facing you.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/F2YVjGlGJxLMqdEn.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34910">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_opening_tool"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/UQojpQmxbtJqvGFv.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Find the two clips holding the motherboard to the black lens box. Slide the plastic opening tool in between the ribbon and the black part of the clip, then flip it up. (If difficult, your fingernail can also be used)</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/UQojpQmxbtJqvGFv.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34912">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/GPqsccoDLoDAhmRO.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After releasing the clips, pull out the black lens box. If the black lens box does not come out, go back to the previous step and make sure you released the correct clips.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/GPqsccoDLoDAhmRO.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34913">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_0_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/PdnqPqIu5Y3fN2bW.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and unscrew the two 3mm screws on the bottom of the black lens box with the JIS #0 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/PdnqPqIu5Y3fN2bW.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34914">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_tweezers"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RJoFpFBpXUgDqoYx.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the tweezers remove the black tape to detach the chip from the lens box.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RJoFpFBpXUgDqoYx.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_34915">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/RPkGSWbs3SgfuYYH.standard"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/crTZXOwKVdwStHm5.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grab the chip with your thumbs and '''carefully''' pull it off. The copper tab will be glued to the lens box. Be careful not to rip it. The attached copper ribbons are part of the CCD chip.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/RPkGSWbs3SgfuYYH.standard">
