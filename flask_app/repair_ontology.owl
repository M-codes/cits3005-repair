  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locate and remove the four 4.25 mm screws on the motherboard using a Phillips 00 screw driver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_order>
