  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the two 4-mm and three 3-mm J000 screws from the bottom of the S9700. Three 3-mm screws are on the side opposite the battery compartment. Two 4-mm screws are on the side with the battery compartment. One of these screws is in the battery compartment. Open it up for access.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/oJvAogQaPnj2H6NA.standard">
