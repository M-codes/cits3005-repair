<owl:NamedIndividual rdf:about="#Step_201868">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/3JvdxSks4e63tgtT.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the 2 (.135") housing screws with a JIS00 screwdriver</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/3JvdxSks4e63tgtT.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_201872">
  <rdf:type rdf:resource="#Step"/>
  <has_tool rdf:resource="#Tool_jis_00_screwdriver"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/VMpSFKLC5SWZvfPJ.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove 4 (.135") screws on the inside of the battery compartment using the JIS 00 screwdriver.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/VMpSFKLC5SWZvfPJ.standard">
  <rdf:type rdf:resource="#Image"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Step_201873">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/G6hIulSNKkBOKigF.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slide the two halves apart</has_title>
