  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Placing your thumb on the battery cover, push outwards, away from the camera in the direction the arrow is pointing. If done correctly when it's completely unhooked, the latch will open.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</has_order>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#https://d3nevzfk7ii3be.cloudfront.net/igi/NOOZO6RYDpGXQjPj.standard">
