  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To get to the motherboard, safely lift the battery to expose  an Aluminium plate that shields and holds the motherboard in place. The plates are held  down by four Phillips  0.008 mm screws on all four corners. Use  a Phillips  head #000 to safely loosen the screws.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

