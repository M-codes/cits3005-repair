<owl:NamedIndividual rdf:about="#Step_35924">
  <rdf:type rdf:resource="#Step"/>
  <has_image rdf:resource="#https://d3nevzfk7ii3be.cloudfront.net/igi/FvrZLjbW3ViwmuER.standard"/>
  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the ribbon cable on the top right of the motherboard.  To remove the cable, slide the two grey tabs, located on both sides, towards the top of the camera and gently pull the cable out.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</has_order>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_order>
</owl:NamedIndividual>

