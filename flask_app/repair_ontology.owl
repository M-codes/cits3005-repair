  <has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unscrew the screw (2mm, Phillips #00) from the white, plastic piece on the silver sliding rod and set aside. Slide out the silver sliding rod. The optical assembly is almost ready to be removed.</has_title>
  <has_order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</has_order>
</owl:NamedIndividual>

